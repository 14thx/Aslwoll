local TOUCH_W, TOUCH_H = 700, 430
local function defaultScale()
	-- มือถือใช้ขนาดจริง (UIScale = 1) ให้ตัวอักษรคม: ตัวหน้าต่างปรับขนาดตามจอใน layout() แทนการย่อด้วย UIScale
	return 1
end
