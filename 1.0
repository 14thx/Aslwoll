local MIN_WIN_W, MIN_WIN_H = 600, 360 -- ขนาดเล็กสุดตอนลากปรับขนาดหน้าต่าง

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function tw(o, p, info)
	local t = TweenService:Create(o, info or QUINT, p)
	t:Play()
	return t
end
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function round(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function circle(o) return new("UICorner", { CornerRadius = UDim.new(.5, 0) }, o) end
local function pad(o, l, t, r, b)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b),
	}, o)
end
-- เส้นขอบบางโปร่งแสงแบบกระจก (ใช้กับ Frame ปกติ)
local function glass(o)
	local st = new("UIStroke", {
		Name = "Glass", Color = C.stroke, Transparency = 0, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, o)
	-- ไล่เฉดความโปร่งของเส้นขอบ: สว่างด้านบน (แสงสะท้อนกระจก) จางลงด้านล่าง
	new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, .74), NumberSequenceKeypoint.new(.4, .92), NumberSequenceKeypoint.new(1, .97),
		}),
	}, st)
	return st
end
-- ไล่เฉดบนแถบเติม (สลิดเดอร์/Progress): ซ้ายเข้มกว่าเล็กน้อย ปลายแถบสว่างเต็มสี Accent
local function accentGrad(o, rot)
	return new("UIGradient", {
		Rotation = rot or 0, Color = ColorSequence.new(Color3.fromRGB(170, 170, 182), Color3.new(1, 1, 1)),
	}, o)
end
-- กดแล้วย่อเล็กน้อย ปล่อยแล้วเด้งกลับ (ใช้กับปุ่ม/แท็บ/หัวการ์ด)
local function pressFx(b, amt)
	local sc = new("UIScale", {}, b)
	amt = amt or .97
	b.MouseButton1Down:Connect(function() tw(sc, { Scale = amt }, TweenInfo.new(.1)) end)
	b.MouseButton1Up:Connect(function() tw(sc, { Scale = 1 }, TweenInfo.new(.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)) end)
	b.MouseLeave:Connect(function() tw(sc, { Scale = 1 }, TweenInfo.new(.15)) end)
	return sc
end
local function onC(c) return (0.299 * c.R + 0.587 * c.G + 0.114 * c.B) > 0.62 and Color3.fromRGB(10, 10, 12) or Color3.new(1, 1, 1) end
local function safe(cb, ...)
	if cb then task.spawn(function(...) local ok, e = pcall(cb, ...) if not ok then warn("[RVX]", e) end end, ...) end
end
local function hoverTint(b, normal, over)
	b.MouseEnter:Connect(function() tw(b, { BackgroundColor3 = over() }) end)
	b.MouseLeave:Connect(function() tw(b, { BackgroundColor3 = normal() }) end)
end
local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end

-- คีย์ค้นหา (รวมทุกภาษาเป็นตัวพิมพ์เล็ก)
local function mkKeys(v)
	if v == nil then return "" end
	if type(v) == "table" then
		local t = {}
		for _, s in pairs(v) do t[#t + 1] = tostring(s) end
		return string.lower(table.concat(t, " "))
	end
	return string.lower(tostring(v))
end

local function loadCfg()
	local ok, res = pcall(function()
		if isfile and readfile and isfile(CONFIG_FILE) then return HttpService:JSONDecode(readfile(CONFIG_FILE)) end
	end)
	return (ok and type(res) == "table") and res or {}
end

-- Flag (บันทึกค่าคอนโทรลอัตโนมัติ)
local function flagGet(win, o)
	if o.Flag then return win._saved[o.Flag] end
	return nil
end
local function flagReg(win, o, v)
	if o.Flag then win.Flags[o.Flag] = v end
end
local function flagPut(win, o, v, json)
	if o.Flag then
		win.Flags[o.Flag] = v
		win._data[o.Flag] = json
		win:_save()
	end
end
local function restored(cb, ...)
	if cb then task.defer(safe, cb, ...) end
end

