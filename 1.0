--[[
  RVX UI v5  |  Dark sidebar UI library (Luau) - เขียนเองทั้งหมด ไม่พึ่งไลบรารีภายนอก
  • เลย์เอาต์: ไซด์บาร์ซ้าย (โลโก้/ชื่อ/เวอร์ชัน, เมนู, โปรไฟล์ผู้เล่น) + หัวข้อหน้า + ช่องค้นหา
  • การ์ดแบบพับ/ขยายได้ แต่ละหน้ามี 2 ฝั่ง (Left/Right) มือถือเรียงต่อกันอัตโนมัติ
  • ช่องค้นหาด้านบนกรองฟังก์ชันของหน้านั้น (ค้นได้ทั้งไทย/อังกฤษ)
  • แถวมีคำอธิบายย่อยใต้ชื่อ (Desc), Flag = บันทึกค่าอัตโนมัติ
  • หลายภาษา: ส่งข้อความเป็น {en="..", th=".."} ได้ทุกที่

  API ย่อ
    local ui  = RVX.new({ Title, Version, Subtitle, Language, Accent, Keybind, Profile = true })
    local tab = ui:Tab(name, icon)               -- icon: ชื่อไอคอน 256 แบบ (ดูตาราง ICON_INDEX) เช่น home bolt sword sprout coins eye ... หรือชื่ออื่นตาม ICON_ALIAS เช่น gear esp farm
    local sec = tab:Section(title, "left"|"right", icon)
    sec:Button / Toggle(Desc=) / Slider / Dropdown(Multi, Search) / Input / Keybind / ColorPicker
    sec:Segmented / Stepper / Progress / Paragraph / Divider / Label / Swatches
    ui:Notify({ Type, Title, Text, Duration })   ui:Dialog({ Title, Text, Confirm, Cancel, Danger, Callback })
    ui:Settings()   -- หน้าตั้งค่าสำเร็จรูป
]]

local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

