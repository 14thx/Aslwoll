local function hasSheet(s) return type(s) == "string" and s ~= "" and string.find(s, "%d%d%d%d%d") ~= nil end

local function Icon(name, parent, px, color)
	local ikey = name
	if not ICON_INDEX[ikey] then
		local l = string.lower(tostring(ikey))
		ikey = ICON_ALIAS[ikey] or ICON_ALIAS[l] or l
	end
	local sheetIdx = ICON_INDEX[ikey]
	local sheet, cell, cols = STYLE.IconSheet, STYLE.IconCell, STYLE.IconCols
	if not hasSheet(sheet) and sheetIdx and sheetIdx <= ICON_LEGACY_MAX and hasSheet(STYLE.IconSheetOld) then
		sheet, cell, cols = STYLE.IconSheetOld, 96, 8 -- ชีตเก่า: ช่อง 96px / 8 ช่องต่อแถว
	end
	if hasSheet(sheet) and sheetIdx then
		local img = new("ImageLabel", {
			BackgroundTransparency = 1, BorderSizePixel = 0, Image = sheet, ImageColor3 = color,
			ImageRectSize = Vector2.new(cell, cell),
			ImageRectOffset = Vector2.new((sheetIdx % cols) * cell, math.floor(sheetIdx / cols) * cell),
			Size = UDim2.fromOffset(px, px),
		}, parent)
		return img, function(c) img.ImageColor3 = c end
	end
	-- ยังไม่มีชีต: วาดไอคอนเส้นแบบเดิมจาก Frame (ถ้าไม่มีชื่อตรง ลองชื่อที่ alias ไปหา)
	if not ICONS[name] then name = ikey end
	local h = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(px, px) }, parent)
	local parts, th = {}, 0.1
	for _, poly in ipairs(ICONS[name] or {}) do
		for i = 1, #poly - 1 do
			local a, b = poly[i], poly[i + 1]
			local dx, dy = b[1] - a[1], b[2] - a[2]
			local f = new("Frame", {
				AnchorPoint = Vector2.new(.5, .5), BorderSizePixel = 0, BackgroundColor3 = color,
				Position = UDim2.fromScale((a[1] + b[1]) / 2, (a[2] + b[2]) / 2),
				Size = UDim2.fromScale(math.sqrt(dx * dx + dy * dy) + th * .5, th),
				Rotation = math.deg(math.atan2(dy, dx)),
			}, h)
			circle(f)
			parts[#parts + 1] = f
		end
	end
	for _, d in ipairs(DOTS[name] or {}) do
		local f = new("Frame", {
			AnchorPoint = Vector2.new(.5, .5), BorderSizePixel = 0, BackgroundColor3 = color,
			Position = UDim2.fromScale(d[1], d[2]), Size = UDim2.fromScale(d[3], d[3]),
		}, h)
		circle(f)
		parts[#parts + 1] = f
	end
	for _, r in ipairs(RINGS[name] or {}) do
		-- วงแหวนของไอคอน (เส้นบางของไอคอนเอง ไม่ใช่ขอบ UI)
		local f = new("Frame", {
			AnchorPoint = Vector2.new(.5, .5), BackgroundTransparency = 1,
			Position = UDim2.fromScale(r[1], r[2]), Size = UDim2.fromScale(r[3], r[4] or r[3]),
		}, h)
		circle(f)
		parts[#parts + 1] = new("UIStroke", { Color = color, Thickness = math.max(1.2, px * th) }, f)
	end
	local function setc(c)
		for _, p in ipairs(parts) do
			if p:IsA("UIStroke") then p.Color = c else p.BackgroundColor3 = c end
		end
	end
	return h, setc
end

-- โลโก้ (ไม่มีพื้นหลัง/ขอบ ตัดเป็นวงกลมด้วย CanvasGroup)
-- ถ้ารูปมีขอบว่างรอบๆ ให้ปรับ LOGO_ZOOM เป็น 1.1 - 1.2
local LOGO_ZOOM = STYLE.LogoZoom
local function Logo(parent, px)
	local h = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromOffset(px, px) }, parent)
	local fb = Icon("bolt", h, math.floor(px * .5), C.sub)
	fb.AnchorPoint, fb.Position = Vector2.new(.5, .5), UDim2.fromScale(.5, .5)
	local img = new("ImageLabel", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Image = LOGO,
		AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
		Size = UDim2.fromScale(LOGO_ZOOM, LOGO_ZOOM), ScaleType = Enum.ScaleType.Crop, ZIndex = 2,
	}, h)
	circle(img)
	task.spawn(function()
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync({ img }, function(_, status)
				if status == Enum.AssetFetchStatus.Success then fb.Visible = false end
			end)
		end)
		if img.IsLoaded then fb.Visible = false end
	end)
	return h
end

----------------------------------------------------------------------
-- Section (การ์ดที่ใส่ฟังก์ชัน)
----------------------------------------------------------------------
local Sec = {}
Sec.__index = Sec
function Sec:_o() self.order += 1 return self.order end
-- ลงทะเบียนแถวให้ช่องค้นหา
function Sec:_reg(frame, name, extra)
	self.rows[#self.rows + 1] = { frame = frame, keys = mkKeys(name) .. " " .. mkKeys(extra) }
	if self.badge then self.badge.Text = tostring(#self.rows) end
end

local function rowFrame(sec, h, clickable)
	local f = new(clickable and "TextButton" or "Frame", {
		BackgroundColor3 = C.raised, BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, h or ROW), LayoutOrder = sec:_o(),
	}, sec.holder)
	if clickable then f.AutoButtonColor = false f.Text = "" end
	round(f, R.item)
	return f
end
local function rowLabel(win, p, text, reserve, y, h, size)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, TextColor3 = C.text, FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(12, y or 0), Size = UDim2.new(1, -(12 + reserve), h and 0 or 1, h or 0),
	}, p)
	win:_bind(l, text, size or 14)
	return l
end

function Sec:Label(text)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, TextColor3 = C.sub, FontFace = FONT, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self:_o(),
	}, self.holder)
	pad(l, 12, 4, 12, 4)
	self.win:_bind(l, text, 12)
	self:_reg(l, text)
	return { Frame = l, Set = function(_, t) self.win:_bind(l, t, 12) end }
end

function Sec:Paragraph(o)
	local win = self.win
	local f = new("Frame", {
		BackgroundColor3 = C.raised, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self:_o(),
	}, self.holder)
	round(f, R.item)
	pad(f, 16, 13, 16, 13)
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, f)
	self:_reg(f, o.Title, o.Text)
	local titleLbl, textLbl
	if o.Title then
		local t = new("TextLabel", {
			BackgroundTransparency = 1, TextColor3 = C.text, FontFace = FONT_B, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1,
		}, f)
		win:_bind(t, o.Title, 14)
		titleLbl = t
	end
	if o.Text then
		local t = new("TextLabel", {
			BackgroundTransparency = 1, TextColor3 = C.sub, FontFace = FONT, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
		}, f)
		win:_bind(t, o.Text, 13)
		textLbl = t
	end
	-- ตัวควบคุมสำหรับอัปเดตข้อความสถานะระหว่างทำงาน (ใส่ข้อความธรรมดาหรือ {en=, th=})
	return {
		Frame = f,
		SetTitle = function(_, v) if titleLbl then win:_bind(titleLbl, v, 14) end end,
		SetDesc = function(_, v)
			if not textLbl then
				textLbl = new("TextLabel", {
					BackgroundTransparency = 1, TextColor3 = C.sub, FontFace = FONT, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
					Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
				}, f)
			end
			win:_bind(textLbl, v, 13)
		end,
	}
end

-- แถวข้อมูลมีไอคอนนำหน้า: sec:Info({ Title=, Items = { { Icon="user", Name={en=,th=}, Value="..." }, ... } })
function Sec:Info(o)
	local win = self.win
	local f = new("Frame", {
		BackgroundColor3 = C.raised, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self:_o(),
	}, self.holder)
	round(f, R.item)
	pad(f, 16, 13, 16, 13)
	new("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }, f)
	local keys = { o.Title }
	if o.Title then
		local t = new("TextLabel", {
			BackgroundTransparency = 1, TextColor3 = C.text, FontFace = FONT_B, TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0,
		}, f)
		win:_bind(t, o.Title, 15)
	end
	local valSrc, valLbl = {}, {}
	for i, it in ipairs(o.Items or {}) do
		keys[#keys + 1] = it.Name
		local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = i }, f)
		local ic, isetc = Icon(it.Icon or "info", row, 15, win.accent)
		ic.AnchorPoint, ic.Position = Vector2.new(0, .5), UDim2.new(0, 0, .5, 0)
		win._acc[#win._acc + 1] = function(c) isetc(c) end
		local nm = new("TextLabel", {
			BackgroundTransparency = 1, TextColor3 = C.sub, FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(25, 0), Size = UDim2.new(.42, -25, 1, 0),
		}, row)
		win:_bind(nm, it.Name, 13)
		local vl = new("TextLabel", {
			BackgroundTransparency = 1, TextColor3 = C.text, FontFace = FONT_B, TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.new(.42, 0, 0, 0), Size = UDim2.new(.58, 0, 1, 0),
		}, row)
		valSrc[i], valLbl[i] = it.Value or "", vl
		local function ap() vl.Text = win:T(valSrc[i]) vl.TextSize = 13 + win:_boost() end
		ap()
		win._hooks[#win._hooks + 1] = ap
	end
	self:_reg(f, keys[1] or "", table.concat((function() local t = {} for _, k in ipairs(keys) do t[#t + 1] = mkKeys(k) end return t end)(), " "))
	return {
		Frame = f,
		SetValue = function(_, i, v)
			if valLbl[i] then
				valSrc[i] = v
				valLbl[i].Text = win:T(v)
			end
		end,
	}
end

function Sec:Divider()
	local f = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 10), LayoutOrder = self:_o() }, self.holder)
	local l = new("Frame", {
		BackgroundColor3 = C.raised, BorderSizePixel = 0, AnchorPoint = Vector2.new(.5, .5),
		Position = UDim2.fromScale(.5, .5), Size = UDim2.new(1, -24, 0, 2),
	}, f)
	circle(l)
end

function Sec:Button(o)
	local win, primary = self.win, o.Primary
	local function base() return primary and win.accent or C.raised end
	local function over() return primary and win.accent:Lerp(Color3.new(1, 1, 1), .12) or C.hover end
	local function down() return primary and win.accent:Lerp(Color3.new(0, 0, 0), .18) or C.card end
	local function fg() return primary and onC(win.accent) or C.text end

	local btn = new("TextButton", {
		AutoButtonColor = false, Text = "", BackgroundColor3 = base(), BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, ROW + 2), LayoutOrder = self:_o(),
	}, self.holder)
	round(btn, R.item)
	self:_reg(btn, o.Name)
	if primary then
		new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(168, 168, 182)), Rotation = 20,
		}, btn)
		-- ขอบสว่างบาง ๆ ด้านบนของปุ่มหลัก ให้ดูนูน
		local hi = new("UIStroke", { Name = "Hi", Color = Color3.new(1, 1, 1), Transparency = 0, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, btn)
		new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, .6), NumberSequenceKeypoint.new(.5, .92), NumberSequenceKeypoint.new(1, 1) }) }, hi)
	else
		glass(btn)
	end
	local press = new("UIScale", {}, btn)
	local content = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, btn)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
	}, content)
	local setc
	if o.Icon then
		local ic
		ic, setc = Icon(o.Icon, content, 16, fg())
		ic.LayoutOrder = 1
	end
	local lbl = new("TextLabel", {
		BackgroundTransparency = 1, TextColor3 = fg(), FontFace = FONT_B, LayoutOrder = 2,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20),
	}, content)
	win:_bind(lbl, o.Name, 14)

	win._acc[#win._acc + 1] = function()
		tw(btn, { BackgroundColor3 = base() })
		lbl.TextColor3 = fg()
		if setc then setc(fg()) end
	end
	hoverTint(btn, base, over)
	btn.MouseButton1Down:Connect(function()
		tw(btn, { BackgroundColor3 = down() }, TweenInfo.new(.1))
		tw(press, { Scale = .97 }, TweenInfo.new(.1))
	end)
	btn.MouseButton1Up:Connect(function()
		tw(btn, { BackgroundColor3 = over() })
		tw(press, { Scale = 1 }, TweenInfo.new(.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
	end)
	btn.MouseLeave:Connect(function() tw(press, { Scale = 1 }) end)
	btn.MouseButton1Click:Connect(function() win:_click() safe(o.Callback) end)
end

function Sec:Toggle(o)
	local win = self.win
	local saved = flagGet(win, o)
	local state = o.Default == true
	if type(saved) == "boolean" then state = saved end
	local hasDesc = o.Desc ~= nil
	local r = rowFrame(self, hasDesc and (ROW + 14) or ROW, true)
	self:_reg(r, o.Name, o.Desc)
	if hasDesc then
		rowLabel(win, r, o.Name, 64, 6, 20)
		local d = new("TextLabel", {
			BackgroundTransparency = 1, TextColor3 = C.sub, FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(12, 27), Size = UDim2.new(1, -76, 0, 14),
		}, r)
		win:_bind(d, o.Desc, 11)
	else
		rowLabel(win, r, o.Name, 64)
	end
	local track = new("Frame", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -12, .5, 0), Size = UDim2.fromOffset(44, 26), BorderSizePixel = 0 }, r)
	circle(track)
	local knob = new("Frame", { AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(20, 20), BorderSizePixel = 0, BackgroundColor3 = C.knob }, track)
	circle(knob)
	local tstroke = new("UIStroke", { Color = win.accent, Thickness = 2, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, track)
	local pressed = false -- กดค้าง: ลูกบิดยืดออกแบบสวิตช์ iOS
	local function render(anim)
		local sp = { Transparency = state and .62 or 1, Color = win.accent }
		local w = pressed and 26 or 20
		local half = 3 + w / 2
		local tp = { BackgroundColor3 = state and win.accent or C.hover }
		local kp = {
			Position = state and UDim2.new(1, -half, .5, 0) or UDim2.new(0, half, .5, 0),
			Size = UDim2.fromOffset(w, 20),
			BackgroundColor3 = state and onC(win.accent) or C.knob,
		}
		if anim then
			tw(track, tp)
			tw(tstroke, sp)
			tw(knob, kp, pressed and TweenInfo.new(.15, Enum.EasingStyle.Quint) or TweenInfo.new(.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
		else
			tstroke.Transparency, tstroke.Color = sp.Transparency, sp.Color
			track.BackgroundColor3 = tp.BackgroundColor3
			knob.Position, knob.Size, knob.BackgroundColor3 = kp.Position, kp.Size, kp.BackgroundColor3
		end
	end
	render(false)
	win._acc[#win._acc + 1] = function() render(true) end
	local function release() if pressed then pressed = false render(true) end end
	r.MouseEnter:Connect(function() tw(r, { BackgroundTransparency = .55 }) end)
	r.MouseLeave:Connect(function() tw(r, { BackgroundTransparency = 1 }) release() end)
	r.MouseButton1Down:Connect(function() pressed = true render(true) end)
	r.MouseButton1Up:Connect(function() task.delay(.05, release) end) -- ถ้าเป็นการคลิก Set() จะเคลียร์ pressed ให้เองก่อน
	flagReg(win, o, state)
	local obj = {}
	function obj:Set(v, silent)
		pressed = false
		state = v and true or false
		render(true)
		flagPut(win, o, state, state)
		if not silent then safe(o.Callback, state) end
	end
	function obj:Get() return state end
	r.MouseButton1Click:Connect(function() win:_click() obj:Set(not state) end)
	if type(saved) == "boolean" then restored(o.Callback, state) end
	return obj
end

function Sec:Slider(o)
	local win = self.win
	local min, max, step = o.Min or 0, o.Max or 100, o.Step or 1
	local saved = flagGet(win, o)
	local value = math.clamp(type(saved) == "number" and saved or o.Default or min, min, max)
	local r = rowFrame(self, 58)
	self:_reg(r, o.Name)
	rowLabel(win, r, o.Name, 84, 8, 22)
	local valBox = new("Frame", {
		BackgroundColor3 = C.field, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 7), Size = UDim2.fromOffset(60, 24),
	}, r)
	round(valBox, R.small)
	local val = new("TextLabel", {
		BackgroundTransparency = 1, TextSize = 12, TextColor3 = C.text, FontFace = FONT_B, Size = UDim2.fromScale(1, 1),
	}, valBox)
	local bar = new("Frame", { BackgroundColor3 = C.hover, BorderSizePixel = 0, Position = UDim2.new(0, 12, 0, 43), Size = UDim2.new(1, -24, 0, 4) }, r)
	circle(bar)
	local fill = new("Frame", { BackgroundColor3 = win.accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, bar)
	circle(fill)
	accentGrad(fill)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(.5, .5), BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(14, 14), Position = UDim2.fromScale(1, .5),
	}, fill)
	circle(knob)
	local kscale = new("UIScale", {}, knob)
	-- ฟองแสดงค่าเหนือปุ่มตอนลาก (จุดยึดแนวนอนไล่ตามเปอร์เซ็นต์ ไม่ให้ล้นขอบการ์ด)
	local bubble = new("Frame", {
		AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(1, 0, 0, -10), BackgroundColor3 = win.accent, BorderSizePixel = 0,
		Visible = false, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 22), ZIndex = 20,
	}, fill)
	round(bubble, R.small)
	local bubLbl = new("TextLabel", {
		BackgroundTransparency = 1, TextSize = 12, FontFace = FONT_B, TextColor3 = onC(win.accent),
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 22),
	}, bubble)
	pad(bubLbl, 9, 0, 9, 0)
	win._acc[#win._acc + 1] = function(c)
		tw(fill, { BackgroundColor3 = c })
		bubble.BackgroundColor3 = c
		bubLbl.TextColor3 = onC(c)
	end
	local hit = new("TextButton", { BackgroundTransparency = 1, Text = "", Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 28) }, r)

	local function set(v, silent)
		v = math.clamp(math.floor(v / step + .5) * step, min, max)
		v = tonumber(string.format("%.4f", v))
		value = v
		val.Text = tostring(v) .. (o.Suffix or "")
		local p = (max > min) and (v - min) / (max - min) or 0
		tw(fill, { Size = UDim2.fromScale(p, 1) }, TweenInfo.new(.08, Enum.EasingStyle.Quad))
		bubLbl.Text = tostring(v) .. (o.Suffix or "")
		bubble.AnchorPoint = Vector2.new(p, 1)
		if not silent then
			flagPut(win, o, v, v)
			safe(o.Callback, v)
		end
	end
	set(value, true)
	flagReg(win, o, value)

	local dragging, page = false, self.page
	local function fromX(x) set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)) end
	hit.InputBegan:Connect(function(i)
		if isPress(i) then
			dragging = true
			page.ScrollingEnabled = false
			tw(kscale, { Scale = 1.25 }, TweenInfo.new(.15))
			bubble.Visible = true
			fromX(i.Position.X)
		end
	end)
	win._conns[#win._conns + 1] = UIS.InputChanged:Connect(function(i)
		if dragging and isMove(i) then fromX(i.Position.X) end
	end)
	win._conns[#win._conns + 1] = UIS.InputEnded:Connect(function(i)
		if dragging and isPress(i) then
			dragging = false
			page.ScrollingEnabled = true
			tw(kscale, { Scale = 1 })
			bubble.Visible = false
			win:_click()
		end
	end)
	if type(saved) == "number" then restored(o.Callback, value) end
	return { Set = function(_, v) set(v) end, Get = function() return value end }
end

function Sec:Dropdown(o)
	local win = self.win
	local opts = o.Options or {}
	local multi = o.Multi == true
	local function idOf(x) return type(x) == "table" and (x.id or x.en) or x end
	local byId = {}
	for _, x in ipairs(opts) do byId[idOf(x)] = x end
	local searchable = o.Search
	if searchable == nil then searchable = #opts > 7 end
	local maxVis = o.MaxVisible or 6
	local optH = ROW - 4
	local searchH = ROW - 6
	local LBL = 24

	-- สถานะที่เลือก
	local saved = flagGet(win, o)
	local sel, cur = {}, nil
	local hadSaved = false
	if multi then
		local def = o.Default
		if type(saved) == "table" then def, hadSaved = saved, true end
		if type(def) == "table" then
			for _, d in ipairs(def) do
				local id = idOf(d)
				if byId[id] then sel[id] = true end
			end
		end
	else
		cur = o.Default or opts[1]
		if cur ~= nil and byId[idOf(cur)] then cur = byId[idOf(cur)] end
		if type(saved) == "string" and byId[saved] then cur, hadSaved = byId[saved], true end
	end

	local function value()
		if multi then
			local v = {}
			for _, x in ipairs(opts) do if sel[idOf(x)] then v[#v + 1] = idOf(x) end end
			return v
		end
		return idOf(cur)
	end

	-- ป้ายชื่ออยู่ด้านบน ช่องเลือกอยู่ล่าง
	local outer = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, LBL + ROW + 4), LayoutOrder = self:_o() }, self.holder)
	self:_reg(outer, o.Name)
	rowLabel(win, outer, o.Name, 12, 2, 20, 13)
	local box = new("Frame", {
		BackgroundColor3 = C.field, BorderSizePixel = 0, ClipsDescendants = true,
		Position = UDim2.fromOffset(4, LBL), Size = UDim2.new(1, -8, 0, ROW),
	}, outer)
	round(box, R.item)
	local head = new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 0, ROW) }, box)
	local valLbl = new("TextLabel", {
		BackgroundTransparency = 1, TextColor3 = C.text, FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -44, 1, 0),
	}, head)
	local function display()
		if multi then
			local n, first = 0, nil
			for _, x in ipairs(opts) do
				if sel[idOf(x)] then n += 1 first = first or x end
			end
			if n == 0 then return win:T(o.Placeholder or { en = "None", th = "ยังไม่เลือก" }) end
			if n == 1 then return win:T(first) end
			return n .. " " .. win:T({ en = "selected", th = "รายการ" })
		end
		return win:T(cur)
	end
	local function refresh() valLbl.Text = display() valLbl.TextSize = 13 + win:_boost() end
	win._hooks[#win._hooks + 1] = refresh
	refresh()
	local chev = Icon("chevron", head, 16, C.sub)
	chev.AnchorPoint, chev.Position = Vector2.new(1, .5), UDim2.new(1, -12, .5, 0)

	local entries, open = {}, false
	entries.byId = {}
	local function visibleCount()
		local n = 0
		for _, e in ipairs(entries) do if e.btn.Visible then n += 1 end end
		return n
	end
	local function listHeight()
		return math.min(math.max(visibleCount(), 1), maxVis) * (optH + 2) + 2
	end
	local listY = ROW + (searchable and (searchH + 6) or 2)
	local function openHeight() return listY + listHeight() + 4 end

	local search
	if searchable then
		local sh = new("Frame", { BackgroundColor3 = C.raised, BorderSizePixel = 0, Position = UDim2.fromOffset(6, ROW), Size = UDim2.new(1, -12, 0, searchH) }, box)
		round(sh, R.small + 2)
		search = new("TextBox", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", PlaceholderColor3 = C.sub, TextColor3 = C.text,
			FontFace = FONT, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
		}, sh)
		pad(search, 12, 0, 12, 0)
		local function ph() search.PlaceholderText = win:T({ en = "Search...", th = "ค้นหา..." }) search.TextSize = 13 + win:_boost() end
		win._hooks[#win._hooks + 1] = ph
		ph()
	end

	local list = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = C.sub,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
		Position = UDim2.fromOffset(0, listY), Size = UDim2.new(1, 0, 0, 10),
	}, box)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	pad(list, 4, 2, 4, 2)

	local function setHeight(h, info)
		tw(box, { Size = UDim2.new(1, -8, 0, h) }, info or TweenInfo.new(.3, Enum.EasingStyle.Quint))
		tw(outer, { Size = UDim2.new(1, 0, 0, LBL + h + 4) }, info or TweenInfo.new(.3, Enum.EasingStyle.Quint))
	end
	local function resize()
		list.Size = UDim2.new(1, 0, 0, listHeight())
		if open then setHeight(openHeight(), TweenInfo.new(.25, Enum.EasingStyle.Quint)) end
	end
	local function toggle(v)
		open = v
		setHeight(open and openHeight() or ROW)
		tw(chev, { Rotation = open and 180 or 0 })
		if not open and search then search.Text = "" end
	end

	local function mark()
		local curId = (not multi) and idOf(cur) or nil
		for id, e in pairs(entries.byId) do
			local on = (multi and sel[id] == true) or ((not multi) and id == curId)
			e.icon.Visible = on
			e.setc(win.accent)
			tw(e.btn, { TextColor3 = on and win.accent or C.text })
		end
	end

	local function emit()
		local v = value()
		flagPut(win, o, v, v)
		safe(o.Callback, v)
	end

	for i, opt in ipairs(opts) do
		local id = idOf(opt)
		local b = new("TextButton", {
			AutoButtonColor = false, FontFace = FONT, TextColor3 = C.text, LayoutOrder = i, BackgroundColor3 = C.hover, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, optH), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		}, list)
		round(b, R.small)
		pad(b, 10, 0, 30, 0)
		win:_bind(b, opt, 13)
		local ic, setc = Icon("check", b, 14, win.accent)
		ic.AnchorPoint, ic.Position = Vector2.new(1, .5), UDim2.new(1, 22, .5, 0)
		local entry = { btn = b, icon = ic, setc = setc, opt = opt }
		entries[#entries + 1] = entry
		entries.byId[id] = entry
		b.MouseEnter:Connect(function() tw(b, { BackgroundTransparency = 0 }) end)
		b.MouseLeave:Connect(function() tw(b, { BackgroundTransparency = 1 }) end)
		b.MouseButton1Click:Connect(function()
			if multi then
				if sel[id] then sel[id] = nil else sel[id] = true end
				refresh()
				mark()
			else
				cur = opt
				refresh()
				mark()
				toggle(false)
			end
			emit()
		end)
	end
	list.Size = UDim2.new(1, 0, 0, listHeight())
	mark()
	win._acc[#win._acc + 1] = mark

	if search then
		search:GetPropertyChangedSignal("Text"):Connect(function()
			local q = string.lower(search.Text)
			for _, e in ipairs(entries) do
				local hay = string.lower(win:T(e.opt)) .. " " .. string.lower(tostring(idOf(e.opt)))
				e.btn.Visible = (q == "") or (string.find(hay, q, 1, true) ~= nil)
			end
			list.CanvasPosition = Vector2.zero
			resize()
		end)
	end

	head.MouseButton1Click:Connect(function() toggle(not open) end)
	flagReg(win, o, value())
	if hadSaved then restored(o.Callback, value()) end
	return {
		Set = function(_, v)
			if multi then
				sel = {}
				for _, d in ipairs(type(v) == "table" and v or {}) do
					if byId[idOf(d)] then sel[idOf(d)] = true end
				end
			else
				if byId[v] then cur = byId[v] end
			end
			refresh()
			mark()
			emit()
		end,
		Get = value,
	}
end

function Sec:Input(o)
	local win = self.win
	local r = rowFrame(self, ROW + 28)
	self:_reg(r, o.Name)
	rowLabel(win, r, o.Name, 12, 4, 20, 13)
	local holder = new("Frame", { BackgroundColor3 = C.field, BorderSizePixel = 0, Position = UDim2.fromOffset(4, 28), Size = UDim2.new(1, -8, 0, ROW) }, r)
	round(holder, R.item)
	local saved = flagGet(win, o)
	local tb = new("TextBox", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = (type(saved) == "string") and saved or (o.Default or ""),
		PlaceholderColor3 = C.sub, TextColor3 = C.text,
		FontFace = FONT, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, holder)
	pad(tb, 12, 0, 12, 0)
	local function ph() tb.PlaceholderText = win:T(o.Placeholder or "") tb.TextSize = 13 + win:_boost() end
	win._hooks[#win._hooks + 1] = ph
	ph()
	tb.Focused:Connect(function() tw(holder, { BackgroundColor3 = C.raised }) end)
	tb.FocusLost:Connect(function(enter)
		tw(holder, { BackgroundColor3 = C.field })
		flagPut(win, o, tb.Text, tb.Text)
		safe(o.Callback, tb.Text, enter)
	end)
	flagReg(win, o, tb.Text)
	if type(saved) == "string" then restored(o.Callback, tb.Text, false) end
	return { Set = function(_, t) tb.Text = t flagPut(win, o, t, t) end, Get = function() return tb.Text end }
end

function Sec:Keybind(o)
	local win = self.win
	local key = o.Default or Enum.KeyCode.RightShift
	local saved = flagGet(win, o)
	if type(saved) == "string" then
		local ok, k = pcall(function() return Enum.KeyCode[saved] end)
		if ok and k then key = k end
	end
	local isToggle = o.IsToggleKey == true
	local allowClear = (o.AllowClear ~= false) and not isToggle
	local r = rowFrame(self, ROW)
	self:_reg(r, o.Name)
	rowLabel(win, r, o.Name, 110)
	local pill = new("TextButton", {
		AutoButtonColor = false, BackgroundColor3 = C.field, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0),
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), TextSize = 12, FontFace = FONT_B, TextColor3 = C.text, Text = key.Name,
	}, r)
	circle(pill)
	pad(pill, 12, 0, 12, 0)
	local function show()
		pill.Text = (key == Enum.KeyCode.Unknown) and win:T({ en = "None", th = "ไม่มี" }) or key.Name
	end
	win._hooks[#win._hooks + 1] = show
	show()

	local me = { get = function() return key end }
	if not isToggle then win._binds[#win._binds + 1] = me end
	local function conflict(k)
		if not isToggle and k == win.toggleKey then return true end
		for _, g in ipairs(win._binds) do
			if g ~= me and g.get() == k then return true end
		end
		return false
	end

	local waiting = false
	pill.MouseButton1Click:Connect(function()
		waiting = true
		win._capturing = true
		pill.Text = "..."
		tw(pill, { BackgroundColor3 = win.accent, TextColor3 = onC(win.accent) })
	end)
	flagReg(win, o, key)
	win._conns[#win._conns + 1] = UIS.InputBegan:Connect(function(i, gp)
		if waiting and i.UserInputType == Enum.UserInputType.Keyboard then
			waiting = false
			local k = i.KeyCode
			if k == Enum.KeyCode.Escape then
				-- ยกเลิก
			elseif k == Enum.KeyCode.Backspace and allowClear then
				key = Enum.KeyCode.Unknown
				flagPut(win, o, key, key.Name)
				safe(o.Callback, key)
			elseif conflict(k) then
				win:Notify({ Type = "error", Title = { en = "Key already in use", th = "ปุ่มนี้ถูกใช้แล้ว" }, Text = k.Name })
			else
				key = k
				flagPut(win, o, key, key.Name)
				safe(o.Callback, key)
			end
			show()
			tw(pill, { BackgroundColor3 = C.field, TextColor3 = C.text })
			task.defer(function() win._capturing = false end)
		elseif not waiting and not gp and o.OnPress and key ~= Enum.KeyCode.Unknown and i.KeyCode == key then
			safe(o.OnPress)
		end
	end)
	if type(saved) == "string" then restored(o.Callback, key) end
	return {
		Get = function() return key end,
		Set = function(_, k)
			if typeof(k) ~= "EnumItem" then return end
			key = k
			show()
			flagPut(win, o, key, key.Name)
			safe(o.Callback, key)
		end,
	}
end

function Sec:Swatches(o)
	local win = self.win
	local r = rowFrame(self, ROW + 24)
	self:_reg(r, o.Name)
	rowLabel(win, r, o.Name, 12, 4, 20, 13)
	local hold = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -24, 0, 26) }, r)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder }, hold)
	local dots = {}
	for i, name in ipairs(ACCENT_ORDER) do
		local b = new("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = ACCENTS[name], Size = UDim2.fromOffset(26, 26), LayoutOrder = i }, hold)
		circle(b)
		local d = new("Frame", {
			AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(0, 0),
			BackgroundColor3 = onC(ACCENTS[name]), BorderSizePixel = 0,
		}, b)
		circle(d)
		dots[name] = d
		b.MouseButton1Click:Connect(function() win:SetAccent(name) end)
	end
	local function upd()
		for n, d in pairs(dots) do
			tw(d, { Size = (n == win.accentName) and UDim2.fromOffset(10, 10) or UDim2.fromOffset(0, 0) }, TweenInfo.new(.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
		end
	end
	win._acc[#win._acc + 1] = upd
	upd()
end

function Sec:Segmented(o)
	local win = self.win
	local opts = o.Options or {}
	local n = math.max(#opts, 1)
	local function idOf(x) return type(x) == "table" and (x.id or x.en) or x end
	local ids = {}
	for i, x in ipairs(opts) do ids[idOf(x)] = i end
	local cur = idOf(o.Default or opts[1])
	local saved = flagGet(win, o)
	local hadSaved = false
	if type(saved) == "string" and ids[saved] then cur, hadSaved = saved, true end

	local r = rowFrame(self, ROW + 30)
	self:_reg(r, o.Name)
	rowLabel(win, r, o.Name, 12, 4, 20, 13)
	local track = new("Frame", { BackgroundColor3 = C.field, BorderSizePixel = 0, Position = UDim2.fromOffset(4, 30), Size = UDim2.new(1, -8, 0, ROW) }, r)
	round(track, R.item)
	local inner = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6) }, track)
	local pill = new("Frame", {
		BackgroundColor3 = win.accent, BorderSizePixel = 0, ZIndex = 1,
		Size = UDim2.new(1 / n, 0, 1, 0), Position = UDim2.new(((ids[cur] or 1) - 1) / n, 0, 0, 0),
	}, inner)
	round(pill, R.small + 1)
	local btns = {}
	local function paint()
		for id, b in pairs(btns) do b.TextColor3 = (id == cur) and onC(win.accent) or C.sub end
	end
	for i, opt in ipairs(opts) do
		local id = idOf(opt)
		local b = new("TextButton", {
			AutoButtonColor = false, BackgroundTransparency = 1, FontFace = FONT_B, ZIndex = 2, TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1 / n, 0, 1, 0), Position = UDim2.new((i - 1) / n, 0, 0, 0),
		}, inner)
		win:_bind(b, opt, 13)
		btns[id] = b
		b.MouseButton1Click:Connect(function()
			if cur == id then return end
			win:_click()
			cur = id
			tw(pill, { Position = UDim2.new((i - 1) / n, 0, 0, 0) }, TweenInfo.new(.35, Enum.EasingStyle.Quint))
			paint()
			flagPut(win, o, cur, cur)
			safe(o.Callback, cur)
		end)
	end
	paint()
	win._acc[#win._acc + 1] = function() tw(pill, { BackgroundColor3 = win.accent }) paint() end
	flagReg(win, o, cur)
	if hadSaved then restored(o.Callback, cur) end
	return {
		Set = function(_, id)
			if ids[id] then
				cur = id
				tw(pill, { Position = UDim2.new((ids[id] - 1) / n, 0, 0, 0) }, TweenInfo.new(.35, Enum.EasingStyle.Quint))
				paint()
				flagPut(win, o, cur, cur)
				safe(o.Callback, cur)
			end
		end,
		Get = function() return cur end,
	}
end

function Sec:Stepper(o)
	local win = self.win
	local min, max, step = o.Min or 0, o.Max or 100, o.Step or 1
	local saved = flagGet(win, o)
	local value = math.clamp(type(saved) == "number" and saved or o.Default or min, min, max)
	local r = rowFrame(self, ROW)
	self:_reg(r, o.Name)
	rowLabel(win, r, o.Name, 134)
	local grp = new("Frame", { BackgroundColor3 = C.field, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(118, 28) }, r)
	circle(grp)
	local val = new("TextLabel", {
		BackgroundTransparency = 1, TextSize = 13, FontFace = FONT_B, TextColor3 = C.text,
		Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -56, 1, 0),
	}, grp)

	local function set(v, silent)
		v = math.clamp(math.floor(v / step + .5) * step, min, max)
		v = tonumber(string.format("%.4f", v))
		value = v
		val.Text = tostring(v) .. (o.Suffix or "")
		if not silent then
			flagPut(win, o, v, v)
			safe(o.Callback, v)
		end
	end
	set(value, true)
	flagReg(win, o, value)

	local holdId = 0
	local function mk(iconName, anchorX, dir)
		local b = new("TextButton", {
			AutoButtonColor = false, Text = "", BackgroundColor3 = C.hover, BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(anchorX, 0), Position = UDim2.new(anchorX, 0, 0, 0), Size = UDim2.fromOffset(28, 28),
		}, grp)
		circle(b)
		local ic = Icon(iconName, b, 14, C.text)
		ic.AnchorPoint, ic.Position = Vector2.new(.5, .5), UDim2.fromScale(.5, .5)
		b.MouseEnter:Connect(function() tw(b, { BackgroundTransparency = 0 }) end)
		local function stop() holdId += 1 end
		b.MouseLeave:Connect(function() tw(b, { BackgroundTransparency = 1 }) stop() end)
		b.MouseButton1Up:Connect(stop)
		b.MouseButton1Down:Connect(function()
			holdId += 1
			local id = holdId
			set(value + dir * step)
			task.spawn(function()
				task.wait(.4)
				while holdId == id do
					set(value + dir * step)
					task.wait(.07)
				end
			end)
		end)
	end
	mk("minus", 0, -1)
	mk("plus", 1, 1)
	if type(saved) == "number" then restored(o.Callback, value) end
	return { Set = function(_, v) set(v) end, Get = function() return value end }
end

function Sec:Progress(o)
	local win = self.win
	local min, max = o.Min or 0, o.Max or 100
	local r = rowFrame(self, 52)
	self:_reg(r, o.Name)
	rowLabel(win, r, o.Name, 76, 6, 22)
	local val = new("TextLabel", {
		BackgroundTransparency = 1, TextSize = 13, TextColor3 = C.sub, FontFace = FONT_B, TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 6), Size = UDim2.fromOffset(66, 22),
	}, r)
	local bar = new("Frame", { BackgroundColor3 = C.hover, BorderSizePixel = 0, Position = UDim2.new(0, 12, 0, 36), Size = UDim2.new(1, -24, 0, 8) }, r)
	circle(bar)
	local fill = new("Frame", { BackgroundColor3 = win.accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, bar)
	circle(fill)
	accentGrad(fill)
	win._acc[#win._acc + 1] = function(c) tw(fill, { BackgroundColor3 = c }) end
	local value = min
	local function set(v)
		v = math.clamp(v, min, max)
		value = v
		local p = (max > min) and (v - min) / (max - min) or 0
		val.Text = math.floor(p * 100 + .5) .. "%"
		tw(fill, { Size = UDim2.fromScale(p, 1) }, TweenInfo.new(.4, Enum.EasingStyle.Quint))
	end
	set(o.Default or min)
	return { Set = function(_, v) set(v) end, Get = function() return value end }
end

function Sec:ColorPicker(o)
	local win = self.win
	local col = o.Default or Color3.fromRGB(255, 255, 255)
	local saved = flagGet(win, o)
	local hadSaved = false
	if type(saved) == "table" and #saved == 3 then
		col, hadSaved = Color3.fromRGB(saved[1], saved[2], saved[3]), true
	end
	local h, s, v = col:ToHSV()
	local SVH, PANEL = 112, 150

	local box = new("Frame", {
		BackgroundColor3 = C.raised, BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, ROW), LayoutOrder = self:_o(),
	}, self.holder)
	round(box, R.item)
	self:_reg(box, o.Name)
	local head = new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 0, ROW) }, box)
	rowLabel(win, head, o.Name, 126)
	local sw = new("Frame", {
		AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -12, .5, 0), Size = UDim2.fromOffset(34, 22),
		BorderSizePixel = 0, BackgroundColor3 = col,
	}, head)
	circle(sw)
	local hex = new("TextLabel", {
		BackgroundTransparency = 1, TextSize = 12, TextColor3 = C.sub, FontFace = FONT_B, TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -54, .5, 0), Size = UDim2.fromOffset(70, 20),
	}, head)

	local panel = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, ROW), Size = UDim2.new(1, 0, 0, PANEL), Visible = false }, box)
	local sv = new("Frame", {
		BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0, Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -20, 0, SVH),
	}, panel)
	round(sv, R.small)
	local whiteL = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 1 }, sv)
	round(whiteL, R.small)
	new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, whiteL)
	local blackL = new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 2 }, sv)
	round(blackL, R.small)
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, blackL)
	local svCur = new("Frame", {
		AnchorPoint = Vector2.new(.5, .5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.fromOffset(18, 18), ZIndex = 3,
	}, sv)
	circle(svCur)
	local svIn = new("Frame", {
		AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(12, 12), BorderSizePixel = 0, BackgroundColor3 = col,
	}, svCur)
	circle(svIn)

	local keys = {}
	for i = 0, 6 do keys[#keys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 >= 1 and 0 or i / 6, 1, 1)) end
	local hue = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Position = UDim2.fromOffset(10, SVH + 14), Size = UDim2.new(1, -20, 0, 14),
	}, panel)
	circle(hue)
	new("UIGradient", { Color = ColorSequence.new(keys) }, hue)
	local hueCur = new("Frame", {
		AnchorPoint = Vector2.new(.5, .5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.fromOffset(22, 22),
		Position = UDim2.fromScale(h, .5), ZIndex = 3,
	}, hue)
	circle(hueCur)
	local hueIn = new("Frame", {
		AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(14, 14), BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
	}, hueCur)
	circle(hueIn)

	local function apply(fire)
		col = Color3.fromHSV(h, s, v)
		sw.BackgroundColor3 = col
		hex.Text = "#" .. string.upper(col:ToHex())
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCur.Position = UDim2.fromScale(s, 1 - v)
		svIn.BackgroundColor3 = col
		hueCur.Position = UDim2.fromScale(h, .5)
		hueIn.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		if fire then
			local rgb = { math.floor(col.R * 255 + .5), math.floor(col.G * 255 + .5), math.floor(col.B * 255 + .5) }
			flagPut(win, o, col, rgb)
			safe(o.Callback, col)
		end
	end
	apply(false)
	flagReg(win, o, col)

	local mode, page = nil, self.page
	local function fromSV(p)
		s = math.clamp((p.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
		v = 1 - math.clamp((p.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
		apply(true)
	end
	local function fromHue(p)
		h = math.clamp((p.X - hue.AbsolutePosition.X) / math.max(hue.AbsoluteSize.X, 1), 0, 1)
		apply(true)
	end
	sv.InputBegan:Connect(function(i)
		if isPress(i) then mode = "sv" page.ScrollingEnabled = false fromSV(i.Position) end
	end)
	hue.InputBegan:Connect(function(i)
		if isPress(i) then mode = "hue" page.ScrollingEnabled = false fromHue(i.Position) end
	end)
	win._conns[#win._conns + 1] = UIS.InputChanged:Connect(function(i)
		if mode and isMove(i) then
			if mode == "sv" then fromSV(i.Position) else fromHue(i.Position) end
		end
	end)
	win._conns[#win._conns + 1] = UIS.InputEnded:Connect(function(i)
		if mode and isPress(i) then mode = nil page.ScrollingEnabled = true end
	end)

	local open = false
	head.MouseButton1Click:Connect(function()
		open = not open
		if open then panel.Visible = true end
		tw(box, { Size = UDim2.new(1, 0, 0, open and (ROW + PANEL) or ROW), BackgroundTransparency = open and 0 or 1 }, TweenInfo.new(.32, Enum.EasingStyle.Quint))
		if not open then
			task.delay(.33, function() if not open then panel.Visible = false end end)
		end
	end)
	if hadSaved then restored(o.Callback, col) end
	return {
		Set = function(_, c) h, s, v = c:ToHSV() apply(true) end,
		Get = function() return col end,
	}
end

----------------------------------------------------------------------
-- Tab
----------------------------------------------------------------------
local Tab = {}
Tab.__index = Tab

function Tab:Section(title, side, icon)
	local si = (side == "right" or side == 2) and 2 or ((side == "left" or side == 1) and 1 or ((self.count % 2) + 1))
	self.count += 1
	local win = self.win
	local card = new("Frame", {
		BackgroundColor3 = C.card, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self.count,
	}, self.cols[si])
	round(card, R.card)
	new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(222, 222, 228)), Rotation = 90 }, card)
	glass(card)
	local cardScale = new("UIScale", {}, card) -- ใช้ทำอนิเมชันการ์ดไล่ขึ้นมาตอนสลับหน้า
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, card)
	pad(card, 8, 8, 8, 8)

	-- หัวการ์ด (กดเพื่อพับ/ขยาย)
	local head = new("TextButton", {
		AutoButtonColor = false, Text = "", BackgroundColor3 = C.raised, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 0,
	}, card)
	round(head, R.item)
	pressFx(head, .985)
	-- ไล่เฉดบาง ๆ: สว่างด้านบน มืดลงเล็กน้อยด้านล่าง
	new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(206, 206, 210)), Rotation = 90 }, head)
	hoverTint(head, function() return C.raised end, function() return C.hover end)
	local hl = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -44, 1, 0) }, head)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder,
	}, hl)
	pad(hl, 14, 0, 0, 0)
	if icon then
		local ic, isetc = Icon(icon, hl, 16, win.accent)
		ic.LayoutOrder = 1
		win._acc[#win._acc + 1] = function(c) isetc(c) end
	end
	local tl = new("TextLabel", {
		BackgroundTransparency = 1, FontFace = FONT_B, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20), LayoutOrder = 2,
	}, hl)
	win:_bind(tl, title, 14)
	-- ป้ายจำนวนฟังก์ชันในการ์ด (แสดงเฉพาะตอนพับการ์ดอยู่)
	local badge = new("TextLabel", {
		BackgroundColor3 = win.accent, BackgroundTransparency = .82, BorderSizePixel = 0, Text = "0", TextSize = 11,
		TextColor3 = win.accent, FontFace = FONT_B, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 18),
		LayoutOrder = 3, Visible = false,
	}, hl)
	circle(badge)
	pad(badge, 7, 0, 7, 0)
	win._acc[#win._acc + 1] = function(c) badge.BackgroundColor3 = c badge.TextColor3 = c end
	local chev = Icon("chevron", head, 16, C.sub)
	chev.AnchorPoint, chev.Position = Vector2.new(1, .5), UDim2.new(1, -14, .5, 0)

	local body = new("Frame", {
		BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1,
	}, card)
	local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, body)
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
	pad(holder, 6, 10, 6, 6)

	local open = true
	head.MouseButton1Click:Connect(function()
		open = not open
		badge.Visible = (not open) and (tonumber(badge.Text) or 0) > 0
		local k = win:_k()
		local full = holder.AbsoluteSize.Y / k
		local info = TweenInfo.new(.3, Enum.EasingStyle.Quint)
		if open then
			local nowH = body.AbsoluteSize.Y / k
			body.AutomaticSize = Enum.AutomaticSize.None
			body.Size = UDim2.new(1, 0, 0, nowH)
			local t = tw(body, { Size = UDim2.new(1, 0, 0, full) }, info)
			t.Completed:Connect(function(state)
				if open and state == Enum.PlaybackState.Completed then
					body.AutomaticSize = Enum.AutomaticSize.Y
					body.Size = UDim2.new(1, 0, 0, 0)
				end
			end)
		else
			body.AutomaticSize = Enum.AutomaticSize.None
			body.Size = UDim2.new(1, 0, 0, full)
			tw(body, { Size = UDim2.new(1, 0, 0, 0) }, info)
		end
		tw(chev, { Rotation = open and 0 or -90 })
	end)

	local sec = setmetatable({
		win = win, holder = holder, order = 0, page = self.page, rows = {}, card = card, keys = mkKeys(title), cardScale = cardScale, badge = badge,
	}, Sec)
	self.secs[#self.secs + 1] = sec
	return sec
end

----------------------------------------------------------------------
-- Window
----------------------------------------------------------------------
local RVX = {}
RVX.__index = RVX

function RVX:T(v)
	if type(v) == "table" then return v[self.lang] or v.en or "" end
	return tostring(v)
end
function RVX:_boost() return TEXT_BOOST[self.lang] or 0 end
function RVX:_bind(lbl, v, size)
	local function apply()
		lbl.Text = self:T(v)
		if size then lbl.TextSize = size + self:_boost() end
	end
	apply()
	self._hooks[#self._hooks + 1] = apply
end
function RVX:_k()
	return math.max(self._main.AbsoluteSize.X / math.max(1, self._main.Size.X.Offset), .01)
end

-- เสียงคลิกเบา ๆ (ปิดได้ที่ ตั้งค่า > เสียงคลิก)
function RVX:_click()
	if not self.soundOn or self._destroyed then return end
	local s = self._sfx
	if not s then
		s = new("Sound", { Name = "RVXClick", SoundId = STYLE.ClickSound, Volume = STYLE.ClickVolume }, self.Gui)
		self._sfx = s
	end
	pcall(function() s.TimePosition = 0 s:Play() end)
end

function RVX:_save()
	if self._saving then return end
	self._saving = true
	task.delay(.6, function()
		self._saving = false
		pcall(function()
			if writefile then
				local custom = self.accentName == "Custom" and {
					math.floor(self.accent.R * 255 + .5), math.floor(self.accent.G * 255 + .5), math.floor(self.accent.B * 255 + .5),
				} or nil
				writefile(CONFIG_FILE, HttpService:JSONEncode({
					lang = self.lang, font = self.fontName, theme = self.themeName, accent = self.accentName, accentRGB = custom, scale = self.userScale, fit = 1, opacity = self.userOpacity, win = self._userSize and { self._userSize.X, self._userSize.Y } or nil, pulse = self.fabPulse,
					key = self.toggleKey.Name, fab = { self.fabPos.X, self.fabPos.Y }, flags = self._data,
				}))
			end
		end)
	end)
end

-- (เลิกใช้) ปุ่มโลโก้ไม่มีแสงกะพริบแล้ว เก็บไว้เพื่อไม่ให้โค้ดเก่าที่เรียกพัง
function RVX:_pulseUpdate() end

function RVX.new(opts)
	opts = opts or {}
	local cfg = loadCfg()
	local themeName = THEMES[cfg.theme] and cfg.theme or "Dark"
	setPalette(themeName)
	local fontName = FONT_FAMILIES[cfg.font] and cfg.font or "Gotham"
	local self = setmetatable({
		tabs = {}, _conns = {}, _hooks = {}, _acc = {}, _binds = {}, Flags = {}, visible = true, compact = false,
		lang = cfg.lang or opts.Language or "th",
		accentName = ACCENTS[cfg.accent] and cfg.accent or (ACCENTS[opts.Accent] and opts.Accent or "Violet"),
		themeName = themeName, fontName = fontName,
		userScale = ((not TOUCH) or cfg.fit == 1) and (tonumber(cfg.scale) or 1) or defaultScale(),
		userOpacity = math.clamp(tonumber(cfg.opacity) or .85, .4, 1), -- ค่าเริ่มต้น: โปร่งใส 15%
		fabPulse = cfg.pulse == true, soundOn = true,
		_saved = type(cfg.flags) == "table" and cfg.flags or {},
		_data = {},
	}, RVX)
	for k, v in pairs(self._saved) do self._data[k] = v end
	setFonts(self.fontName, self.lang)
	if type(cfg.win) == "table" and tonumber(cfg.win[1]) and tonumber(cfg.win[2]) and ((not TOUCH) or cfg.fit == 1) then
		self._userSize = Vector2.new(tonumber(cfg.win[1]), tonumber(cfg.win[2]))
	end
	self.accent = ACCENTS[self.accentName]
	if cfg.accent == "Custom" and type(cfg.accentRGB) == "table" and #cfg.accentRGB == 3 then
		self.accentName = "Custom"
		self.accent = Color3.fromRGB(cfg.accentRGB[1], cfg.accentRGB[2], cfg.accentRGB[3])
	end
	local okk, kc = pcall(function() return Enum.KeyCode[cfg.key] end)
	self.toggleKey = (okk and kc) or opts.Keybind or Enum.KeyCode.RightShift
	self._defaultKey = opts.Keybind or Enum.KeyCode.RightShift
	-- ตัวเดียวรัน per-frame ทั้งหมด (เงา / DragBar / ResizeArc / ลากหน้าต่าง) แทนการต่อ RenderStepped 4 ตัว
	self._frameFns = {}
	local function onFrame(fn) self._frameFns[#self._frameFns + 1] = fn end
	self._conns[#self._conns + 1] = RunService.RenderStepped:Connect(function(dt)
		for _, fn in ipairs(self._frameFns) do fn(dt) end
	end)

	local host = (gethui and gethui()) or nil
	if not host then host = Players.LocalPlayer:WaitForChild("PlayerGui") end
	local gui = new("ScreenGui", {
		Name = "RVXUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, host)
	self.Gui = gui

	-- Window (CanvasGroup: ห้ามใส่ UIGradient บนตัวมันเอง เพราะจะคูณสีทุกอย่างข้างใน)
	-- เงาใต้หน้าต่าง (Roblox ไม่มีเงาในตัว ใช้รูปเงา 9-slice ซ้อนด้านหลัง อยู่นอก CanvasGroup เพื่อไม่ให้ถูกตัดขอบ)
	local shadow = new("ImageLabel", {
		Name = "Shadow", BackgroundTransparency = 1, BorderSizePixel = 0, Image = "rbxassetid://6014261993",
		ImageColor3 = Color3.new(0, 0, 0), ImageTransparency = 1, ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450), AnchorPoint = Vector2.new(.5, .5), ZIndex = 0, Visible = false,
	}, gui)
	local main = new("Frame", {
		AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), BackgroundTransparency = 1,
		BorderSizePixel = 0, Visible = false, Size = UDim2.fromOffset(780, 470),
	}, gui)
	round(main, R.window)
	local bgFill = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 0,
	}, main)
	round(bgFill, R.window)
	self._bgGrad = new("UIGradient", {
		Color = ColorSequence.new(C.win1, C.win2), Rotation = 90,
	}, bgFill)
	-- แสงสีเน้นจาง ๆ ที่ขอบบนของหน้าต่าง ให้พื้นมีมิติ ไม่แบนทึบ (เปลี่ยนสีตาม Accent)
	local glow = new("Frame", {
		BackgroundColor3 = self.accent, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 190), ZIndex = 0,
	}, main)
	round(glow, R.window)
	new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, .84), NumberSequenceKeypoint.new(1, 1) }),
	}, glow)
	self._acc[#self._acc + 1] = function(c) tw(glow, { BackgroundColor3 = c }) end
	-- เส้นขอบกระจกบางมากรอบหน้าต่าง (Frame ย่อยเว้น 1px ในหน้าต่าง เพราะ CanvasGroup ตัดส่วนที่ยื่นออกนอก)
	local winLine = new("Frame", {
		Name = "Outline", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10,
		Position = UDim2.fromOffset(1, 1), Size = UDim2.new(1, -2, 1, -2),
	}, main)
	round(winLine, R.window - 1)
	glass(winLine)
	local scale = new("UIScale", { Scale = self.userScale * .94 }, main)
	self._main, self._scale = main, scale

	-- เงาตามหน้าต่างทุกเฟรม (ขนาด/ตำแหน่ง/ความโปร่ง)
	onFrame(function()
		if not SHADOW_ON or not main.Visible then
			shadow.Visible = false
			return
		end
		local s = scale.Scale
		local pos, size, vp = main.Position, main.Size, gui.AbsoluteSize
		local cx = vp.X * pos.X.Scale + pos.X.Offset
		local cy = vp.Y * pos.Y.Scale + pos.Y.Offset
		shadow.Visible = true
		shadow.Size = UDim2.fromOffset(size.X.Offset * s + 120 * s, size.Y.Offset * s + 120 * s)
		shadow.Position = UDim2.fromOffset(cx, cy + 10 * s)
		local base = (THEME_META[self.themeName] or THEME_META.Dark).shadow
		shadow.ImageTransparency = 1 - base
	end)

	----------------------------------------------------------------
	-- Sidebar
	----------------------------------------------------------------
	-- ไซด์บาร์: พื้นหลังชั้นเดียว มุมโค้งทั้งสี่ แต่ยื่นเกินขอบขวา 40px แล้วให้ Sidebar ตัดส่วนเกินทิ้ง (ClipsDescendants)
	-- => ขอบซ้ายโค้งตามหน้าต่าง ขอบขวาเรียบ และไม่มีพื้นซ้อนกัน 2 ชั้น (เดิมแถบ 40px ขวาจะเข้มกว่าเพราะโปร่งแสงซ้อนกัน)
	local sidebar = new("Frame", { BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.new(0, SIDE_W, 1, 0) }, main)
	local sideBg = new("Frame", { BackgroundColor3 = C.side, BorderSizePixel = 0, Size = UDim2.new(1, 40, 1, 0) }, sidebar)
	round(sideBg, R.window)
	local sideFill = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 0, 0, 0), Visible = false }, sidebar) -- เลิกใช้ (คงไว้ให้โค้ดเลย์เอาต์เดิมอ้างถึงได้)
	self._opaque = { bgFill, sideBg } -- ความโปร่งของหน้าต่างปรับเฉพาะพื้นหลัง (ตัวหนังสือไม่โปร่ง ไม่เบลอ)
	-- เส้นแบ่งบางๆ ระหว่างไซด์บาร์กับเนื้อหา (จางที่หัว/ท้าย)
	local sdiv = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 1, 1, 0), ZIndex = 2,
	}, sidebar)
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(.2, .93), NumberSequenceKeypoint.new(.8, .93), NumberSequenceKeypoint.new(1, 1),
	}) }, sdiv)

	-- หัวไซด์บาร์: โลโก้ไม่มีกรอบ + ชื่อ + เวอร์ชันแบบแคปซูล
	local brand = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64) }, sidebar)
	local lg0 = Logo(brand, 38)
	lg0.AnchorPoint, lg0.Position = Vector2.new(0, .5), UDim2.new(0, 16, .5, 0)
	self._brandLogo = lg0
	local titles = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(64, 0), Size = UDim2.new(1, -72, 1, 0) }, brand)
	new("UIListLayout", { Padding = UDim.new(0, 3), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, titles)
	-- ชื่อแบรนด์: ไล่เฉดตาม Accent/ธีม + แสงวิ่งผ่าน (shimmer) + แสงเรืองจางๆ ด้านหลัง
	local trow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1 }, titles)
	local titleTxt = opts.Title or "RVXHUB"
	local function mkTitle(z)
		return new("TextLabel", {
			BackgroundTransparency = 1, Text = titleTxt, TextSize = 16, TextColor3 = Color3.new(1, 1, 1), FontFace = FONT_B,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.fromScale(1, 1), ZIndex = z,
		}, trow)
	end
	local titleLbl = mkTitle(2)
	local titleGrad = new("UIGradient", { Color = ColorSequence.new(self.accent, Color3.new(1, 1, 1)) }, titleLbl)
	local shine = mkTitle(3)
	shine.Active = false
	local shineGrad = new("UIGradient", {
		Offset = Vector2.new(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(.38, 1), NumberSequenceKeypoint.new(.5, .4),
			NumberSequenceKeypoint.new(.62, 1), NumberSequenceKeypoint.new(1, 1),
		}),
	}, shine)
	-- สีชื่อ 3 จุด: สีเน้น -> เอียงโทนสี -> จางเป็นขาว (ธีมสว่างใช้โทนเข้มแทนขาว กันจมพื้น)
	function self._paintTitle()
		local c = self.accent
		local h, s, v = c:ToHSV()
		local light = self.themeName == "Light"
		local a = light and c:Lerp(Color3.new(0, 0, 0), .3) or c
		local m = Color3.fromHSV((h + .07) % 1, s, light and math.min(v, .7) or math.max(v, .85))
		local z = light and m:Lerp(Color3.new(0, 0, 0), .25) or c:Lerp(Color3.new(1, 1, 1), .8)
		titleGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, a), ColorSequenceKeypoint.new(.55, m), ColorSequenceKeypoint.new(1, z),
		})
	end
	self._paintTitle()
	self._acc[#self._acc + 1] = function() self._paintTitle() end
	task.spawn(function()
		task.wait(1.5)
		while not self._destroyed do
			if self.visible and (not self.compact or self._drawerOpen) then
				shineGrad.Offset = Vector2.new(-1, 0)
				local t = tw(shineGrad, { Offset = Vector2.new(1, 0) }, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut))
				t.Completed:Wait()
			end
			task.wait(4)
		end
	end)
	-- แถวใต้ชื่อ: เวอร์ชันแบบแคปซูล + ชื่อแมพตัวเล็ก
	local vrow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 2 }, titles)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
	}, vrow)
	local ver = new("TextLabel", {
		BackgroundColor3 = self.accent, BackgroundTransparency = .88, BorderSizePixel = 0,
		Text = opts.Version or opts.Badge or "v5.0.0", TextSize = 10, TextColor3 = self.accent, FontFace = FONT_B,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 16), LayoutOrder = 1,
	}, vrow)
	circle(ver)
	pad(ver, 8, 0, 8, 0)
	self._acc[#self._acc + 1] = function(c) ver.BackgroundColor3 = c ver.TextColor3 = c end
	local mapLbl = new("TextLabel", {
		BackgroundTransparency = 1, Text = "", TextSize = 10, TextColor3 = C.sub, FontFace = FONT,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 16), LayoutOrder = 2, Visible = false,
	}, vrow)
	new("UISizeConstraint", { MaxSize = Vector2.new(74, 16) }, mapLbl)
	self._mapLbl = mapLbl
	if opts.MapName then
		self:SetMapName(opts.MapName)
	elseif opts.AutoMapName ~= false then
		task.spawn(function()
			local ok, info = pcall(function() return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId) end)
			if ok and info and info.Name and not self._destroyed and (self._mapLbl.Text == "") then self:SetMapName(info.Name) end
		end)
	end

	-- รายการแท็บ
	local tabsHost = new("Frame", { BackgroundTransparency = 1, ClipsDescendants = true }, sidebar)
	-- ตัวบ่งชี้แท็บ: พื้นสี Accent จาง ๆ + แถบสีเข้มด้านซ้าย
	local indicator = new("Frame", {
		BackgroundColor3 = self.accent, BackgroundTransparency = .78, BorderSizePixel = 0, Size = UDim2.fromOffset(0, 0), ZIndex = 1,
	}, tabsHost)
	round(indicator, R.item)
	-- เข้มด้านซ้ายแล้วจางไปทางขวา
	new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, .6) }) }, indicator)
	local indBar = new("Frame", {
		BackgroundColor3 = self.accent, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, .5),
		Position = UDim2.new(0, 3, .5, 0), Size = UDim2.fromOffset(3, 18),
	}, indicator)
	circle(indBar)
	self._acc[#self._acc + 1] = function(c)
		tw(indicator, { BackgroundColor3 = c })
		indBar.BackgroundColor3 = c
		if self.current then self.current.setc(c) end
	end
	local tabsF = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(),
		Size = UDim2.fromScale(1, 1), ZIndex = 2,
	}, tabsHost)
	local tabList = new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, tabsF)
	self._tabsF, self._tabList, self._side, self._indicator = tabsF, tabList, tabsHost, indicator

	-- โปรไฟล์ผู้เล่น (ล่างซ้าย)
	local prof = new("TextButton", {
		AutoButtonColor = false, Text = "", BackgroundColor3 = C.card, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 8, 1, -8), Size = UDim2.new(1, -16, 0, 54),
		Visible = opts.Profile ~= false,
	}, sidebar)
	round(prof, R.item + 2)
	glass(prof)
	hoverTint(prof, function() return C.card end, function() return C.raised end)
	local av = new("ImageLabel", { BackgroundColor3 = C.raised, BorderSizePixel = 0, ImageTransparency = 1, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(34, 34) }, prof)
	circle(av)
	local ring = new("Frame", {
		BackgroundColor3 = C.card, BorderSizePixel = 0, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(41, 41), Size = UDim2.fromOffset(14, 14),
	}, prof)
	circle(ring)
	local dot = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(48, 209, 120), BorderSizePixel = 0, AnchorPoint = Vector2.new(.5, .5),
		Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(9, 9),
	}, ring)
	circle(dot)
	local lp = Players.LocalPlayer
	-- แสดงอายุคีย์แทนชื่อผู้เล่น (อ่านจาก getgenv().RVX_AUTH ที่สคริปต์หลักตั้งไว้)
	local genv = (getgenv and getgenv()) or _G
	local function keyExpiry()
		local au = genv.RVX_AUTH
		if type(au) ~= "table" then return nil end
		if au.lifetime == true then return math.huge end
		for _, f in ipairs({ "expires", "expire", "expiry", "expireAt", "expires_at", "expiresAt", "exp" }) do
			local v = tonumber(au[f])
			if v then
				if v > 1e12 then v = v / 1000 end      -- มิลลิวินาที -> วินาที
				return v
			end
		end
		return nil
	end
	local function keyTotal()
		local au = genv.RVX_AUTH
		if type(au) ~= "table" then return nil end
		if au.lifetime == true then return math.huge end
		local v = tonumber(au.total)
		return (v and v > 0) and v or nil
	end
	local GOLD, AMBER, RED = Color3.fromRGB(255, 204, 102), Color3.fromRGB(255, 184, 77), Color3.fromRGB(255, 92, 92)
	-- คืน: ข้อความสั้น, สี, สัดส่วนเวลาที่เหลือ (nil = ไม่แสดงแถบ)
	local function keyState()
		local e = keyExpiry()
		if not e then return { en = "—", th = "—" }, C.sub, nil end
		if e == math.huge or e - os.time() > 3650 * 86400 then return { en = "Lifetime", th = "ถาวร" }, GOLD, 1 end
		local left = e - os.time()
		local tot = keyTotal()
		local frac = tot and tot ~= math.huge and math.clamp(left / tot, 0, 1) or nil
		if left <= 0 then return { en = "Expired", th = "หมดอายุ" }, RED, 0 end
		local d, h, m = math.floor(left / 86400), math.floor(left % 86400 / 3600), math.floor(left % 3600 / 60)
		if d >= 3 then return { en = ("%dd %dh"):format(d, h), th = ("%d วัน %d ชม."):format(d, h) }, self.accent, frac end
		if d >= 1 then return { en = ("%dd %dh"):format(d, h), th = ("%d วัน %d ชม."):format(d, h) }, AMBER, frac end
		if h >= 1 then return { en = ("%dh %dm"):format(h, m), th = ("%d ชม. %d น."):format(h, m) }, RED, frac end
		return { en = ("%dm"):format(m), th = ("%d นาที"):format(m) }, RED, frac
	end
	-- ป้ายอายุคีย์ (pill) + ไอคอนกุญแจ
	local pill = new("Frame", {
		BackgroundColor3 = C.raised, BackgroundTransparency = .8, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.fromOffset(54, 8), Size = UDim2.fromOffset(0, 20),
	}, prof)
	circle(pill)
	local pillStroke = new("UIStroke", { Color = C.sub, Transparency = .6, Thickness = 1 }, pill)
	new("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 9) }, pill)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	}, pill)
	local keyIcon, setKeyIcon = Icon("key", pill, 12, C.text)
	keyIcon.LayoutOrder = 1
	local keyLbl = new("TextLabel", {
		BackgroundTransparency = 1, TextSize = 12, TextColor3 = C.text, FontFace = FONT_B, TextXAlignment = Enum.TextXAlignment.Left,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20), LayoutOrder = 2,
	}, pill)
	-- แถบเวลาที่เหลือ (บาง ๆ ใต้ชื่อแมพ)
	local track = new("Frame", {
		BackgroundColor3 = C.raised, BorderSizePixel = 0, Position = UDim2.fromOffset(54, 47), Size = UDim2.new(1, -68, 0, 3), Visible = false,
	}, prof)
	circle(track)
	local fill = new("Frame", { BackgroundColor3 = C.text, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, track)
	circle(fill)
	local function refreshKey()
		local txt, col, frac = keyState()
		keyLbl.Text = self:T(txt)
		keyLbl.TextSize = 12 + self:_boost()
		keyLbl.TextColor3 = col
		setKeyIcon(col)
		pill.BackgroundColor3 = col
		pill.BackgroundTransparency = .86
		pillStroke.Color = col
		fill.BackgroundColor3 = col
		track.BackgroundColor3 = C.raised
		track.Visible = frac ~= nil
		if frac then tw(fill, { Size = UDim2.fromScale(math.max(frac, 0.02), 1) }) end
	end
	self._hooks[#self._hooks + 1] = refreshKey
	refreshKey()
	-- สำรอง: ถ้าตัวโหลดไม่ได้ส่งวันหมดอายุ/อายุรวมมา ให้ถามเซิร์ฟเวอร์เองจากคีย์+อุปกรณ์ใน RVX_AUTH
	local fetchTries = 0
	local function needFetch() return not keyExpiry() or not keyTotal() end
	local function fetchExpiry()
		local au = genv.RVX_AUTH
		if type(au) ~= "table" or not au.key or not au.device or not needFetch() then return end
		fetchTries = fetchTries + 1
		local reqFn = (syn and syn.request) or http_request or request or (fluxus and fluxus.request) or (http and http.request)
		if not reqFn then return end
		local ok, res = pcall(reqFn, {
			Url = "https://www.rvxhub.site/api/key/verify", Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({ key = au.key, device = au.device }),
		})
		if not ok or type(res) ~= "table" then return end
		local okj, d = pcall(function() return HttpService:JSONDecode(res.Body or "") end)
		if not okj or type(d) ~= "table" or d.ok ~= true then return end
		local e = tonumber(d.expiresAt)
		if e then
			if e > 1e12 then e = e / 1000 end
			au.expires = e
		elseif tonumber(d.remainingMs) then
			au.expires = os.time() + tonumber(d.remainingMs) / 1000
		end
		if tonumber(d.totalMs) and tonumber(d.totalMs) > 0 then au.total = tonumber(d.totalMs) / 1000 end
		pcall(refreshKey)
	end
	task.spawn(function()
		task.wait(1)
		if not self._destroyed and needFetch() then pcall(fetchExpiry) end
		while not self._destroyed do
			task.wait(30)
			if self._destroyed then break end
			if needFetch() and fetchTries < 5 then pcall(fetchExpiry) end
			pcall(refreshKey)
		end
	end)
	local subLbl = new("TextLabel", {
		BackgroundTransparency = 1, TextSize = 10, TextColor3 = C.sub, FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(54, 31), Size = UDim2.new(1, -78, 0, 13),
	}, prof)
	self:_bind(subLbl, opts.Subtitle or { en = "Player", th = "ผู้เล่น" }, 10)
	local pch = Icon("chevron", prof, 14, C.sub)
	pch.AnchorPoint, pch.Position, pch.Rotation = Vector2.new(1, .5), UDim2.new(1, -12, .5, 0), -90
	-- อวาตาร์: ระหว่างโหลดให้วงกลมกะพริบเบา ๆ (skeleton) พอรูปมาให้ค่อย ๆ เฟดเข้า
	local avLoading = true
	task.spawn(function()
		while avLoading and not self._destroyed do
			tw(av, { BackgroundTransparency = .55 }, TweenInfo.new(.7, Enum.EasingStyle.Sine))
			task.wait(.7)
			if not avLoading then break end
			tw(av, { BackgroundTransparency = 0 }, TweenInfo.new(.7, Enum.EasingStyle.Sine))
			task.wait(.7)
		end
	end)
	task.spawn(function()
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(lp.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		avLoading = false
		tw(av, { BackgroundTransparency = 0 }, TweenInfo.new(.2))
		if ok and img then
			av.Image = img
			tw(av, { ImageTransparency = 0 }, TweenInfo.new(.6, Enum.EasingStyle.Quint))
		end
	end)
	prof.MouseButton1Click:Connect(function()
		if self._settingsRec and self.current ~= self._settingsRec then self:Select(self._settingsRec) end
	end)

	----------------------------------------------------------------
	-- Content (header + pages)
	----------------------------------------------------------------
	local content = new("Frame", { BackgroundTransparency = 1 }, main)
	local header = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, HEADER_H) }, content)
	local hIcon = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 20, .5, 0), Size = UDim2.fromOffset(22, 22) }, header)
	local ttl = new("TextLabel", {
		BackgroundTransparency = 1, TextColor3 = C.text, FontFace = FONT_B, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(52, 0), Size = UDim2.new(1, -300, 1, 0),
	}, header)
	local minB = new("TextButton", {
		AutoButtonColor = false, Text = "", BackgroundColor3 = C.card, BackgroundTransparency = 1, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -14, .5, 0), Size = UDim2.fromOffset(34, 34),
	}, header)
	circle(minB)
	local mi = Icon("minimize", minB, 18, C.sub)
	mi.AnchorPoint, mi.Position = Vector2.new(.5, .5), UDim2.fromScale(.5, .5)
	minB.MouseEnter:Connect(function() tw(minB, { BackgroundTransparency = 0 }) end)
	minB.MouseLeave:Connect(function() tw(minB, { BackgroundTransparency = 1 }) end)
	minB.MouseButton1Click:Connect(function() self:SetVisible(false) end)

	-- ปุ่มเมนู (จอแคบ/มือถือแนวตั้ง): เปิดลิ้นชักรายการแท็บ
	local menuB = new("TextButton", {
		AutoButtonColor = false, Text = "", BackgroundColor3 = C.card, BackgroundTransparency = 1, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 8, .5, 0), Size = UDim2.fromOffset(40, 40), Visible = false,
	}, header)
	circle(menuB)
	local mni = Icon("menu", menuB, 20, C.text)
	mni.AnchorPoint, mni.Position = Vector2.new(.5, .5), UDim2.fromScale(.5, .5)
	menuB.MouseEnter:Connect(function() tw(menuB, { BackgroundTransparency = 0 }) end)
	menuB.MouseLeave:Connect(function() tw(menuB, { BackgroundTransparency = 1 }) end)

	local sbox = new("Frame", {
		BackgroundColor3 = C.field, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, .5),
		Position = UDim2.new(1, -56, .5, 0), Size = UDim2.fromOffset(190, 36),
	}, header)
	round(sbox, R.item)
	local si = Icon("search", sbox, 15, C.sub)
	si.AnchorPoint, si.Position = Vector2.new(0, .5), UDim2.new(0, 12, .5, 0)
	local search = new("TextBox", {
		BackgroundTransparency = 1, Text = "", PlaceholderColor3 = C.sub, TextColor3 = C.text, FontFace = FONT,
		ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(36, 0), Size = UDim2.new(1, -44, 1, 0),
	}, sbox)
	self._search = search
	local sFocus = new("UIStroke", { Color = self.accent, Thickness = 1.2, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, sbox)
	self._acc[#self._acc + 1] = function(c) sFocus.Color = c end
	search.Focused:Connect(function() tw(sFocus, { Transparency = .3 }) end)
	search.FocusLost:Connect(function() tw(sFocus, { Transparency = 1 }) end)
	local function phS() search.PlaceholderText = self:T({ en = "Search", th = "ค้นหา" }) search.TextSize = 13 + self:_boost() end
	self._hooks[#self._hooks + 1] = phS
	search:GetPropertyChangedSignal("Text"):Connect(function() self:_applySearch() end)

	-- หัวข้อหน้า (ชื่อ + ไอคอน ตามแท็บที่เลือก)
	self._ttl, self._hIcon = ttl, hIcon
	self._acc[#self._acc + 1] = function(c) if self._hSetc then self._hSetc(c) end end
	self._hooks[#self._hooks + 1] = function()
		ttl.Text = self._titleSrc and self:T(self._titleSrc) or ""
		ttl.TextSize = (self.compact and 18 or 22) + self:_boost()
	end

	local pages = new("Frame", { BackgroundTransparency = 1, ClipsDescendants = true }, content)
	self._pages = pages
	-- ม่านบาง ๆ ใช้ทำเฟดตอนสลับหน้า (ไม่รับการคลิก)
	self._veil = new("Frame", {
		BackgroundColor3 = C.win2, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 50, Visible = false,
	}, pages)

	----------------------------------------------------------------
	-- ลากหน้าต่าง (นุ่ม: lerp ทุกเฟรม) จาก header และ brand
	----------------------------------------------------------------
	local dragging, dStart, dOrig = false, Vector2.zero, Vector2.zero
	local target, cur = Vector2.zero, Vector2.zero
	local function startDrag(i)
		if isPress(i) then
			dragging, dStart, dOrig = true, Vector2.new(i.Position.X, i.Position.Y), target
		end
	end
	header.InputBegan:Connect(startDrag)
	brand.InputBegan:Connect(startDrag)
	self._conns[#self._conns + 1] = UIS.InputChanged:Connect(function(i)
		if dragging and isMove(i) then
			local vp = camera.ViewportSize
			local p = dOrig + (Vector2.new(i.Position.X, i.Position.Y) - dStart)
			target = Vector2.new(math.clamp(p.X, -vp.X / 2 + 60, vp.X / 2 - 60), math.clamp(p.Y, -vp.Y / 2 + 30, vp.Y / 2 - 40))
		end
	end)
	self._conns[#self._conns + 1] = UIS.InputEnded:Connect(function(i)
		if isPress(i) then dragging = false end
	end)
	onFrame(function(dt)
		if dragging or (cur - target).Magnitude > .3 then
			cur = cur:Lerp(target, 1 - math.exp(-dt * 26))
			local vpn = camera.ViewportSize
			main.Position = UDim2.new(.5, math.floor(cur.X + .5) + (vpn.X % 2) * .5, .5, math.floor(cur.Y + .5) + (vpn.Y % 2) * .5)
		end
	end)
	-- ตำแหน่งปลายทางของหน้าต่าง (ใช้กับอนิเมชันเปิดจากปุ่ม)
	self._home = function()
		local vpn = camera.ViewportSize
		return UDim2.new(.5, math.floor(target.X + .5) + (vpn.X % 2) * .5, .5, math.floor(target.Y + .5) + (vpn.Y % 2) * .5)
	end

	-- เส้นลากใต้หน้าต่าง (โทน iPhone home indicator): เส้นเล็กบางโปร่งแสง ห่างจากเมนูนิดเดียว ลากย้ายหน้าต่างได้เหมือน header
	-- อยู่นอก CanvasGroup (ไม่โดนตัดขอบ) / คำนวณตำแหน่งจาก Position+Size+UIScale ของหน้าต่างโดยตรง (ไม่พึ่ง AbsoluteSize ที่ไม่รวม UIScale)
	-- ความโปร่งของเส้นคงที่ ไม่เปลี่ยนตามตัวปรับความโปร่งใสของเมนู
	do
		local GAP, BAR_W, BAR_H = EDGE_GAP, 84, 4
		local IDLE_T, DRAG_T = .68, .42 -- BackgroundTransparency ปกติ / ตอนลาก
		local hit = new("TextButton", {
			Name = "DragBar", AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Visible = false,
			AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(150, 26), ZIndex = 5,
		}, gui)
		local line = new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, BackgroundTransparency = IDLE_T,
			AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(BAR_W, BAR_H),
		}, hit)
		circle(line)
		hit.InputBegan:Connect(startDrag)
		onFrame(function()
			if not (self.visible and main.Visible) then
				hit.Visible = false
				return
			end
			local s = self._scale.Scale
			local pos, size, vp = main.Position, main.Size, gui.AbsoluteSize
			local cx = vp.X * pos.X.Scale + pos.X.Offset
			local cy = vp.Y * pos.Y.Scale + pos.Y.Offset
			local bottom = cy + (size.Y.Offset * s) / 2
			hit.Visible = true
			hit.Size = UDim2.fromOffset(150 * s, 26 * s)
			line.Size = UDim2.fromOffset(BAR_W * s, BAR_H * s)
			hit.Position = UDim2.fromOffset(cx, bottom + (GAP + BAR_H / 2) * s) -- กึ่งกลางเส้น = ขอบล่าง + ช่องว่าง + ครึ่งความหนา
			line.BackgroundTransparency = dragging and DRAG_T or IDLE_T
		end)
	end

	-- แถบโค้งมุมขวาล่าง (โปร่งแสงเหมือนเส้นลาก): อยู่นอกเมนู โค้งขนานกับมุมหน้าต่าง ห่างเท่ากับเส้นลาก (EDGE_GAP)
	-- กดค้างแล้วลากเพื่อปรับขนาดหน้าต่าง (มุมซ้ายบนอยู่กับที่)
	-- ปิดในโหมดจอเล็ก/มือถือแนวตั้ง (compact) เพราะเลย์เอาต์แยกต่างหาก / ขนาดถูกจำไว้ใน config
	do
		local RW, TH = R.window, 3
		local IDLE_T, DRAG_T = .68, .35
		local EXT = RW + EDGE_GAP + TH + 2 -- ครอบคลุมควอเตอร์วงกลมด้านนอก
		local clip = new("Frame", {
			Name = "ResizeArc", BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, Visible = false,
			AnchorPoint = Vector2.new(0, 0), Size = UDim2.fromOffset(EXT, EXT), ZIndex = 5,
		}, gui)
		local ring = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, clip)
		circle(ring)
		local stroke = new("UIStroke", {
			Color = Color3.new(1, 1, 1), Thickness = TH, Transparency = IDLE_T, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, ring)
		local hit = new("TextButton", {
			Name = "ResizeHit", AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Visible = false,
			AnchorPoint = Vector2.new(0, 0), Size = UDim2.fromOffset(48, 48), ZIndex = 6,
		}, gui)

		local resizing, rMouse, rSize, rTarget, rScale = false, Vector2.zero, Vector2.zero, Vector2.zero, 1
		hit.InputBegan:Connect(function(i)
			if isPress(i) and not dragging then
				resizing = true
				rMouse = Vector2.new(i.Position.X, i.Position.Y)
				rSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
				rTarget, rScale = target, math.max(self._scale.Scale, .01)
			end
		end)
		self._conns[#self._conns + 1] = UIS.InputChanged:Connect(function(i)
			if not (resizing and isMove(i)) then return end
			local vp = gui.AbsoluteSize
			local d = Vector2.new(i.Position.X, i.Position.Y) - rMouse
			local w = math.clamp(rSize.X + d.X / rScale, MIN_WIN_W, math.max(MIN_WIN_W, (vp.X - 12) / rScale))
			local h = math.clamp(rSize.Y + d.Y / rScale, MIN_WIN_H, math.max(MIN_WIN_H, (vp.Y - 12) / rScale))
			main.Size = UDim2.fromOffset(w, h)
			self._userSize = Vector2.new(w, h)
			-- หน้าต่างยึดกึ่งกลางเป็นจุดอ้างอิง: ขยับกึ่งกลางครึ่งหนึ่งของส่วนที่ขยาย มุมซ้ายบนจึงนิ่ง
			target = rTarget + Vector2.new((w - rSize.X) * rScale, (h - rSize.Y) * rScale) / 2
			cur = target
			main.Position = UDim2.new(.5, cur.X, .5, cur.Y)
		end)
		self._conns[#self._conns + 1] = UIS.InputEnded:Connect(function(i)
			if resizing and isPress(i) then
				resizing = false
				self:_save()
			end
		end)
		onFrame(function()
			if not (self.visible and main.Visible) or self.compact then
				clip.Visible, hit.Visible = false, false
				return
			end
			local s = self._scale.Scale
			local pos, size, vp = main.Position, main.Size, gui.AbsoluteSize
			local bx = vp.X * pos.X.Scale + pos.X.Offset + size.X.Offset * s / 2
			local by = vp.Y * pos.Y.Scale + pos.Y.Offset + size.Y.Offset * s / 2
			-- จุดศูนย์กลางความโค้งของมุมหน้าต่าง = มุมขวาล่าง ถอยเข้ามา RW
			local ccx, ccy = bx - RW * s, by - RW * s
			local rr = (RW + EDGE_GAP) * s -- รัศมีขอบในของแถบ (เส้น UIStroke วาดออกด้านนอกของวงกลม)
			clip.Visible, hit.Visible = true, true
			clip.Size = UDim2.fromOffset(EXT * s, EXT * s)
			clip.Position = UDim2.fromOffset(ccx, ccy)
			ring.Size = UDim2.fromOffset(rr * 2, rr * 2)
			ring.Position = UDim2.fromOffset(-rr, -rr)
			stroke.Thickness = TH * s
			stroke.Transparency = resizing and DRAG_T or IDLE_T
			hit.Size = UDim2.fromOffset(48 * s, 48 * s)
			hit.Position = UDim2.fromOffset(bx - 24 * s, by - 24 * s)
		end)
	end

	-- Toasts
	local toasts = new("Frame", {
		BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.XY, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
	}, gui)
	local tl = new("UIListLayout", {
		Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
	}, toasts)
	self._toasts = toasts

	-- ปุ่มโลโก้ลอย (ลากวางตรงไหนก็ได้) : โลโก้ล้วน ไม่มีพื้น ไม่มีขอบ ไม่มีแสง ไม่มีเงา
	local vp0 = camera.ViewportSize
	local fp = cfg.fab and Vector2.new(cfg.fab[1], cfg.fab[2]) or Vector2.new(vp0.X - 40, vp0.Y * .38)
	self.fabPos = fp
	local fab = new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(fp.X, fp.Y), Size = UDim2.fromOffset(52, 52), Visible = false }, gui)
	local fabScale = new("UIScale", { Scale = 0 }, fab)
	local fbody = new("TextButton", { AutoButtonColor = false, Text = "", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, fab)
	local lg = Logo(fbody, 52)
	lg.AnchorPoint, lg.Position = Vector2.new(.5, .5), UDim2.fromScale(.5, .5)
	local fhover = new("UIScale", {}, fbody)
	fbody.MouseEnter:Connect(function() tw(fhover, { Scale = 1.06 }) end)
	fbody.MouseLeave:Connect(function() tw(fhover, { Scale = 1 }) end)
	self._fab, self._fabScale = fab, fabScale
	self:_pulseUpdate()

	local fdrag, fmoved, fS, fO = false, false, Vector2.zero, Vector2.zero
	fbody.InputBegan:Connect(function(i)
		if isPress(i) then
			fdrag, fmoved, fS, fO = true, false, Vector2.new(i.Position.X, i.Position.Y), self.fabPos
			tw(fhover, { Scale = .94 }, TweenInfo.new(.1))
		end
	end)
	self._conns[#self._conns + 1] = UIS.InputChanged:Connect(function(i)
		if fdrag and isMove(i) then
			local d = Vector2.new(i.Position.X, i.Position.Y) - fS
			if d.Magnitude > 6 then fmoved = true end
			if fmoved then
				local vp = camera.ViewportSize
				self.fabPos = Vector2.new(math.clamp(fO.X + d.X, 26, vp.X - 26), math.clamp(fO.Y + d.Y, 26, vp.Y - 26))
				fab.Position = UDim2.fromOffset(self.fabPos.X, self.fabPos.Y)
			end
		end
	end)
	self._conns[#self._conns + 1] = UIS.InputEnded:Connect(function(i)
		if fdrag and isPress(i) then
			fdrag = false
			tw(fhover, { Scale = 1 })
			if fmoved then
				self:_save()
			else
				self:SetVisible(true)
			end
		end
	end)

	----------------------------------------------------------------
	-- Responsive
	----------------------------------------------------------------
	-- ลิ้นชักเมนู (จอแคบ): ไซด์บาร์เลื่อนเข้า/ออกทับเนื้อหา มีฉากมืดด้านหลัง
	local DRAWER_W = 236
	local veil = new("TextButton", {
		AutoButtonColor = false, Text = "", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 25, Visible = false,
	}, main)
	round(veil, R.window)
	self._drawerOpen = false
	local function setDrawer(open)
		open = open and self.compact
		self._drawerOpen = open
		self._drawerId = (self._drawerId or 0) + 1
		local id = self._drawerId
		if open then
			sidebar.Visible, veil.Visible = true, true
			task.defer(function() self:_moveIndicator(false) end)
			tw(sidebar, { Position = UDim2.fromOffset(0, 0) }, TweenInfo.new(.3, Enum.EasingStyle.Quint))
			tw(veil, { BackgroundTransparency = .45 }, TweenInfo.new(.25))
		else
			tw(sidebar, { Position = UDim2.fromOffset(-DRAWER_W - 8, 0) }, TweenInfo.new(.26, Enum.EasingStyle.Quint, Enum.EasingDirection.In))
			tw(veil, { BackgroundTransparency = 1 }, TweenInfo.new(.2))
			task.delay(.28, function()
				if id == self._drawerId and self.compact then sidebar.Visible, veil.Visible = false, false end
			end)
		end
	end
	self._setDrawer = setDrawer
	menuB.MouseButton1Click:Connect(function() setDrawer(not self._drawerOpen) end)
	veil.MouseButton1Click:Connect(function() setDrawer(false) end)

	local function layout()
		local vp = camera.ViewportSize
		local k = math.max(self.userScale, .01)
		local availW, availH = (vp.X - 12) / k, (vp.Y - 12) / k
		local compact = availW < 640 -- กว้างจริงน้อยกว่า 640px = ใช้เลย์เอาต์จอแคบ (ลิ้นชัก + การ์ดเรียงต่อกัน)
		self.compact = compact
		-- ขนาดหน้าต่างต้องเป็นพิกเซลเต็มคู่ (หลังคูณ UIScale) ไม่งั้นตัวอักษรและเส้นจะเบลอครึ่งพิกเซล
		local function snap(v) return math.floor(v * k / 2 + .5) * 2 / k end
		local w, h
		if compact then
			w, h = math.clamp(availW - 6, 280, 820), math.clamp(availH - 6, 240, 680)
		elseif self._userSize then
			w = math.clamp(self._userSize.X, MIN_WIN_W, math.max(MIN_WIN_W, availW))
			h = math.clamp(self._userSize.Y, MIN_WIN_H, math.max(MIN_WIN_H, availH))
		elseif TOUCH then
			w, h = math.min(TOUCH_W, availW), math.min(TOUCH_H, availH)
		else
			w, h = math.clamp(availW - 12, 300, 820), math.clamp(availH - 12, 260, 500)
		end
		main.Size = UDim2.fromOffset(snap(w), snap(h))

		-- ไซด์บาร์ภายในเหมือนกันทุกโหมด (ในจอแคบเป็นลิ้นชัก)
		sideFill.Size, sideFill.Position = UDim2.new(0, 40, 1, 0), UDim2.new(1, -40, 0, 0)
		brand.Size = UDim2.new(1, 0, 0, 64)
		tabsHost.Position, tabsHost.Size = UDim2.fromOffset(8, 68), UDim2.new(1, -16, 1, -68 - 70)
		prof.Visible = opts.Profile ~= false
		tabsF.AutomaticCanvasSize, tabsF.ScrollingDirection = Enum.AutomaticSize.Y, Enum.ScrollingDirection.Y
		tabList.FillDirection = Enum.FillDirection.Vertical
		if compact then
			sidebar.ZIndex = 30
			sidebar.Size = UDim2.new(0, DRAWER_W, 1, 0)
			if not self._drawerOpen then
				sidebar.Position, sidebar.Visible, veil.Visible = UDim2.fromOffset(-DRAWER_W - 8, 0), false, false
			end
			content.Position, content.Size = UDim2.fromOffset(0, 0), UDim2.fromScale(1, 1)
			header.Size = UDim2.new(1, 0, 0, 54)
			pages.Position, pages.Size = UDim2.fromOffset(0, 54), UDim2.new(1, 0, 1, -54)
			sbox.Size = UDim2.fromOffset(132, 36)
			ttl.Size = UDim2.new(1, -(54 + 132 + 64), 1, 0)
			tl.HorizontalAlignment = Enum.HorizontalAlignment.Center
			toasts.AnchorPoint, toasts.Position = Vector2.new(.5, 1), UDim2.new(.5, 0, 1, -16)
		else
			if self._drawerOpen then self._drawerOpen = false end
			sidebar.ZIndex = 1
			sidebar.Visible, veil.Visible = true, false
			sidebar.Position, sidebar.Size = UDim2.fromOffset(0, 0), UDim2.new(0, SIDE_W, 1, 0)
			content.Position, content.Size = UDim2.fromOffset(SIDE_W, 0), UDim2.new(1, -SIDE_W, 1, 0)
			header.Size = UDim2.new(1, 0, 0, HEADER_H)
			pages.Position, pages.Size = UDim2.fromOffset(0, HEADER_H), UDim2.new(1, 0, 1, -HEADER_H)
			sbox.Size = UDim2.fromOffset(190, 36)
			ttl.Size = UDim2.new(1, -(52 + 190 + 64), 1, 0)
			tl.HorizontalAlignment = Enum.HorizontalAlignment.Right
			toasts.AnchorPoint, toasts.Position = Vector2.new(1, 1), UDim2.new(1, -16, 1, -16)
		end
		menuB.Visible = compact
		hIcon.Visible = not compact
		hIcon.Position = UDim2.new(0, 20, .5, 0)
		ttl.Position = compact and UDim2.fromOffset(54, 0) or UDim2.fromOffset(52, 0)
		ttl.TextSize = (compact and 18 or 22) + self:_boost()
		tabsF.CanvasSize = UDim2.new()
		for _, t in ipairs(self.tabs) do
			t.btn.AutomaticSize = Enum.AutomaticSize.None
			t.btn.Size = UDim2.new(1, 0, 0, ROW + 2)
			t.applyMode(compact)
		end
		task.defer(function() RunService.Heartbeat:Wait() self:_moveIndicator(false) end)
	end
	self._layout = layout
	layout()
	self._conns[#self._conns + 1] = camera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)
	self._conns[#self._conns + 1] = tabsF:GetPropertyChangedSignal("CanvasPosition"):Connect(function() self:_moveIndicator(false) end)

	self._conns[#self._conns + 1] = UIS.InputBegan:Connect(function(i, gp)
		if not gp and not self._capturing and i.KeyCode == self.toggleKey then self:SetVisible(not self.visible) end
	end)

	phS()
	for _, h in ipairs(self._hooks) do h() end
	self:SetVisible(true)
	self._booted = true
	return self
end

-- กรองฟังก์ชันของแท็บปัจจุบันตามช่องค้นหา
function RVX:_applySearch()
	local rec = self.current
	if not rec or not rec.tab then return end
	local q = string.lower(self._search.Text)
	for _, sec in ipairs(rec.tab.secs) do
		local secMatch = (q == "") or (string.find(sec.keys, q, 1, true) ~= nil)
		local any = false
		for _, r in ipairs(sec.rows) do
			local show = secMatch or (string.find(r.keys, q, 1, true) ~= nil)
			r.frame.Visible = show
			if show then any = true end
		end
		sec.card.Visible = any or secMatch
	end
end

function RVX:_moveIndicator(anim)
	local t = self.current
	if not t then return end
	local ind, side = self._indicator, self._side
	local k = self:_k()
	local p = (t.btn.AbsolutePosition - side.AbsolutePosition) / k
	local s = t.btn.AbsoluteSize / k
	local props = { Position = UDim2.fromOffset(p.X, p.Y), Size = UDim2.fromOffset(s.X, s.Y) }
	if anim then tw(ind, props, TweenInfo.new(.38, Enum.EasingStyle.Quint)) else ind.Position, ind.Size = props.Position, props.Size end
end

function RVX:SetLanguage(l)
	self.lang = l
	self:_applyFonts() -- น้ำหนักฟอนต์ไทย/อังกฤษต่างกัน ต้องอัปเดตทุกข้อความ
	for _, h in ipairs(self._hooks) do h() end
	self:_save()
	task.defer(function() RunService.Heartbeat:Wait() self:_moveIndicator(false) end)
end
function RVX:SetAccent(name)
	if not ACCENTS[name] then return end
	self.accentName, self.accent = name, ACCENTS[name]
	for _, h in ipairs(self._acc) do h(self.accent) end
	self:_save()
end
function RVX:SetAccentColor(c)
	self.accentName, self.accent = "Custom", c
	for _, h in ipairs(self._acc) do h(c) end
	self:_save()
end
-- ใส่ฟอนต์ที่เลือกกับทุกข้อความที่มีอยู่ (ตัวหนา = น้ำหนัก >= SemiBold)
function RVX:_applyFonts()
	setFonts(self.fontName, self.lang)
	for _, d in ipairs(self.Gui:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
			d.FontFace = (d.FontFace.Weight.Value >= 600) and FONT_B or FONT
		end
	end
end
function RVX:SetFont(name)
	if not FONT_FAMILIES[name] then return end
	self.fontName = name
	self:_applyFonts()
	self:_save()
end

-- สลับธีม Dark/Light: แก้พาเลตต์ แล้วแมปสีเดิม→สีใหม่ให้ทุก Instance ที่ใช้สีพาเลตต์อยู่
local COLOR_PROPS = { "BackgroundColor3", "TextColor3", "PlaceholderColor3", "ScrollBarImageColor3" }
function RVX:SetTheme(name)
	if not THEMES[name] or self.themeName == name then return end
	local old = {}
	for k, v in pairs(C) do old[k] = v end
	setPalette(name)
	self.themeName = name
	local map = {}
	for k, ov in pairs(old) do
		if not THEME_SKIP[k] and C[k] ~= ov then map[ov:ToHex()] = C[k] end
	end
	for _, d in ipairs(self.Gui:GetDescendants()) do
		if d:IsA("UIStroke") then
			if d.Name == "Glass" then
				d.Color = C.stroke
			else
				local n = map[d.Color:ToHex()]
				if n then d.Color = n end
			end
		elseif d:IsA("GuiObject") then
			for _, p in ipairs(COLOR_PROPS) do
				local ok, c = pcall(function() return d[p] end)
				if ok and typeof(c) == "Color3" then
					local n = map[c:ToHex()]
					if n then d[p] = n end
				end
			end
		end
	end
	if self._bgGrad then self._bgGrad.Color = ColorSequence.new(C.win1, C.win2) end
	if self._paintTitle then self._paintTitle() end
	self:_save()
end

function RVX:SetMapName(v)
	local lbl = self._mapLbl
	if not lbl then return end
	lbl.Text = v and tostring(v) or ""
	lbl.Visible = lbl.Text ~= ""
end

-- โลโก้บินเข้าไปที่มุมซ้ายบนของ UI (เรียกต่อจากหน้าจอโหลด)
-- fromCenter = Vector2 ตำแหน่งกึ่งกลางโลโก้บนหน้าจอโหลด (พิกเซล), fromPx = ขนาดโลโก้ตอนนั้น
function RVX:FlyInLogo(fromCenter, fromPx)
	local lg = self._brandLogo
	if not (lg and fromCenter) then return end
	local vp = self.Gui.AbsoluteSize
	local s = self.userScale
	local sz = self._main.Size
	local home = self._home()
	local left = vp.X * .5 + home.X.Offset - sz.X.Offset * s / 2
	local top = vp.Y * .5 + home.Y.Offset - sz.Y.Offset * s / 2
	local tc = Vector2.new(left + 35 * s, top + (self.compact and 26 or 32) * s)
	lg.Visible = false
	local fly = Logo(self.Gui, fromPx or 120)
	fly.AnchorPoint = Vector2.new(.5, .5)
	fly.Position = UDim2.fromOffset(fromCenter.X, fromCenter.Y)
	fly.ZIndex = 60
	local t = tw(fly, {
		Position = UDim2.fromOffset(tc.X, tc.Y), Size = UDim2.fromOffset(38 * s, 38 * s),
	}, TweenInfo.new(.7, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut))
	t.Completed:Connect(function()
		lg.Visible = true
		fly:Destroy()
	end)
end

function RVX:SetOpacity(o)
	self.userOpacity = math.clamp(o, .4, 1)
	self:_applyOpacity()
	self:_save()
end
function RVX:_applyOpacity()
	local t = 1 - (self.userOpacity or 1)
	for _, f in ipairs(self._opaque or {}) do
		tw(f, { BackgroundTransparency = t }, TweenInfo.new(.12))
	end
end
-- รีเซ็ตค่าตั้งค่าของ UI ทั้งหมดกลับเป็นค่าเริ่มต้น (ภาษา สี ขนาด ความโปร่งใส ปุ่มเปิด/ปิด + ล้างค่า Flag ที่บันทึกไว้)
function RVX:ResetSettings(refs)
	refs = refs or {}
	self._data, self._saved = {}, {}
	self._userSize = nil
	if self._layout then pcall(self._layout) end
	self:SetAccent("Violet")
	self:SetLanguage("th")
	if refs.font then pcall(refs.font.Set, refs.font, "Gotham") else self:SetFont("Gotham") end
	if refs.theme then pcall(refs.theme.Set, refs.theme, "Dark") else self:SetTheme("Dark") end
	if refs.lang then pcall(refs.lang.Set, refs.lang, "ไทย") end
	local defS = defaultScale()
	if refs.scale then pcall(refs.scale.Set, refs.scale, math.floor(defS * 100 + .5)) else self:SetScale(defS) end
	if refs.opacity then pcall(refs.opacity.Set, refs.opacity, 15) else self:SetOpacity(.85) end
	local k = self._defaultKey or Enum.KeyCode.RightShift
	self.toggleKey = k
	if refs.key and refs.key.Set then pcall(refs.key.Set, refs.key, k) end
	self:_save()
	self:Notify({
		Type = "success",
		Title = { en = "Settings reset", th = "รีเซ็ตแล้ว" },
		Text = { en = "All UI settings are back to default.", th = "ค่าตั้งค่า UI ทั้งหมดกลับเป็นค่าเริ่มต้นแล้ว" },
	})
end
function RVX:SetScale(s)
	self.userScale = s
	tw(self._scale, { Scale = s })
	if TOUCH and self._layout then task.defer(function() pcall(self._layout) end) end
	self:_save()
end

-- เปิด: หน้าต่างขยายออกมาจากตำแหน่งปุ่มโลโก้ / ปิด: หดกลับเข้าปุ่มแล้วปุ่มเด้งขึ้นมา
function RVX:SetVisible(v)
	self.visible = v
	self._anim = (self._anim or 0) + 1
	local id = self._anim
	local main, fab = self._main, self._fab
	local fp = self.fabPos
	local fabPos = UDim2.fromOffset(fp.X, fp.Y)
	local MINI = .06
	if v then
		tw(self._fabScale, { Scale = 0 }, TweenInfo.new(.16, Enum.EasingStyle.Quint))
		task.delay(.16, function() if id == self._anim then fab.Visible = false end end)
		if not main.Visible or not self._booted then
			if self._booted then
				main.Position = fabPos
				self._scale.Scale = self.userScale * MINI
			else
				self._scale.Scale = self.userScale * .94 -- เปิดครั้งแรกตอนสคริปต์เริ่ม: ขยาย 0.94 → 1 พร้อมค่อยๆ ชัดขึ้นที่กลางจอ
			end
			self:_applyOpacity()
		end
		main.Visible = true
		tw(main, { Position = self._home() }, TweenInfo.new(.46, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
		tw(self._scale, { Scale = self.userScale }, TweenInfo.new(.46, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
		task.delay(.5, function() if id == self._anim then self:_moveIndicator(false) end end)
	else
		local info = TweenInfo.new(.34, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		tw(main, { Position = fabPos }, info)
		tw(self._scale, { Scale = self.userScale * MINI }, info)
		task.delay(.26, function()
			if id ~= self._anim then return end
			fab.Visible = true
			self._fabScale.Scale = 0
			tw(self._fabScale, { Scale = 1 }, TweenInfo.new(.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
		end)
		task.delay(.36, function() if id == self._anim then main.Visible = false end end)
	end
end

-- อนิเมชันเข้าหน้าใหม่: เฟดจากม่าน + การ์ดไล่ขึ้นมาทีละใบ
function RVX:_playEnter(rec)
	local veil = self._veil
	if veil then
		veil.BackgroundColor3 = C.win2
		veil.Visible = true
		veil.BackgroundTransparency = .4
		local t = tw(veil, { BackgroundTransparency = 1 }, TweenInfo.new(.4, Enum.EasingStyle.Quad))
		t.Completed:Connect(function() if veil.BackgroundTransparency >= .99 then veil.Visible = false end end)
	end
	if rec.tab then
		for i, sec in ipairs(rec.tab.secs) do
			local sc = sec.cardScale
			if sc then
				sc.Scale = .94
				task.delay((i - 1) * .05, function()
					if not self._destroyed then tw(sc, { Scale = 1 }, TweenInfo.new(.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)) end
				end)
			end
		end
	end
end

-- หัวข้อกลุ่มในไซด์บาร์ (เรียกก่อนสร้างแท็บของกลุ่มนั้น): ui:Group({ en = "Features", th = "ฟีเจอร์" })
function RVX:_tabOrder() self._tabOrd = (self._tabOrd or 0) + 1 return self._tabOrd end
function RVX:Group(name)
	local f = new("TextLabel", {
		BackgroundTransparency = 1, TextColor3 = C.sub, TextTransparency = .15, FontFace = FONT_B,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom,
		Size = UDim2.new(1, 0, 0, 26), LayoutOrder = self:_tabOrder(),
	}, self._tabsF)
	pad(f, 16, 0, 8, 4)
	self:_bind(f, name, 10)
	return f
end

function RVX:Select(tab)
	local prev = self.current
	self.current = tab
	for _, t in ipairs(self.tabs) do
		local on = t == tab
		tw(t.lbl, { TextColor3 = on and C.text or C.sub })
		t.setc(on and self.accent or C.sub)
		if on then
			tw(t.btn, { BackgroundTransparency = 1 })
			if prev ~= t then
				t.group.Position = UDim2.fromOffset(0, 14)
				t.group.Visible = true
				tw(t.group, { Position = UDim2.fromOffset(0, 0) }, TweenInfo.new(.42, Enum.EasingStyle.Quint))
				self:_playEnter(t)
			end
		else
			t.group.Visible = false
		end
	end
	-- หัวข้อ + ไอคอนของหน้า
	self._titleSrc = tab.name
	self._ttl.Text = self:T(tab.name)
	for _, c in ipairs(self._hIcon:GetChildren()) do c:Destroy() end
	local _, hset = Icon(tab.icon or "file", self._hIcon, 22, self.accent)
	self._hSetc = hset
	if self.compact and self._setDrawer then self._setDrawer(false) end
	-- รีเซ็ตช่องค้นหาเมื่อเปลี่ยนหน้า
	if self._search.Text ~= "" then self._search.Text = "" else self:_applySearch() end
	self:_moveIndicator(prev ~= nil)
end

function RVX:Tab(name, icon)
	local btn = new("TextButton", {
		AutoButtonColor = false, Text = "", BackgroundColor3 = C.hover, BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, ROW + 2), LayoutOrder = self:_tabOrder(),
	}, self._tabsF)
	round(btn, R.item)
	pressFx(btn, .975)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder,
	}, btn)
	pad(btn, 14, 0, 14, 0)
	local ic, setc = Icon(icon or "file", btn, 17, C.sub)
	ic.LayoutOrder = 1
	local lbl = new("TextLabel", {
		BackgroundTransparency = 1, TextColor3 = C.sub, FontFace = FONT, LayoutOrder = 2,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20),
	}, btn)
	self:_bind(lbl, name, 14)

	local group = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, self._pages)
	local page = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 1),
	}, group)
	local inner = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, page)
	pad(inner, 14, 6, 16, 18)
	local cols = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, inner)
	local colsList = new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, cols)
	local colFrames, holders, colPads = {}, {}, {}
	for i = 1, 2 do
		local c = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i }, cols)
		new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, c)
		colPads[i] = new("UIPadding", {}, c)
		colFrames[i] = c
		-- [SCROLL-SPLIT] จอกว้าง: แต่ละฝั่งอยู่ในกรอบเลื่อนของตัวเอง เลื่อนแยกกันได้ / มือถือ: ถอดออกมาเรียงต่อกันแล้วเลื่อนทั้งหน้าเหมือนเดิม
		holders[i] = new("ScrollingFrame", {
			BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0, Visible = false,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
			Size = UDim2.new(.5, -6, 1, 0), LayoutOrder = i,
		}, cols)
	end

	local rec
	-- ตัวแทน page: สลิดเดอร์/ตัวเลือกสีสั่งล็อกการเลื่อนระหว่างลาก ต้องล็อกทุกกรอบที่เลื่อนได้ในโหมดปัจจุบัน
	local pageProxy = setmetatable({}, {
		__index = function(_, k) return page[k] end,
		__newindex = function(_, k, v)
			if k == "ScrollingEnabled" then
				local wide = rec and rec.wide
				page.ScrollingEnabled = v and not wide
				for _, h in ipairs(holders) do h.ScrollingEnabled = v and wide or false end
			else
				page[k] = v
			end
		end,
	})
	local tab = setmetatable({ win = self, cols = colFrames, page = pageProxy, count = 0, secs = {} }, Tab)
	rec = { btn = btn, lbl = lbl, setc = setc, group = group, colsList = colsList, colFrames = colFrames, name = name, icon = icon, tab = tab }
	rec.applyMode = function(compact)
		rec.wide = not compact
		page.ScrollingEnabled = compact
		page.AutomaticCanvasSize = compact and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
		if not compact then page.CanvasSize = UDim2.new() end
		inner.AutomaticSize = compact and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
		inner.Size = compact and UDim2.new(1, 0, 0, 0) or UDim2.new(1, 0, 1, 0)
		cols.AutomaticSize = compact and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
		cols.Size = compact and UDim2.new(1, 0, 0, 0) or UDim2.new(1, 0, 1, 0)
		colsList.FillDirection = compact and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal
		for i = 1, 2 do
			holders[i].Visible = not compact
			holders[i].ScrollingEnabled = not compact
			colFrames[i].Parent = compact and cols or holders[i]
			colPads[i].PaddingBottom = UDim.new(0, compact and 0 or 16)
		end
	end
	tab.rec = rec
	self.tabs[#self.tabs + 1] = rec
	btn.MouseEnter:Connect(function() if self.current ~= rec then tw(lbl, { TextColor3 = C.text }) tw(btn, { BackgroundTransparency = .72 }) end end)
	btn.MouseLeave:Connect(function() if self.current ~= rec then tw(lbl, { TextColor3 = C.sub }) end tw(btn, { BackgroundTransparency = 1 }) end)
	btn.MouseButton1Click:Connect(function() if self.current ~= rec then self:Select(rec) end end)
	self._layout()
	if #self.tabs == 1 then self:Select(rec) end
	return tab
end

function RVX:Notify(o)
	local vp = camera.ViewportSize
	local kind = o.Type or "info"
	local dur = o.Duration or 3.5
	local col = kind == "success" and Color3.fromRGB(48, 209, 162)
		or kind == "error" and Color3.fromRGB(255, 95, 125)
		or kind == "warn" and Color3.fromRGB(255, 184, 0)
		or self.accent
	local W = math.min(290, vp.X - 32)
	-- slot = ช่องที่ UIListLayout จัดตำแหน่ง / card = กล่องจริงที่เลื่อนเข้า-ออกอิสระในช่องนั้น
	local slot = new("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.fromOffset(W, 0), LayoutOrder = math.floor(os.clock() * 1000),
	}, self._toasts)
	local HOME, AWAY_R = UDim2.fromOffset(0, 0), UDim2.fromOffset(W + 40, 0)
	local AWAY = self.compact and UDim2.fromOffset(0, 90) or AWAY_R -- จอแคบ: เลื่อนขึ้นจากด้านล่าง / จอกว้าง: เลื่อนเข้าจากขวา
	local card = new("Frame", {
		BackgroundColor3 = C.raised, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0), Position = AWAY, Active = true,
	}, slot)
	round(card, R.card)
	glass(card)
	pad(card, 14, 13, 16, 12)
	new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, card)
	local rowF = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, card)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, rowF)
	-- ไอคอนในวงกลมสีอ่อนของสถานะ
	local badge = new("Frame", {
		BackgroundColor3 = col, BackgroundTransparency = .82, BorderSizePixel = 0, Size = UDim2.fromOffset(30, 30), LayoutOrder = 1,
	}, rowF)
	circle(badge)
	local ic = Icon(kind == "success" and "check" or kind == "error" and "close" or "info", badge, 16, col)
	ic.AnchorPoint, ic.Position = Vector2.new(.5, .5), UDim2.fromScale(.5, .5)
	local col2 = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -42, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, rowF)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, col2)
	local b = self:_boost()
	new("TextLabel", {
		BackgroundTransparency = 1, Text = self:T(o.Title or ""), TextSize = 14 + b, TextColor3 = C.text, FontFace = FONT_B, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1,
	}, col2)
	if o.Text then
		new("TextLabel", {
			BackgroundTransparency = 1, Text = self:T(o.Text), TextSize = 13 + b, TextColor3 = C.sub, FontFace = FONT, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
		}, col2)
	end
	local barBg = new("Frame", { BackgroundColor3 = C.hover, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 3), LayoutOrder = 2 }, card)
	circle(barBg)
	local barF = new("Frame", { BackgroundColor3 = col, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, barBg)
	circle(barF)
	tw(barF, { Size = UDim2.fromScale(0, 1) }, TweenInfo.new(dur, Enum.EasingStyle.Linear))

	local gone, dragging, moved, dragX = false, false, false, 0
	local conns = {}
	local enter = tw(card, { Position = HOME }, TweenInfo.new(.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
	local function dismiss(swiped)
		if gone then return end
		gone = true
		for _, c in ipairs(conns) do c:Disconnect() end
		tw(card, { Position = swiped and AWAY_R or AWAY }, TweenInfo.new(.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In))
		task.delay(.34, function() slot:Destroy() end)
	end

	-- ปัดไปทางขวาเพื่อปิด (นิ้วบนมือถือ / ลากเมาส์บนเดสก์ท็อป) ปล่อยก่อนถึงครึ่งทางจะเด้งกลับ
	card.InputBegan:Connect(function(i)
		if isPress(i) and not gone then
			dragging, moved, dragX = true, false, i.Position.X
			enter:Cancel()
		end
	end)
	conns[#conns + 1] = UIS.InputChanged:Connect(function(i)
		if dragging and isMove(i) then
			local dx = math.max(i.Position.X - dragX, -16)
			if math.abs(dx) > 4 then moved = true end
			card.Position = UDim2.fromOffset(dx, 0)
		end
	end)
	conns[#conns + 1] = UIS.InputEnded:Connect(function(i)
		if dragging and isPress(i) then
			dragging = false
			if moved and card.Position.X.Offset > W * .3 then
				dismiss(true)
			else
				enter = tw(card, { Position = HOME }, TweenInfo.new(.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
			end
		end
	end)
	task.delay(dur, function()
		while dragging and not gone do task.wait(.1) end
		dismiss(false)
	end)
end

-- กล่องยืนยัน: ไอคอนในวงกลมสี / ตัวอักษรใหญ่ขึ้น / Esc = ยกเลิก, Enter = ยืนยัน / ฉากหลังมืด+เบลอ
function RVX:Dialog(o)
	local vp = camera.ViewportSize
	local danger = o.Danger == true
	local tone = danger and Color3.fromRGB(255, 95, 125) or self.accent
	local overlay = new("TextButton", {
		AutoButtonColor = false, Text = "", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 50,
	}, self.Gui)
	-- เบลอฉากเกมด้านหลัง (ถ้าสร้างไม่ได้ก็ข้าม ใช้แค่ฉากมืด)
	local blur
	pcall(function()
		if self._blur then self._blur:Destroy() end
		blur = Instance.new("BlurEffect")
		blur.Name, blur.Size = "RVXBlur", 0
		blur.Parent = game:GetService("Lighting")
		self._blur = blur
		tw(blur, { Size = 10 }, TweenInfo.new(.25))
	end)
	local card = new("Frame", {
		AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), BackgroundColor3 = C.card, BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromOffset(math.min(360, vp.X - 40), 0), Active = true,
	}, overlay)
	round(card, R.card + 4)
	glass(card)
	local sc = new("UIScale", { Scale = .92 }, card)
	pad(card, 24, 24, 24, 20)
	new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, card)
	local b = self:_boost()
	-- ไอคอนในวงกลมสีอ่อน (สีแดงถ้าเป็นการกระทำอันตราย)
	local iconBg = new("Frame", {
		BackgroundColor3 = tone, BackgroundTransparency = .82, BorderSizePixel = 0, Size = UDim2.fromOffset(44, 44), LayoutOrder = 0,
	}, card)
	circle(iconBg)
	local dic = Icon(o.Icon or "info", iconBg, 22, tone)
	dic.AnchorPoint, dic.Position = Vector2.new(.5, .5), UDim2.fromScale(.5, .5)
	new("TextLabel", {
		BackgroundTransparency = 1, Text = self:T(o.Title or ""), TextSize = 20 + b, TextColor3 = C.text, FontFace = FONT_B, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1,
	}, card)
	if o.Text then
		new("TextLabel", {
			BackgroundTransparency = 1, Text = self:T(o.Text), TextSize = 15 + b, TextColor3 = C.sub, FontFace = FONT, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
		}, card)
	end
	new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 6), LayoutOrder = 3 }, card)
	local btnRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, ROW + 6), LayoutOrder = 4 }, card)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, btnRow)

	local closed, keyConn = false, nil
	local function close(confirmed)
		if closed then return end
		closed = true
		if keyConn then keyConn:Disconnect() end
		tw(overlay, { BackgroundTransparency = 1 }, TweenInfo.new(.2))
		tw(sc, { Scale = .94 }, TweenInfo.new(.2))
		if blur then
			-- ใช้ Tween เก็บเบลอ (ไม่พึ่ง task.delay เผื่อสคริปต์ถูกปิดทันทีหลังกดยืนยัน)
			local t = tw(blur, { Size = 0 }, TweenInfo.new(.2))
			t.Completed:Connect(function()
				pcall(function() blur:Destroy() end)
				if self._blur == blur then self._blur = nil end
			end)
		end
		task.delay(.25, function() overlay:Destroy() end)
		if confirmed then safe(o.Callback) elseif o.OnCancel then safe(o.OnCancel) end
	end
	local function mkBtn(order, text, bg, over, fg, confirmed)
		local btn = new("TextButton", {
			AutoButtonColor = false, Text = "", BackgroundColor3 = bg, BorderSizePixel = 0,
			Size = UDim2.new(.5, -4, 1, 0), LayoutOrder = order,
		}, btnRow)
		round(btn, R.item)
		local l = new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), TextSize = 15 + b, FontFace = FONT_B, TextColor3 = fg }, btn)
		l.Text = self:T(text)
		btn.MouseEnter:Connect(function() tw(btn, { BackgroundColor3 = over }) end)
		btn.MouseLeave:Connect(function() tw(btn, { BackgroundColor3 = bg }) end)
		btn.MouseButton1Click:Connect(function() close(confirmed) end)
	end
	local okCol = tone
	mkBtn(1, o.Cancel or { en = "Cancel", th = "ยกเลิก" }, C.raised, C.hover, C.text, false)
	mkBtn(2, o.Confirm or { en = "Confirm", th = "ยืนยัน" }, okCol, okCol:Lerp(Color3.new(1, 1, 1), .12), onC(okCol), true)
	overlay.MouseButton1Click:Connect(function() close(false) end)
	-- คีย์บอร์ด: Esc = ยกเลิก, Enter = ยืนยัน (ไม่เช็ก gameProcessed เพราะ Esc ถูกเกมดักไว้)
	keyConn = UIS.InputBegan:Connect(function(i)
		if closed then return end
		if i.KeyCode == Enum.KeyCode.Escape then
			close(false)
		elseif i.KeyCode == Enum.KeyCode.Return or i.KeyCode == Enum.KeyCode.KeypadEnter then
			close(true)
		end
	end)

	tw(overlay, { BackgroundTransparency = .4 }, TweenInfo.new(.25))
	tw(sc, { Scale = 1 }, SOFT)
end

return RVX
