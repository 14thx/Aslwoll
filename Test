local function AddManagedToggle(container, opts)
    local handle = { Value = opts.Value == true, Element = nil }
    local callbackCount = 0
    handle.Element = container:AddToggle({
        Title = opts.Title,
        Description = opts.Description or opts.Desc,
        Default = handle.Value,
        Callback = function(value)
            callbackCount = callbackCount + 1
            handle.Value = value == true
            if opts.Callback then opts.Callback(handle.Value) end
        end,
    })
    function handle:SetValue(value)
        value = value == true
        if self.Value == value then return end
        local before = callbackCount
        if self.Element and self.Element.Set then
            pcall(function() self.Element:Set(value) end)
        end
        if callbackCount == before then
            self.Value = value
            if opts.Callback then opts.Callback(value) end
        end
    end
    return handle
end

