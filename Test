            if spawnFolder then
                local part = spawnFolder:FindFirstChild("Prompt") or spawnFolder:FindFirstChildWhichIsA("BasePart", true)
                local pos = part and (part:IsA("BasePart") and part.Position or (part:IsA("Attachment") and part.WorldPosition))
