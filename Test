pcall(function()
    local lp = Players.LocalPlayer
    if not lp then return end

    local function mk(fn) return (newcclosure and newcclosure(fn)) or fn end

    local BAD = {
        kick = true, kickplayer = true, removeplayer = true,
        anticheat = true, antifall = true, anti_fall = true, anti_cheat = true,
        detect = true, violat = true, ban = true, exploiter = true,
        cheat = true, hack = true, noclip = true, godmode = true,
    }
    local function hit(s)
        if type(s) ~= "string" then return false end
        s = string.lower(s)
        for k in pairs(BAD) do
            if string.find(s, k, 1, true) then return true end
        end
        return false
    end
    local function scan(v, d)
        if d > 3 then return false end
        if type(v) == "string" then return hit(v) end
        if type(v) == "table" then
            for k, x in pairs(v) do
                if hit(tostring(k)) or scan(x, d + 1) then return true end
            end
        end
        return false
    end

    if hookmetamethod and getnamecallmethod then
        local oldNm
        oldNm = hookmetamethod(game, "__namecall", mk(function(self, ...)
            local m = getnamecallmethod()
            local args = {...}
            if (m == "Kick" or m == "kick") and (self == lp or self == Players) then
                warn("🛡️ [EASY HUB V2] Blocked Kick:", tostring(args[1]))
                return nil
            end
            if (m == "Destroy" or m == "Remove") and (self == lp or self == lp.Character) then
                warn("🛡️ [EASY HUB V2] Blocked Destroy/Remove on LocalPlayer")
                return nil
            end
            if m == "FireServer" or m == "InvokeServer" then
                for _, a in ipairs(args) do
                    if scan(a, 0) then
                        warn("🛡️ [EASY HUB V2] Blocked Remote:", tostring(a))
                        return nil
                    end
                end
            end
            return oldNm(self, ...)
        end))
    end

    if hookfunction and lp.Kick then
        pcall(function()
            hookfunction(lp.Kick, mk(function(self, ...)
                warn("🛡️ [EASY HUB V2] Blocked LocalPlayer:Kick:", tostring((...)))
                return nil
            end))
        end)
    end

    if hookfunction and Players.Kick then
        pcall(function()
            local oldPK = Players.Kick
            hookfunction(oldPK, mk(function(self, ...)
                if self == lp then
                    warn("🛡️ [EASY HUB V2] Blocked Players:Kick")
                    return nil
                end
                return oldPK(self, ...)
            end))
        end)
    end

    if hookfunction and lp.WaitForChild then
        pcall(function()
            local oldWFC = lp.WaitForChild
            hookfunction(oldWFC, mk(function(self, name, timeout, ...)
                if timeout and timeout > 0 and (self == lp or self == lp.Character) then
                    timeout = math.huge
                end
                return oldWFC(self, name, timeout, ...)
            end))
        end)
    end

    local function Neutralize(char)
        if not char or not char.Parent then return end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") then
                local nm = string.lower(d.Name)
                if nm:find("antifall") or nm:find("anti_fall") or nm:find("fall")
                    or nm:find("ragdoll") or nm:find("anti") or nm:find("detect")
                    or nm:find("cheat") or nm:find("kick") then
                    pcall(function() d.Disabled = true end)
                end
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
            end)
        end
    end

    local function watch(c)
        if not c then return end
        Neutralize(c)
        c.DescendantAdded:Connect(function(d)
            if d:IsA("Script") or d:IsA("LocalScript") then
                local nm = string.lower(d.Name)
                if nm:find("antifall") or nm:find("anti") or nm:find("kick")
                    or nm:find("cheat") or nm:find("detect") then
                    task.defer(function() pcall(function() d.Disabled = true end) end)
                end
            end
        end)
    end
    if lp.Character then watch(lp.Character) end
    lp.CharacterAdded:Connect(watch)

    local function guard(c)
        if not c then return end
        c.AncestryChanged:Connect(function(_, p)
            if not p then
                warn("🛡️ [EASY HUB V2] Character removed → Respawn")
                task.wait(1)
                pcall(function() lp:LoadCharacter() end)
            end
        end)
    end
    if lp.Character then guard(lp.Character) end
    lp.CharacterAdded:Connect(guard)
end)

