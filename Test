FarmToggleControls["IndividualMaster"] = AddManagedToggle(IndividualRunSection, {
    Title = "🚀 เริ่มออโต้ฟาร์ม",
    Value = false,
    Callback = function(val)
        if val then
            local currentCrop = selectedIndividualCrop
            local check = RequestFarmSession("IndividualMaster")
            task.spawn(function()
                local isFirstRun = true
                while check() do
                    local locData = TYPER_LOCATIONS[currentCrop]
                    if not locData then break end
                    if isFirstRun then
                        pcall(function() Notify({ Title = "EASY HUB", Content = "🚗 เริ่มฟาร์ม " .. currentCrop .. ": ไปเบิกรถในเมือง...", Duration = 3.0 }) end)
                        local carInTown = WarpToTownAndSpawnCar()
                        if not carInTown then carInTown = SpawnCarAtBooth(TOWN_CAR_SPAWN) or EnsureCarAvailable(TOWN_CAR_SPAWN) end
                        if carInTown then EnsurePlayerSeatedInCar(carInTown) end
                        isFirstRun = false
                    else
                        local myCar = GetPlayerVehicle()
                        if not myCar then myCar = EnsureCarAvailable(TOWN_CAR_SPAWN) end
                        if myCar then EnsurePlayerSeatedInCar(myCar) end
                    end
                    if not check() then break end
                    pcall(function() Notify({ Title = "EASY HUB", Content = "🌾 ขับไปฟาร์ม " .. currentCrop, Duration = 2.5 }) end)
                    HarvestSingleCrop(currentCrop, 60, check)
                    if not check() then break end
                    pcall(function() Notify({ Title = "EASY HUB", Content = "🚗 ฟาร์มเสร็จ! ไปขายที่ตลาด...", Duration = 3.0 }) end)
                    local carAtFarm = GetNearbyPlayerVehicle(80)
                    if not carAtFarm then
                        SmoothWalkTo(locData.Booth, 25, check, 1.2)
                        carAtFarm = SpawnCarAtBooth(locData.Booth) or EnsureCarAvailable(locData.Booth)
                    end
                    if carAtFarm then EnsurePlayerSeatedInCar(carAtFarm) end
                    SellAtEconomyMarket(check)
                    if not check() then break end
                    task.wait(1.0)
                end
            end)
        else
            StopFarmSession("IndividualMaster")
        end
    end
})

