local Esc = { last = 0, alerted = 0 }

local function PickSafeSpot()
    local cands = {}
    for _, g in ipairs(Static.gens) do
        local gp = PosOf(g)
        if gp then
            cands[#cands + 1] = gp + Vector3.new(4.5, 0, 0)
        end
    end
    for _, s in ipairs(Static.spawns) do
        cands[#cands + 1] = s.Position + Vector3.new(0, 3, 0)
    end
    local gate = Static.gate and PosOf(Static.gate)
    if gate then
        cands[#cands + 1] = gate + Vector3.new(0, 3, 0)
    end
    local best, bestScore
    for _, c in ipairs(cands) do
        local minD
        for _, k in ipairs(State.Killers) do
            if k.root and k.root.Parent then
                local d = Dist(c, k.root.Position)
                if not minD or d < minD then
                    minD = d
                end
            end
        end
        if minD and (not bestScore or minD > bestScore) then
            best, bestScore = c, minD
        end
    end
    return best, bestScore
end

task.spawn(function()
    while Alive() do
        task.wait(0.1)
        if (Config.EscapeEnabled or Config.KillerAlert) and not State.IAmKiller then
            local root, hum = MyRoot(), MyHum()
            if root and hum and hum.Health > 0 then
                local k, d = NearestKiller(root.Position)
                if k and d then
                    if Config.KillerAlert and d <= Config.EscapeRange + 15 and os.clock() - Esc.alerted > 4 then
                        Esc.alerted = os.clock()
                        Toast(string.format("ฆาตกรใกล้แล้ว! %d studs", math.floor(d)), false)
                    end
                    if Config.EscapeEnabled and d <= Config.EscapeRange and os.clock() - Esc.last > Config.EscapeCooldown then
                        local spot, score = PickSafeSpot()
                        if spot and score and score > d + 20 then
                            Esc.last = os.clock()
                            State.EscapeUntil = os.clock() + 2.5
                            TPTo(spot)
                            Toast("วาปหนีฆาตกรแล้ว", true)
                        end
                    end
                end
            end
        end
    end
end)

