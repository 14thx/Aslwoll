                        if not check() then break end
                    end
                    CraftFoodAtStation("KangSom", check)
                    if not check() then break end
                    SellAtEconomyMarket(check)
                    if not check() then break end
                    pcall(function() Notify({ Title = "EASY HUB", Content = "🚗 กลับไปเริ่มลูปแกงส้มใหม่...", Duration = 3.0 }) end)
                    local returnCar = GetPlayerVehicle() or EnsureCarAvailable(TOWN_CAR_SPAWN)
                    if returnCar then
                        EnsurePlayerSeatedInCar(returnCar)
                        DriveCarTo(TYPER_LOCATIONS.Tomato.Farm, check)
                    end
                    task.wait(1.0)
                end
            end)
        else
            StopFarmSession("KangSom")
        end
    end
})

