-- AUTO GENERATOR (วาปไปเครื่องปั่นไฟที่ใกล้ที่สุด + ซ่อมอัตโนมัติ)
--------------------------------------------------

local AG = { gen = nil, since = 0, lastRepair = 0, skip = {}, warned = false }

task.spawn(function()
    while Alive() do
        task.wait(0.2)
        if Config.AutoGenEnabled and not State.IAmKiller and os.clock() > State.EscapeUntil then
            local root, hum = MyRoot(), MyHum()
            if root and hum and hum.Health > 0 then
                -- เลือกเครื่องที่ยังไม่เสร็จและใกล้ที่สุด
                local best, bd
                for _, g in ipairs(Static.gens) do
                    local _, done = GenInfo(g)
                    local skipUntil = AG.skip[g]
                    local gp = PosOf(g)
                    if g.Parent and not done and gp and not (skipUntil and skipUntil > os.clock()) then
                        local safe = true
                        if Config.AutoGenSafe > 0 then
                            local _, kd = NearestKiller(gp)
                            if kd and kd < Config.AutoGenSafe then
                                safe = false
                            end
                        end
                        if safe then
                            local d = Dist(gp, root.Position)
                            if not bd or d < bd then
                                best, bd = g, d
                            end
                        end
                    end
                end

                if best then
                    if AG.gen ~= best then
                        AG.gen, AG.since, AG.lastRepair = best, os.clock(), 0
                    end
                    local gp = PosOf(best)
                    if gp and Dist(gp, root.Position) > 9 then
                        local stand = StandPosNear(best, root.Position)
                        if stand then
                            TPTo(stand, gp)
                        end
                    end

                    -- ซ่อม
                    local interval = math.max(0.5, Config.AutoGenInterval)
                    if os.clock() - AG.lastRepair >= interval then
                        AG.lastRepair = os.clock()
                        if Learned.Repair then
                            Replay(Learned.Repair, best)
                        else
                            task.spawn(PressKey, Enum.KeyCode.E, interval * 0.8)
                            if not AG.warned then
                                AG.warned = true
                                Toast("ซ่อมไฟด้วยมือ 1 ครั้งให้สคริปต์เรียนรู้ จะแม่นขึ้น", true)
                            end
                        end
                    end

                    -- ถ้าอยู่นานเกินกำหนด (หา progress ไม่ได้) ข้ามไปเครื่องถัดไป
                    local prog = GenInfo(best)
                    if os.clock() - AG.since > Config.AutoGenMaxSec and not prog then
                        AG.skip[best] = os.clock() + 120
                        AG.gen = nil
                    end
                else
                    AG.gen = nil
                end
            end
        end
    end
end)

