-- 0. ANTI-KICK & ANTI-BAN SHIELD V2 (ปลอดภัย ไม่บล็อก Remote สำคัญ)
-- ==============================================================================
pcall(function()
    local lp = Players.LocalPlayer

    -- รายการคำที่ "ห้าม" ปรากฏในชื่อ method/remote เท่านั้น (ไม่ตรวจ argument ทุกตัว)
    -- ตรวจแบบ plain-text find (ไม่ตีความเป็น Lua pattern)
    local BLOCKED_REMOTE_PATTERNS = {
        "anticheat", "anti_cheat", "antifall", "anti_fall",
        "exploitdetect", "cheatdetect", "speedcheck", "flycheck",
    }

    local function IsBlockedRemoteName(str)
        if type(str) ~= "string" then return false end
        local low = str:lower()
        for _, pat in ipairs(BLOCKED_REMOTE_PATTERNS) do
            if low:find(pat, 1, true) then return true end
        end
        return false
    end

    -- 1. Hook __namecall เพื่อบล็อก Kick และ Remote ตรวจโกง "เฉพาะชื่อ Remote"
    if hookmetamethod then
        local oldNm
        oldNm = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}

            -- บล็อก Kick ของ LocalPlayer / Players service เท่านั้น
            if method == "Kick" and (self == lp or self == Players) then
                local reason = tostring(args[1] or "Unknown")
                warn("🛡️ [EASY HUB ANTI-KICK] บล็อก Kick: " .. reason)
                return nil
            end

            -- บล็อกเฉพาะ Remote ที่ "ชื่อ" สื่อว่าเป็น anticheat (ไม่แตะ argument)
            if method == "FireServer" or method == "InvokeServer" then
                local selfName = (typeof(self) == "Instance") and self.Name or ""
                if IsBlockedRemoteName(selfName) then
                    return nil
                end
                -- ตรวจเฉพาะ argument แรกถ้าเป็น string และยาวไม่เกิน 64 (กันชื่อ item ยาวๆ)
                local a1 = args[1]
                if type(a1) == "string" and #a1 <= 64 and IsBlockedRemoteName(a1) then
                    return nil
                end
            end

            return oldNm(self, ...)
        end))
    end

    -- 2. Hook LocalPlayer:Kick โดยตรง (ถ้าทำได้)
    if hookfunction and lp and lp.Kick then
        local ok = pcall(function()
            hookfunction(lp.Kick, newcclosure(function(self, ...)
                local reason = tostring((...) or "Unknown")
                warn("🛡️ [EASY HUB ANTI-KICK] บล็อก LocalPlayer:Kick: " .. reason)
                return nil
            end))
        end)
        if not ok then
            warn("⚠️ [EASY HUB] hookfunction(lp.Kick) ไม่สำเร็จ — ใช้ __namecall แทน")
        end
    end

    -- 3. ปิดสคริปต์ Antifall/Ragdoll ใน Character (แบบปลอดภัย ไม่ Destroy)
    local function NeutralizeCharScripts(char)
        if not char then return end
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("Script") or desc:IsA("LocalScript") then
                local name = desc.Name:lower()
                if name:find("antifall") or name:find("anti_fall")
                    or name:find("ragdoll") or name:find("antifallscript") then
                    pcall(function() desc.Disabled = true end)
                    -- ไม่ Destroy เพื่อกัน error "Script ไม่มี Parent"
                end
            end
        end
    end
    if lp.Character then NeutralizeCharScripts(lp.Character) end
    lp.CharacterAdded:Connect(NeutralizeCharScripts)

    -- 4. คืนค่า HumanoidState หลัง 5 วินาที (กัน ragdoll ค้างถาวร)
    local function RestoreHumanoidStates(hum)
        if not hum then return end
        task.delay(5, function()
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            end)
        end)
    end
    if lp.Character then
        RestoreHumanoidStates(lp.Character:FindFirstChildOfClass("Humanoid"))
    end
    lp.CharacterAdded:Connect(function(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then RestoreHumanoidStates(hum) end
    end)
end)

