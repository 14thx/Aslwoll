local function TPTo(pos, lookAt)
    local root = MyRoot()
    if not root then
        return
    end
    if lookAt then
        root.CFrame = CFrame.lookAt(pos, Vector3.new(lookAt.X, pos.Y, lookAt.Z))
    else
        root.CFrame = CFrame.new(pos)
    end
    root.AssemblyLinearVelocity = Vector3.zero
end

local function StandPosNear(gen, fromPos)
    local gp = PosOf(gen)
    if not gp then
        return nil
    end
    local flat = Vector3.new(fromPos.X - gp.X, 0, fromPos.Z - gp.Z)
    if flat.Magnitude < 0.1 then
        flat = Vector3.new(1, 0, 0)
    end
    return gp + flat.Unit * 4.5, gp
end

