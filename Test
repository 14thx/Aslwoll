local function KillerReason(plr)
    local team = plr.Team
    if team then
        local tn = string.lower(team.Name)
        if string.find(tn, "killer") then
            return "team:" .. team.Name
        end
        if string.find(tn, "surviv") then
            return nil
        end
    end
    for _, src in ipairs({ plr, plr.Character }) do
        if src then
            for k, v in pairs(src:GetAttributes()) do
                local lk = string.lower(tostring(k))
                local lv = string.lower(tostring(v))
                if string.find(lk, "killer") and v == true then
                    return "attr:" .. tostring(k)
                end
                if (lk == "role" or lk == "team" or lk == "type" or lk == "class") and string.find(lv, "killer") then
                    return "attr:" .. tostring(k) .. "=" .. tostring(v)
                end
                if KillerNames[lv] then
                    return "attr:" .. tostring(k) .. "=" .. tostring(v)
                end
            end
        end
    end
    local ch = plr.Character
    if ch then
        for _, c in ipairs(ch:GetChildren()) do
            if KillerNames[string.lower(c.Name)] then
                return "child:" .. c.Name
            end
        end
    end
    return nil
end

