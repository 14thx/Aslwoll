local function Replay(rec, gen)
    if not (rec and rec.remote and rec.remote.Parent) then
        return false
    end
    local args = table.pack(table.unpack(rec.args, 1, rec.args.n))
    for i = 1, args.n do
        local a = args[i]
        if typeof(a) == "Instance" and gen then
            if a:IsA("Model") then
                args[i] = gen
            elseif a:IsA("BasePart") then
                args[i] = gen:FindFirstChild(a.Name, true) or gen:FindFirstChild("HitBox") or a
            end
        end
    end
    return pcall(function()
        rec.remote:FireServer(table.unpack(args, 1, args.n))
    end)
