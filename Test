-- อ่านความคืบหน้าเครื่องปั่นไฟ (เดาจาก Attribute / Value ชื่อที่พบบ่อย)
local function GenInfo(gen)
    local prog, done
    local function take(k, v)
        local lk = string.lower(tostring(k))
        if type(v) == "number" and (string.find(lk, "progress") or string.find(lk, "percent") or lk == "repair") then
            prog = v
        elseif type(v) == "boolean" and v then
            if string.find(lk, "done") or string.find(lk, "complete") or string.find(lk, "repaired") or lk == "finished" then
                done = true
            end
        end
    end
    for k, v in pairs(gen:GetAttributes()) do
        take(k, v)
    end
    for _, c in ipairs(gen:GetChildren()) do
        if c:IsA("ValueBase") then
            take(c.Name, c.Value)
        end
    end
    if prog and prog > 0 and prog <= 1 then
        prog = prog * 100
    end
    if prog and prog >= 100 then
        done = true
    end
    return prog, done == true
end

