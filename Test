local ESPObjs = {} -- [adornee] = {hl=, bb=, label=}
local COLOR = {
    Killer = Color3.fromRGB(255, 60, 60),
    Survivor = Color3.fromRGB(80, 220, 255),
    Gen = Color3.fromRGB(255, 210, 60),
    GenDone = Color3.fromRGB(90, 235, 120),
    Gate = Color3.fromRGB(255, 150, 50),
    Hook = Color3.fromRGB(230, 90, 230),
    Pallet = Color3.fromRGB(190, 190, 190),
}

local function ESPSet(adornee, color, text, useHighlight)
    local o = ESPObjs[adornee]
    if not o then
        o = {}
        if useHighlight then
            local hl = Instance.new("Highlight")
            hl.Adornee = adornee
            hl.FillTransparency = 0.65
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = ESPRoot
            o.hl = hl
        end
        local bb = Instance.new("BillboardGui")
        bb.Adornee = adornee:IsA("Model") and (adornee.PrimaryPart or adornee:FindFirstChildWhichIsA("BasePart", true)) or adornee
        bb.AlwaysOnTop = true
        bb.Size = UDim2.fromOffset(150, 30)
        bb.StudsOffset = Vector3.new(0, 3.5, 0)
        bb.Parent = ESPRoot
        local lb = Instance.new("TextLabel")
        lb.BackgroundTransparency = 1
        lb.Size = UDim2.fromScale(1, 1)
        lb.Font = Enum.Font.GothamBold
        lb.TextSize = 13
        lb.TextStrokeTransparency = 0.3
        lb.Parent = bb
        o.bb, o.label = bb, lb
        ESPObjs[adornee] = o
    end
    if o.hl then
        o.hl.FillColor = color
        o.hl.OutlineColor = color
    end
    o.label.TextColor3 = color
    o.label.Text = Config.ESPText and text or ""
    o.seen = true
end

local function ESPClear(adornee)
    local o = ESPObjs[adornee]
    if o then
        if o.hl then
            o.hl:Destroy()
        end
        if o.bb then
            o.bb:Destroy()
        end
        ESPObjs[adornee] = nil
    end
end

local function ESPClearAll()
    for a in pairs(ESPObjs) do
        ESPClear(a)
    end
end

task.spawn(function()
    while Alive() do
        task.wait(0.4)
        local root = MyRoot()
        local anyOn = Config.ESPKiller or Config.ESPSurvivor or Config.ESPGen or Config.ESPGate
            or Config.ESPHook or Config.ESPPallet
        if not (anyOn and root) then
            if next(ESPObjs) then
                ESPClearAll()
            end
        else
            for _, o in pairs(ESPObjs) do
                o.seen = false
            end
            local me = root.Position
            local maxD = Config.ESPRange

            local function within(inst)
                local p = PosOf(inst)
                return p and Dist(p, me) <= maxD, p
            end

            -- ผู้เล่น
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local isK = false
                    for _, k in ipairs(State.Killers) do
                        if k.plr == p then
                            isK = true
                        end
                    end
                    if (isK and Config.ESPKiller) or (not isK and Config.ESPSurvivor) then
                        local ok, pos = within(p.Character:FindFirstChild("HumanoidRootPart") or p.Character)
                        if ok then
                            ESPSet(
                                p.Character,
                                isK and COLOR.Killer or COLOR.Survivor,
                                string.format("%s [%dm]", (isK and "🔪 " or "") .. p.DisplayName, math.floor(Dist(pos, me))),
                                true
                            )
                        end
                    end
                end
            end

            if Config.ESPGen then
                for _, g in ipairs(Static.gens) do
                    local ok, pos = within(g)
                    if ok and g.Parent then
                        local prog, done = GenInfo(g)
                        local label = done and "ไฟ ✔" or (prog and string.format("ไฟ %d%%", math.floor(prog)) or "ไฟ")
                        ESPSet(g, done and COLOR.GenDone or COLOR.Gen, string.format("%s [%dm]", label, math.floor(Dist(pos, me))), true)
                    end
                end
            end

            if Config.ESPGate and Static.gate then
                local ok, pos = within(Static.gate)
                if ok then
                    ESPSet(Static.gate, COLOR.Gate, string.format("ประตูออก [%dm]", math.floor(Dist(pos, me))), true)
                end
            end

            if Config.ESPHook then
                for _, h in ipairs(Static.hooks) do
                    local ok, pos = within(h)
                    if ok and h.Parent then
                        ESPSet(h, COLOR.Hook, string.format("ตะขอ [%dm]", math.floor(Dist(pos, me))), false)
                    end
                end
            end

            if Config.ESPPallet then
                for _, pl in ipairs(Static.pallets) do
                    local ok, pos = within(pl)
                    if ok and pl.Parent then
                        ESPSet(pl, COLOR.Pallet, string.format("พาเลท [%dm]", math.floor(Dist(pos, me))), false)
                    end
                end
            end

            for a, o in pairs(ESPObjs) do
                if not o.seen or not a.Parent then
                    ESPClear(a)
                end
            end
        end
    end
    ESPClearAll()
    pcall(function()
        ESPRoot:Destroy()
    end)
end)

