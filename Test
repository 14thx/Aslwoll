                    if not action:find("spawn") and not action:find("car") and not obj:find("car") then
                        targetPrompt = prompt
                        break
                    end
                end
            end
        end
    end
    if targetPrompt then
        local holdTime = math.max((targetPrompt.HoldDuration or 0.1), 0.15) + 0.12
        pcall(function() targetPrompt:InputHoldBegin() end)
        task.wait(holdTime)
        pcall(function() targetPrompt:InputHoldEnd() end)
        return true
    end
    return false
