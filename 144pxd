-- 8. ระบบเบิกรถในเมือง & เก็บรถตรงเสาฟาร์ม & เบิกรถที่เสาที่ใกล้ที่สุด (Mobile Safe 100%)
-- ==============================================================================
local function StoreCarAtBooth(boothPos)
    GrantAntiXGrace(35)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local myCar = GetPlayerVehicle()
    if not myCar then return end

    local carName = myCar.Name or "Buggy"
    local spPt = GetSpawnPointForBooth(boothPos)

    -- จอดรถตรงจุด Spawn Box ของตู้เพื่อให้ระบบคลุมแสงสีฟ้าอ่อนรอบตัวรถ
    if myCar.PrimaryPart then
        if spPt and spPt:IsA("BasePart") then
            myCar:PivotTo(spPt.CFrame + Vector3.new(0, 1.2, 0))
        else
            local groundY = GetGroundLevel(boothPos.X, boothPos.Z, boothPos.Y)
            myCar:PivotTo(CFrame.new(boothPos.X, groundY + 1.2, boothPos.Z))
        end
        myCar.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
        myCar.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
    end

    -- รอ 2 วินาทีก่อนลงรถ/เก็บรถ เพื่อให้ระบบ Spawn Box แสดงแสงสีฟ้าคลุมรถชัดเจน
    task.wait(2.0)

    -- ลงจากรถอย่างเป็นธรรมชาติ เท้าแตะพื้นข้างประตูรถ ไม่กระโดดลอยฟ้า
    ExitCarNaturally(myCar)

    -- หากอยู่ห่างจากตู้ ให้เดินเข้าหาตู้เบิกรถอย่างราบรื่น
    if root and (root.Position - boothPos).Magnitude > 8 then
        SmoothWalkTo(boothPos, 3, nil, 1.2)
    end

    -- ปลดล็อค ProximityPrompt ทันที
    pcall(function()
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hum or not hum.Sit then
            game:GetService("ProximityPromptService").Enabled = true
        end
    end)

    -- ค้นหา Prompt ตู้เบิกรถเพื่อเปิด UI และกด Pound
    local boothPrompt = nil
    local farmSys = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Farm")
    if farmSys then
        for _, f in ipairs(farmSys:GetChildren()) do
            local sp = f:FindFirstChild("Prompt") and f.Prompt:FindFirstChild("Spawn")
            local p = sp and sp:FindFirstChildWhichIsA("ProximityPrompt", true)
            if p then
                local pos = (p.Parent:IsA("Attachment") and p.Parent.WorldPosition) or (p.Parent:IsA("BasePart") and p.Parent.Position)
                if pos and (pos - boothPos).Magnitude <= 40 then
                    boothPrompt = p
                    p.Enabled = true
                    break
                end
            end
        end
    end
    if not boothPrompt then
        local carSpawns = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Car_Spawn")
        if carSpawns then
            for _, sp in ipairs(carSpawns:GetChildren()) do
                local p = sp:FindFirstChildWhichIsA("ProximityPrompt", true)
                if p then
                    local pos = (p.Parent:IsA("Attachment") and p.Parent.WorldPosition) or (p.Parent:IsA("BasePart") and p.Parent.Position)
                    if pos and (pos - boothPos).Magnitude <= 40 then
                        boothPrompt = p
                        p.Enabled = true
                        break
                    end
                end
            end
        end
    end
    if not boothPrompt then
        boothPrompt = FindPromptNear(boothPos, 40, "SPAWN") or FindPromptNear(root.Position, 30, nil)
    end

    -- เปิด UI Car_Spawn
    if boothPrompt then
        boothPrompt.Enabled = true
        TriggerPrompt(boothPrompt)
    end

    local cs = PlayerGui:WaitForChild("Car_Spawn", 1.5)
    local t0 = os.clock()
    while (not cs or not cs:FindFirstChild("Group") or not cs.Group.Visible) and (os.clock() - t0 < 1.2) do
        if boothPrompt then TriggerPrompt(boothPrompt) end
        task.wait(0.15)
    end

    -- กดปุ่ม Pound เพื่อเก็บรถ
    if cs and cs:FindFirstChild("Group") and cs.Group.Visible then
        local btn, btnType = FindCarSpawnOrPoundButton(cs.Group, carName)
        if btn and btnType == "pound" then
            ClickGuiButton(btn)
            task.wait(0.4)
        else
            for _, desc in ipairs(cs.Group:GetDescendants()) do
                if desc.Name == "Pound" and desc:IsA("GuiButton") and desc.Visible then
                    ClickGuiButton(desc)
                    task.wait(0.4)
                    break
                end
            end
        end
    end

    -- ยิง Remote Despawn สำรอง
    pcall(function()
        local remCore = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Modules") and ReplicatedStorage.Systems.Modules:FindFirstChild("Core") and ReplicatedStorage.Systems.Modules.Core:FindFirstChild("Remotes")
        if remCore then
            local Remotes_m = require(remCore)
            Remotes_m.Fire("_carspawn", "Despawn", carName)
            Remotes_m.Fire("_carspawn", "Despawn")
            MY_SPAWNED_CAR = nil
        end
    end)

    -- ปิด UI Car_Spawn และคืนค่า ProximityPrompt
    CloseCarSpawnGui()
    task.wait(0.2)
end

local function GetSpawnPointForBooth(boothPos)
    local bestPt = nil
    local bestDist = math.huge
    local farmSys = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Farm")
    if farmSys then
        for _, farm in ipairs(farmSys:GetChildren()) do
            local sp = farm:FindFirstChild("Prompt") and farm.Prompt:FindFirstChild("Spawn")
            local ptFolder = sp and sp:FindFirstChild("Point")
            if ptFolder then
                for _, pt in ipairs(ptFolder:GetChildren()) do
                    if pt:IsA("BasePart") then
                        local d = (pt.Position - boothPos).Magnitude
                        if d < bestDist then
                            bestDist = d
                            bestPt = pt
                        end
                    end
                end
            end
        end
    end
    if not bestPt then
        local carSpawns = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Car_Spawn")
        if carSpawns then
            for _, sp in ipairs(carSpawns:GetChildren()) do
                local pt = sp:FindFirstChild("Point") or sp:FindFirstChild("Spawn") or sp
                local part = pt:IsA("BasePart") and pt or pt:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local d = (part.Position - boothPos).Magnitude
                    if d < bestDist then
                        bestDist = d
                        bestPt = part
                    end
                end
            end
        end
    end
    return bestPt
end

