local function ClampGuiCenter(target, center, screenSize)
    -- target uses AnchorPoint (0.5, 0.5); clamp the anchor using rendered size.
    local half = target.AbsoluteSize / 2
    local minX = math.min(half.X, screenSize.X / 2)
    local minY = math.min(half.Y, screenSize.Y / 2)
    local maxX = math.max(screenSize.X - half.X, screenSize.X / 2)
    local maxY = math.max(screenSize.Y - half.Y, screenSize.Y / 2)
    return Vector2.new(
        math.clamp(center.X, minX, maxX),
        math.clamp(center.Y, minY, maxY)
    )
end

local function SavePosition(target, kx, ky)
    local s = Screen.AbsoluteSize
    if s.X <= 0 or s.Y <= 0 then
        return
    end
    -- Read the anchor location from UDim2 rather than AbsolutePosition; this
    -- avoids mobile touch / GUI-inset coordinate-space mismatches.
    local pos = target.Position
    local center = Vector2.new(
        pos.X.Scale * s.X + pos.X.Offset,
        pos.Y.Scale * s.Y + pos.Y.Offset
    )
    center = ClampGuiCenter(target, center, s)
    local fx = center.X / s.X
    local fy = center.Y / s.Y
    target.Position = UDim2.fromScale(fx, fy)
    SetConfig(kx, math.floor(fx * 10000) / 10000)
    SetConfig(ky, math.floor(fy * 10000) / 10000)
end

local function MakeDraggable(handle, target, kx, ky, onClick)
    local dragging, dragInput, startPos, startTargetPosition, moved = false, nil, nil, nil, false

    handle.InputBegan:Connect(function(input)
        if IsPointer(input) then
            dragging = true
            moved = false
            dragInput = input
            startPos = input.Position
            local s = Screen.AbsoluteSize
            local p = target.Position
            startTargetPosition = Vector2.new(
                p.X.Scale * s.X + p.X.Offset,
                p.Y.Scale * s.Y + p.Y.Offset
            )
        end
    end)

    Track(UIS.InputChanged:Connect(function(input)
        if not dragging or not IsMove(input) then
            return
        end
        if input.UserInputType == Enum.UserInputType.Touch and input ~= dragInput then
            return
        end
        local d = input.Position - startPos
        if d.Magnitude > 8 then
            moved = true
        end
        if moved then
            local s = Screen.AbsoluteSize
            local center = ClampGuiCenter(target, startTargetPosition + Vector2.new(d.X, d.Y), s)
            -- Use offset coordinates during drag; normalize and save on release.
            target.Position = UDim2.fromOffset(center.X, center.Y)
        end
    end))

    Track(UIS.InputEnded:Connect(function(input)
        if dragging and IsPointer(input) then
            if input.UserInputType == Enum.UserInputType.Touch and input ~= dragInput then
                return
            end
            dragging = false
            if moved then
                SavePosition(target, kx, ky)
            elseif onClick then
                onClick()
            end
        end
    end))
end

