local MY_SPAWNED_CAR = nil

-- [คำสั่งผู้ใช้]: ตรวจสอบว่าเป็นรถของตัวเองเท่านั้น ห้ามแตะต้อง/ขึ้นรถคนอื่นเด็ดขาด 100%
local function IsMyVehicle(v)
    if not v or not v:IsA("Model") or not v.Parent then return false end

    local myName = LocalPlayer.Name
    local myUserId = LocalPlayer.UserId

    -- 1. ตรวจสอบ Attribute Owner จากระบบเกม (ชัดเจนและตรงที่สุด 100%)
    local owner = v:GetAttribute("Owner") or v:GetAttribute("OwnerName") or v:GetAttribute("Player")
    local ownerId = v:GetAttribute("OwnerId") or v:GetAttribute("UserId") or v:GetAttribute("PlayerId")

    -- ถ้าตัวรถมีระบุชื่อเจ้าของ และไม่ใช่ตัวเรา -> คืนค่า FALSE ทันที ห้ามแตะต้องรถคนอื่นเด็ดขาด!
    if owner ~= nil and tostring(owner) ~= "" then
        if tostring(owner) == myName or tostring(owner) == tostring(myUserId) then
            return true
        else
            return false
        end
    end

    -- ถ้าตัวรถมีระบุ UserId และไม่ใช่ ID ของเรา -> คืนค่า FALSE ทันที!
    if ownerId ~= nil and tonumber(ownerId) then
        if tonumber(ownerId) == myUserId then
            return true
        else
            return false
        end
    end

    -- 2. ตรวจสอบ Value Object Owner ภายในตัวรถ
    local ownerVal = v:FindFirstChild("Owner") or v:FindFirstChild("Player")
    if ownerVal and (ownerVal:IsA("StringValue") or ownerVal:IsA("ObjectValue")) then
        if ownerVal.Value == myName or ownerVal.Value == LocalPlayer then
            return true
        else
            return false
        end
    end

    -- 3. ถ้าไม่มีหลักฐานยืนยันว่าเป็นรถของเรา -> ปฏิเสธทันที ไม่ใช่รถเราเด็ดขาด
    return false
end

-- [คำสั่งผู้ใช้]: ค้นหารถของตัวเองเท่านั้น
local function GetPlayerVehicle()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    -- 1. ถ้าตัวเรากำลังนั่งอยู่ในรถ และต้องเป็นรถของตัวเองเท่านั้น
    if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
        local veh = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if veh and IsMyVehicle(veh) then
            return veh
        end
    end

    -- 2. ถ้ารถที่เราจำไว้ยังคงอยู่ในแมพ และยังเป็นรถของเราจริง
    if MY_SPAWNED_CAR and MY_SPAWNED_CAR.Parent and MY_SPAWNED_CAR.PrimaryPart and IsMyVehicle(MY_SPAWNED_CAR) then
        return MY_SPAWNED_CAR
    end

    -- 3. ค้นหาในโฟลเดอร์ Vehicles เฉพาะที่เป็นรถของตัวเอง 100%
    local vehFolder = (workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Vehicles")) or workspace:FindFirstChild("Vehicles")
    if vehFolder then
        for _, v in ipairs(vehFolder:GetChildren()) do
            if v:IsA("Model") and IsMyVehicle(v) and v.PrimaryPart then
                MY_SPAWNED_CAR = v
                return v
            end
        end
    end

    return nil
end

-- [คำสั่งผู้ใช้]: ค้นหารถของตัวเองที่อยู่ใกล้ตัว (ห้ามหยิบรถคนอื่นเด็ดขาด)
local function GetNearbyPlayerVehicle(maxDist)
    maxDist = maxDist or 80
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, math.huge, nil end

    -- 1. ถ้าตัวเรากำลังนั่งอยู่ในรถของตัวเอง
    if hum and hum.Sit and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
        local veh = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if veh and IsMyVehicle(veh) then
            return veh, 0, nil
        end
    end

    -- 2. สแกนหาเฉพาะรถของตัวเองในระยะที่ใกล้ที่สุด
    local vehFolder = (workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Vehicles")) or workspace:FindFirstChild("Vehicles")
    local nearestCar = nil
    local minDist = math.huge

    if vehFolder then
        for _, v in ipairs(vehFolder:GetChildren()) do
            if v:IsA("Model") and IsMyVehicle(v) and v.PrimaryPart then
                local dist = (v.PrimaryPart.Position - root.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearestCar = v
                end
            end
        end
    end

    if nearestCar then
        if minDist <= maxDist then
            MY_SPAWNED_CAR = nearestCar
            return nearestCar, minDist, nil
        else
            -- รถเราอยู่ไกลเกินระยะ maxDist
            return nil, minDist, nearestCar
        end
    end

    return nil, math.huge, nil
end

-- [คำสั่งผู้ใช้]: กด F ขึ้นรถคนขับเฉพาะรถของตัวเองเท่านั้น ห้ามขึ้นรถคนอื่นเด็ดขาด 100%
local function PressFToEnterCar(car)
    if not car or not car.Parent then return false end

    -- ปฏิเสธทันทีถ้าไม่ใช่รถของตัวเอง
    if not IsMyVehicle(car) then
        pcall(function()
            Notify({
                Title = "EASY HUB",
                Content = "⚠️ ปฏิเสธการขึ้นรถ: คันนี้ไม่ใช่รถของเรา!",
                Duration = 2.0
            })
        end)
        return false
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end

    local seat = car:FindFirstChild("DriveSeat", true) or car:FindFirstChildWhichIsA("VehicleSeat", true)
    if not seat then return false end

    -- ถ้าตัวเรานั่งอยู่ในเบาะคนขับคันนี้อยู่แล้ว
    if hum.Sit and hum.SeatPart == seat then
        pcall(function()
            game:GetService("ProximityPromptService").Enabled = false
        end)
        return true
    end

    -- ถ้าตัวเรากำลังนั่งอยู่ในรถคันอื่น ให้ลุกออกทันที
    if hum.Sit and hum.SeatPart ~= seat then
        hum.Sit = false
        task.wait(0.2)
    end

    GrantAntiXGrace(15)

    -- ค้นหา ProximityPrompt [F] Drive ของที่นั่งคนขับในรถตัวเองเท่านั้น
    local drivePrompt = nil
    local pFolder = seat:FindFirstChild("Prompt")
    if pFolder and pFolder:FindFirstChild("Prompt") and pFolder.Prompt:IsA("ProximityPrompt") then
        drivePrompt = pFolder.Prompt
    else
        for _, d in ipairs(seat:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.ActionText:lower():find("drive") and not d.ActionText:lower():find("passenger") then
                drivePrompt = d
                break
            end
        end
    end

    -- ปิด ProximityPrompt ของที่นั่งผู้โดยสาร (Passenger) ในรถตัวเองชั่วคราว เพื่อไม่ให้เผลอกดขึ้นเป็นผู้โดยสาร
    for _, d in ipairs(car:GetDescendants()) do
        if d:IsA("ProximityPrompt") and (d.ActionText:lower():find("passenger") or d.Name:lower():find("passenger")) then
            d.Enabled = false
        end
    end

    -- ปิด ProximityPrompt ของรถคันอื่นทั้งหมดรอบตัว เพื่อไม่ให้กดผิดคัน 100%
    local vehFolder = (workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Vehicles")) or workspace:FindFirstChild("Vehicles")
    if vehFolder then
        for _, otherVeh in ipairs(vehFolder:GetChildren()) do
            if otherVeh ~= car then
                for _, otherP in ipairs(otherVeh:GetDescendants()) do
                    if otherP:IsA("ProximityPrompt") then
                        otherP.Enabled = false
                    end
                end
            end
        end
    end

    -- ยืนข้างประตูคนขับ (ฝั่งซ้ายของเบาะคนขับ -2.6 studs) ของรถตัวเองอย่างเป็นธรรมชาติ
    local doorCF = seat.CFrame * CFrame.new(-2.6, 0.2, 0)
    root.CFrame = CFrame.lookAt(doorCF.Position, seat.Position)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    task.wait(0.15)

    -- เปิดให้ระบบ ProximityPrompt ทำงานเฉพาะปุ่ม Drive ของรถเรา
    pcall(function()
        game:GetService("ProximityPromptService").Enabled = true
        if drivePrompt then drivePrompt.Enabled = true end
    end)

    -- กดปุ่ม F เข้าที่นั่งคนขับ
    if drivePrompt then
        pcall(function() fireproximityprompt(drivePrompt) end)
        pcall(function() drivePrompt:InputHoldBegin() end)
        task.wait(0.06)
        pcall(function() drivePrompt:InputHoldEnd() end)
    end

    -- รอให้ระบบของเกมส่งตัวเข้าที่นั่งคนขับ
    local t0 = os.clock()
    while os.clock() - t0 < 1.5 do
        if hum.Sit and hum.SeatPart == seat then
            break
        end
        task.wait(0.1)
    end

    -- Fallback: ถ้ายังไม่ได้เข้าที่นั่ง ให้ Sit ป้องกันค้าง
    if not (hum.Sit and hum.SeatPart == seat) then
        pcall(function()
            root.CFrame = seat.CFrame + Vector3.new(0, 0.5, 0)
            seat:Sit(hum)
        end)
        task.wait(0.2)
    end

    local isSeated = hum.Sit and hum.SeatPart == seat
    if isSeated then
        MY_SPAWNED_CAR = car
        pcall(function()
            game:GetService("ProximityPromptService").Enabled = false
        end)
    end
    return isSeated
end

