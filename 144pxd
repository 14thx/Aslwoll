local function CraftFoodAtStation(recipeName, shouldContinueCheck)
    local foodData = TYPER_LOCATIONS.Food
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local myCar = GetPlayerVehicle() or EnsureCarAvailable()
    if myCar then PressFToEnterCar(myCar) end
    local cPrompt = GetCraft3Prompt()
    local pos = foodData.Crafting
    if cPrompt and cPrompt.Parent then
        local pp = cPrompt.Parent
        pos = (pp:IsA("BasePart") and pp.Position) or (pp:IsA("Attachment") and pp.WorldPosition) or foodData.Crafting
    end
    DriveCarTo(pos + Vector3.new(0, 0, 5.0), shouldContinueCheck)
    task.wait(0.5)
    if hum.Sit then hum.Sit = false; task.wait(0.5) end
    local gy = GetGroundLevel(pos.X, pos.Z, pos.Y)
    root.CFrame = CFrame.lookAt(Vector3.new(pos.X, gy + 3.0, pos.Z + 2.5), pos)
    task.wait(0.5)
    cPrompt = cPrompt or GetCraft3Prompt()
    if cPrompt then TriggerPrompt(cPrompt) end
    local cg, mainFrame
    for i = 1, 10 do
        cg = PlayerGui:FindFirstChild("Crafting")
        mainFrame = cg and cg:FindFirstChild("Group") and cg.Group:FindFirstChild("Main")
        if mainFrame and cg.Group.Visible then break end
        if cPrompt then TriggerPrompt(cPrompt) end
        task.wait(0.5)
    end
    if not mainFrame then return end
    local function maxCraft()
        local b = GetPlayerInventoryCount("Bread")
        local c = GetPlayerInventoryCount("Catchup")
        local p = GetPlayerInventoryCount("Pig")
        local m = GetPlayerInventoryCount("Mango")
        local r = GetPlayerInventoryCount("Rice")
        if recipeName == "Sandwish" then return math.min(math.floor(b/3), math.floor(c/2), math.floor(p/2))
        elseif recipeName == "MangoRice" then return math.min(math.floor(m/2), math.floor(r/3))
        elseif recipeName == "KangSom" then return math.min(math.floor(GetPlayerInventoryCount("Tomato")/2), math.floor(GetPlayerInventoryCount("Crab")/2)) end
        return 1
    end
    local n = maxCraft()
    if n <= 0 then
        if cg and cg:FindFirstChild("Group") then cg.Group.Visible = false end
        return
    end
    local scroller = mainFrame:FindFirstChild("Left_Tab") and mainFrame.Left_Tab:FindFirstChild("ScrollingFrame")
    if scroller then
        local sc = scroller:FindFirstChild("Sand") or scroller:FindFirstChild("Food")
        if sc then SafeClickGuiButton(sc); task.wait(0.3) end
        local rb = scroller:FindFirstChild(recipeName) or mainFrame:FindFirstChild(recipeName, true)
        if rb then
            local ct = (rb:IsA("GuiButton") and rb) or rb:FindFirstChildWhichIsA("GuiButton", true)
            if ct and ct:IsA("GuiButton") then SafeClickGuiButton(ct) end
            task.wait(0.3)
        end
    end
    local amtBox = mainFrame:FindFirstChild("Function") and mainFrame.Function:FindFirstChild("Amount") and mainFrame.Function.Amount:FindFirstChild("Amount")
    if amtBox and amtBox:IsA("TextBox") then amtBox.Text = tostring(n); task.wait(0.3) end
    local craftBtn = mainFrame:FindFirstChild("Button") and mainFrame.Button:FindFirstChild("Craft")
    if craftBtn and craftBtn:IsA("GuiButton") then SafeClickGuiButton(craftBtn); task.wait(0.5) end
    pcall(function() if Fluent and Fluent.Notify then Fluent:Notify({ Title="NEXUS", Content="🍳 คราฟ "..recipeName.." x"..n, Duration=3 }) end end)
    task.wait(10.0)
    pcall(function()
        if mainFrame and mainFrame:FindFirstChild("Exit") then SafeClickGuiButton(mainFrame.Exit) end
        if cg and cg:FindFirstChild("Group") then cg.Group.Visible = false end
    end)
    task.wait(1.0)
    if myCar then PressFToEnterCar(myCar) end
end

