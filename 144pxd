    Callback = function(v)
        if v then
            local check = RequestFarmSession("IndividualMaster")
            task.spawn(function()
                local firstRun = true
                while check() do
                    local crop = selectedIndividualCrop
                    if GetPlayerInventoryCount(crop) < 60 then
                        if firstRun then EnsureCarAvailable(TOWN_CAR_SPAWN); firstRun = false end
                        HarvestSingleCrop(crop, 60, check)
                    end
                    if not check() then break end
                    SellAtEconomyMarket(check)
                    if not check() then break end
                    task.wait(1.0)
                end
            end)
        else StopFarmSession("IndividualMaster") end
    end
})

Tabs.Fishing:AddToggle("ToggleAutoFishing", {
    Title = "เริ่มตกปลา", Default = false,
