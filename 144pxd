local function FarmDropdown(page, opts)
    local baseHeight = 96
    local row = Panel(page, UDim2.new(1, 0, 0, baseHeight))
    row.ClipsDescendants = true
    Register(row, opts.title .. " " .. (opts.desc or ""))

    local title = Text(row, opts.title, 13, FNT.B, "Text")
    title.Position = UDim2.fromOffset(16, 8)
    title.Size = UDim2.new(1, -32, 0, 19)
    local desc = Text(row, opts.desc or "", 10, FNT.R, "Muted")
    desc.Position = UDim2.fromOffset(16, 28)
    desc.Size = UDim2.new(1, -32, 0, 16)

    local selector = New("TextButton", {
        Size = UDim2.new(1, -28, 0, 30),
        Position = UDim2.fromOffset(14, 55),
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        TextSize = 11,
        Font = FNT.M,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    Bind(selector, "BackgroundColor3", "Button")
    Bind(selector, "TextColor3", "Text")
    Corner(selector, 10)
    Stroke(selector, Theme.Stroke, 1, 0.2)

    local menu = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.fromOffset(14, 90),
        BackgroundTransparency = 1,
        Visible = false,
        ClipsDescendants = true,
    }, row)
    New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, menu)

    local allowed = {}
    for _, value in ipairs(opts.values) do allowed[value] = true end
    local selected = Config[opts.key]
    if not allowed[selected] then selected = opts.values[1] end
    local isOpen = false
    local menuHeight = #opts.values * 31

    local function renderSelected()
        local label = (opts.display and opts.display[selected]) or selected
        selector.Text = "  " .. tostring(label) .. "                         ▾"
    end
    local function setOpen(open)
        isOpen = open
        menu.Visible = open
        menu.Size = UDim2.new(1, 0, 0, open and menuHeight or 0)
        row.Size = UDim2.new(1, 0, 0, open and (baseHeight + menuHeight) or baseHeight)
        selector.Text = "  " .. tostring((opts.display and opts.display[selected]) or selected) .. (open and "                         ▴" or "                         ▾")
    end

    for index, value in ipairs(opts.values) do
        local option = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundTransparency = 0.04,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            LayoutOrder = index,
        }, menu)
        Bind(option, "BackgroundColor3", "Surface2")
        Corner(option, 8)
        local optionLabel = Text(option, (opts.display and opts.display[value]) or value, 11, FNT.M, "Sub")
        optionLabel.Position = UDim2.fromOffset(10, 0)
        optionLabel.Size = UDim2.new(1, -20, 1, 0)
        option.MouseButton1Click:Connect(function()
            selected = value
            SetConfig(opts.key, value)
            renderSelected()
            setOpen(false)
            if opts.callback then task.spawn(opts.callback, value) end
        end)
    end
    selector.MouseButton1Click:Connect(function() setOpen(not isOpen) end)
    renderSelected()
    if opts.callback then task.defer(opts.callback, selected) end
    Refreshers[#Refreshers + 1] = function()
        selected = Config[opts.key]
        if not allowed[selected] then selected = opts.values[1] end
        renderSelected()
        setOpen(false)
        if opts.callback then task.spawn(opts.callback, selected) end
    end
    return { Get = function() return selected end }
end

