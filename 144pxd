    local myCar = GetPlayerVehicle()
    if not myCar or not hum.Sit then
        myCar = EnsureCarAvailable()
    end
    if myCar then
        EnsurePlayerSeatedInCar(myCar)
    end

    -- 1. ปิด UI ที่อาจค้างอยู่ (เช่น Process หรือ Economy) เพื่อป้องกันการเปิด UI ผิด
