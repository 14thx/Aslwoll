-- 13. ระบบจัดการฟังก์ชันแบบแยกเดี่ยว (ห้ามเปิดทับซ้อนกัน 100%)
-- ==============================================================================
local CurrentFarmSessionId = 0
local CurrentActiveFarmKey = nil
local isUnloaded = false
local FarmToggleControls = {}

local function RequestFarmSession(farmKey)
    SetFloatingButtonVisible(true)
    CurrentFarmSessionId = CurrentFarmSessionId + 1
    local thisSession = CurrentFarmSessionId
    CurrentActiveFarmKey = farmKey

    -- สั่งปิดสวิตช์ฟังก์ชันอื่นทั้งหมดในหน้าต่าง UI อัตโนมัติทันที
    task.spawn(function()
        for key, toggleObj in pairs(FarmToggleControls) do
            if key ~= farmKey and toggleObj and toggleObj.SetValue then
                pcall(function()
                    toggleObj:SetValue(false)
                end)
            end
        end
    end)

    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "🔒 สลับไปทำงาน: " .. tostring(farmKey) .. " (ปิดฟังก์ชันอื่นอัตโนมัติ)",
            Duration = 2.0
        })
    end)

    return function()
        return CurrentFarmSessionId == thisSession and CurrentActiveFarmKey == farmKey
    end
end

local function StopFarmSession(farmKey)
    if CurrentActiveFarmKey == farmKey then
        CurrentFarmSessionId = CurrentFarmSessionId + 1
        CurrentActiveFarmKey = nil
    end
    task.spawn(function()
        task.wait(0.2)
        local anyActive = false
        for _, tObj in pairs(FarmToggleControls) do
            if tObj and tObj.Value then
                anyActive = true
                break
            end
        end
        -- ปุ่มลอยแสดงตลอดเวลา จะหายเฉพาะตอนกดปิดสคริปต์เท่านั้น
    end)
end

