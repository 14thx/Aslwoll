        if p then
            local par = p.Parent
            local pPos = (par:IsA("Attachment") and par.WorldPosition) or (par:IsA("BasePart") and par.Position)
            if pPos then return pPos, p end
        end
        local part = ecoModel:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.Position, nil end
    end
    local x, z = -462.0, 5324.7
    local y = GetGroundLevel(x, z, 17.5)
    local fb = Vector3.new(x, y + 1.2, z)
    local fbP = FindPromptNear(fb, 30, "econ") or FindPromptNear(fb, 30, "sell") or FindPromptNear(fb, 30, nil)
    return fb, fbP
end

