local AntiKickActive = true
local KickBlockCount = 0

pcall(function()
    local lp = Players.LocalPlayer
    if hookfunction and lp and lp.Kick then
        local oldKick = lp.Kick
        hookfunction(oldKick, newcclosure(function(self, reason)
            if AntiKickActive then
                KickBlockCount = KickBlockCount + 1
                warn("🛡️ [ANTI-KICK] Blocked Kick #" .. KickBlockCount .. ": " .. tostring(reason or "Unknown"))
                if Fluent and Fluent.Notify then
                    pcall(function()
                        Fluent:Notify({ Title = "🛡️ ANTI-KICK", Content = "บล็อกการเตะ! (ครั้งที่ " .. KickBlockCount .. ")", Duration = 4.0 })
                    end)
                end
                return nil
            end
            return oldKick(self, reason)
        end))
    end
    if hookfunction and Players and Players.Kick then
        local oldPKick = Players.Kick
        hookfunction(oldPKick, newcclosure(function(self, player, reason)
            if AntiKickActive and player == lp then
                KickBlockCount = KickBlockCount + 1
                warn("🛡️ [ANTI-KICK] Blocked Players:Kick #" .. KickBlockCount)
                return nil
            end
            return oldPKick(self, player, reason)
        end))
    end
    if hookmetamethod then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            if (method == "Kick" or method == "kick") and AntiKickActive then
                if self == lp or self == Players then
                    KickBlockCount = KickBlockCount + 1
                    warn("🛡️ [ANTI-KICK] Blocked namecall Kick #" .. KickBlockCount)
                    return nil
                end
            end
            if (method == "FireServer" or method == "InvokeServer") and AntiKickActive then
                if self and self.Name then
                    local rName = self.Name:lower()
                    if rName == "kick" or rName == "ban" or rName == "anticheat" then return nil end
                end
            end
            return oldNamecall(self, ...)
        end))
    end
    local function Neutralize(char)
        if not char then return end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") then
                local n = d.Name:lower()
                if n:find("antifall") or n:find("fall") or n:find("ragdoll") or n:find("anti") then
                    pcall(function() d.Disabled = true; d:Destroy() end)
                end
            end
        end
    end
    if lp.Character then Neutralize(lp.Character) end
    lp.CharacterAdded:Connect(Neutralize)
end)

