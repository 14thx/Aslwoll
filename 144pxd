        end
    end

    -- 1. ขับรถเข้าไปจอดภายในวงฟาร์ม (Farm Circle) เยื้องจากเสากลาง ~4.5 สตั๊ด เพื่อให้อยู่ในวงพอดี ไม่พุ่งชนเสา
    local farmPos = locData.Farm
    local exactCenter = GetExactFarmPromptPosition(cropName) or farmPos
    local boothPos = locData.Booth
    local farmParkingPos = Vector3.new(exactCenter.X + 4.5, GetGroundLevel(exactCenter.X + 4.5, exactCenter.Z + 4.5, exactCenter.Y), exactCenter.Z + 4.5)

    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "🚗 ขับรถเข้าไปจอดในวงฟาร์ม " .. cropName .. "...",
            Duration = 2.0
        })
    end)

    DriveCarTo(farmParkingPos, shouldContinueCheck)
    task.wait(0.1)
    if shouldContinueCheck and not shouldContinueCheck() then return end

    -- [คำสั่งผู้ใช้]: พอถึงฟาร์มรอ 2 วินาทีเพื่อลงจากรถ
    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "🚗 ถึงฟาร์มแล้ว! รอ 2 วินาทีเพื่อลงจากรถ...",
            Duration = 2.0
        })
    end)
    task.wait(2.0)

    -- ลงจากรถอย่างเป็นธรรมชาติข้างประตูรถ (ไม่ยุ่งกับตัวรถ ไม่ลบรถ ให้รถจอดอยู่ปกติพร้อมขับต่อ)
    ExitCarNaturally(myCar)
    task.wait(0.3)

    -- 5. เดินไปยืนในวงแหวนสีฟ้าของเสาฟาร์ม (หันหน้าเข้าหาเสากลาง)
    local standPos, bestAngle = GetHumanLikeFarmStandingSpot(exactCenter)
    SmoothWalkTo(standPos, 6, shouldContinueCheck, 1.2)
    task.wait(0.2)

    -- ยืนหันหน้าเข้าหาเสากลางฟาร์ม เท้าติดผิวดิน 100% (ตัวไม่ลอย ไม่ชนใคร เหมือนคนเล่นจริงๆ)
    if root then
        local finalGround = GetGroundLevel(standPos.X, standPos.Z, exactCenter.Y)
        root.CFrame = CFrame.lookAt(
            Vector3.new(standPos.X, finalGround + 2.2, standPos.Z),
            Vector3.new(exactCenter.X, finalGround + 2.2, exactCenter.Z)
        )
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    task.wait(0.2)
    if shouldContinueCheck and not shouldContinueCheck() then return end

    task.wait(1.5)

    -- 6. [กด E ฟาร์มอย่างปลอดภัยเสมือนคนเล่นจริง]: กดอย่างเป็นธรรมชาติ ไม่สแปมปุ่มเพื่อไม่ให้โดนเตะข้อหากันโปรฟาร์ม
    local isFarming = false
    TriggerFarmPromptDirectly(cropName)
    task.wait(1.5)

    local afGui = PlayerGui:FindFirstChild("Auto Farm") or PlayerGui:FindFirstChild("AutoFarm")
    if afGui and ((afGui:FindFirstChild("Group") and afGui.Group.Visible) or afGui.Enabled) then
        isFarming = true
    end

    -- หากสถานะฟาร์มยังไม่เริ่ม ให้กดย้ำอีกเพียง 1 ครั้งอย่างปลอดภัย
    if not isFarming and GetPlayerInventoryCount(cropName) == curCount then
        task.wait(0.5)
        TriggerFarmPromptDirectly(cropName)
        task.wait(1.5)
    end

    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "⚡ เริ่มฟาร์ม " .. cropName .. " เรียบร้อย (โหมดปลอดภัย 100%)",
            Duration = 2.0
        })
    end)

    -- 7. ยืนฟาร์มจนครบ 60 ชิ้น (รอรับของอย่างเดียว ห้ามกด Prompt ซ้ำเด็ดขาด)
    local farmTimeout = os.clock()
    while curCount < targetAmount do
        -- [คำสั่งผู้ใช้]: ออโต้กินข้าว + กาแฟ เมื่อหลอดอาหาร/น้ำลดเหลือ <= 75%
        if isAutoEatAndDrinkEnabled and not isConsumingItem then
            local h = GetPlayerHunger()
            local e = GetPlayerEnergy()
            if (h and h <= 75) or (e and e <= 75) then
                CancelGameFarm()
                task.wait(0.3)
                if h and h <= 75 then CheckAndAutoEat() end
                if e and e <= 75 then CheckAndAutoDrinkCoffee() end
                task.wait(0.3)
                TriggerFarmPromptDirectly(cropName)
                task.wait(1.2)
                farmTimeout = os.clock()
            end
        end

        if shouldContinueCheck and not shouldContinueCheck() then break end
        if os.clock() - farmTimeout > 180 then break end

        GrantAntiXGrace(15)

        local newCount = GetPlayerInventoryCount(cropName)
        if newCount > curCount then
            curCount = newCount
            farmTimeout = os.clock()
        elseif (os.clock() - farmTimeout > 15) and (newCount == curCount) then
            -- หากผ่านไป 15 วินาทีของไม่ขึ้น แสดงว่าอาจหลุดสถานะ ให้กดกระตุ้น 1 ครั้ง
            TriggerFarmPromptDirectly(cropName)
            farmTimeout = os.clock()
        end

        task.wait(0.5)
    end

    pcall(function()        Notify({
            Title = "EASY HUB",
            Content = "🎉 ฟาร์ม " .. cropName .. " ครบ " .. tostring(curCount) .. "/60 เรียบร้อย!",
            Duration = 3.0
        })
    end)
    task.wait(0.5)

    -- [แก้ตามคำสั่ง: ฟาร์มครบแล้ว เบิกรถออกมาทันทีและขึ้นนั่ง เพื่อเตรียมพร้อมขับไปคราฟท์/แปรรูป/ขายต่อ]
    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "🚗 ฟาร์ม " .. cropName .. " ครบแล้ว กำลังเบิกรถเพื่อเดินทางต่อ...",
            Duration = 2.5
        })
    end)

    local targetBooth = (locData and locData.Booth) or GetNearestCarBooth(root.Position)
    local car = SpawnCarAtBooth(targetBooth)
    if not car then
        car = EnsureCarAvailable(targetBooth)
    end
    if car then
        EnsurePlayerSeatedInCar(car)
    end
    task.wait(0.3)
end

local function GetCraft3Prompt()
    local craftSys = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Crafting")
    local c3 = craftSys and craftSys:FindFirstChild("Craft_3")
    if c3 then
        local p = c3:FindFirstChildWhichIsA("ProximityPrompt", true)
        if p and p.Enabled then return p end
        if c3:FindFirstChild("Prompt") then
            local pp = c3.Prompt:FindFirstChildWhichIsA("ProximityPrompt") or (c3.Prompt:IsA("ProximityPrompt") and c3.Prompt)
            if pp and pp.Enabled then return pp end
        end
    end
    if craftSys then
        for _, desc in ipairs(craftSys:GetDescendants()) do
            if desc:IsA("ProximityPrompt") and desc.Enabled then
                local p = desc.Parent
                while p and p ~= workspace do
                    if p.Name == "Craft_3" then
                        return desc
                    end
                    p = p.Parent
                end
            end
        end
    end
    return nil
end

local function CraftFoodAtStation(recipeName, shouldContinueCheck)
    local foodData = TYPER_LOCATIONS.Food
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

