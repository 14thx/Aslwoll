                        task.wait(0.4)
                    end
                    local myCar = GetNearbyPlayerVehicle(80) or EnsureCarAvailable(TOWN_CAR_SPAWN)
                    if myCar then EnsurePlayerSeatedInCar(myCar); DriveCarTo(BAIT_SHOP_POS, function() return isAutoFishingEnabled end); ExitCarNaturally(myCar); task.wait(0.3) end
                    -- ขายปลา
                    local econPos = TYPER_LOCATIONS.Economy.Market
                    local car = GetPlayerVehicle()
                    if car then EnsurePlayerSeatedInCar(car); DriveCarTo(econPos, function() return isAutoFishingEnabled end); ExitCarNaturally(car); task.wait(0.3) end
                    SellAtEconomyMarket(function() return isAutoFishingEnabled end)
                    task.wait(0.5)
                    -- ซื้อเหยื่อ
                    local car2 = GetNearbyPlayerVehicle(80) or EnsureCarAvailable(TOWN_CAR_SPAWN)
                    if car2 then EnsurePlayerSeatedInCar(car2); DriveCarTo(BAIT_SHOP_POS, function() return isAutoFishingEnabled end); ExitCarNaturally(car2); task.wait(0.3) end
                    local pData2 = LocalPlayer:FindFirstChild("PlayerData")
                    local money = (pData2 and pData2:GetAttribute("Money")) or 1000
                    local toBuy = math.clamp(math.floor(money / 10), 10, 200)
                    pcall(function()
                        local remCore = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Modules") and ReplicatedStorage.Systems.Modules:FindFirstChild("Core") and ReplicatedStorage.Systems.Modules.Core:FindFirstChild("Remotes")
                        if remCore then local Remotes_m = require(remCore); Remotes_m.Fire("_shop", "Buy", { FishingBait = toBuy }, "Money") end
                    end)
                    task.wait(0.5)
                    local car3 = GetNearbyPlayerVehicle(80) or EnsureCarAvailable(TOWN_CAR_SPAWN)
                    if car3 then EnsurePlayerSeatedInCar(car3); DriveCarTo(FISHING_PARKING_POS, function() return isAutoFishingEnabled end); ExitCarNaturally(car3); task.wait(0.4) end
                end
                if not isAutoFishingEnabled then break end
                char = LocalPlayer.Character
                root = char and char:FindFirstChild("HumanoidRootPart")
                local distToFish = root and (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(FISHING_SPOT.X, 0, FISHING_SPOT.Z)).Magnitude or 9999
                if distToFish > 3.0 then SmoothWalkTo(FISHING_SPOT, 25, function() return isAutoFishingEnabled end, 2.5); task.wait(0.2) end
                if not isAutoFishingEnabled then break end
                EnsureFishingPlatform(FISHING_SPOT)
                GrantAntiXGrace(20)
                if not IsFishingLineCast() and isAutoEatAndDrinkEnabled then
                    local h = GetPlayerHunger()
                    local e = GetPlayerEnergy()
                    if (h and h <= 75) or (e and e <= 75) then AutoEatThenDrink(95) end
                end
                local rod = char:FindFirstChild("FishingRod")
                if not rod then rod = EquipFishingRod() end
                if rod and rod.Parent == char then
                    if not IsFishingLineCast() then
                        root.CFrame = CFrame.lookAt(FISHING_SPOT, FISHING_LOOK_TARGET)
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        task.wait(0.2)
                        pcall(function() rod:Activate() end)
                        task.wait(1.0)
                    end
                    local pgui = LocalPlayer:FindFirstChild("PlayerGui")
                    local fg = pgui and pgui:FindFirstChild("FishingGame")
                    if fg and fg:FindFirstChild("Minigame") then SolveFishingMinigame(); task.wait(3.0)
                    else task.wait(0.2) end
                else task.wait(0.5) end
            end
            task.wait(0.2)
        end
        if fishingPlatform and fishingPlatform.Parent then fishingPlatform:Destroy(); fishingPlatform = nil end
        fishingThread = nil
    end)
end

local function StopAutoFishing()
    isAutoFishingEnabled = false
    if fishingPlatform and fishingPlatform.Parent then fishingPlatform:Destroy(); fishingPlatform = nil end
    fishingThread = nil
end

