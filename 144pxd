local function ConsumeItemSafely(itemName, isFood)
    if isConsumingItem or not itemName then return end
    isConsumingItem = true

    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        -- 1. เรียกใช้งานไอเทมเพื่อให้ระบบเกมส่ง Tool มาที่มือ/กระเป๋า
        pcall(function()
            local remCore = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Modules") and ReplicatedStorage.Systems.Modules:FindFirstChild("Core") and ReplicatedStorage.Systems.Modules.Core:FindFirstChild("Remotes")
            if remCore then
                local Remotes_m = require(remCore)
                Remotes_m.Fire("_inventory", "Use", itemName)
            else
                UseItem(itemName)
            end
        end)

        -- รอให้ไอเทมเข้ามาอยู่ในมือหรือกระเป๋า
        local tool = nil
        local t0 = os.clock()
        while os.clock() - t0 < 2.5 do
            char = LocalPlayer.Character
            tool = char and char:FindFirstChild(itemName)
            if not tool and LocalPlayer:FindFirstChild("Backpack") then
                tool = LocalPlayer.Backpack:FindFirstChild(itemName)
                if tool and hum then
                    hum:EquipTool(tool)
                end
            end
            if tool and tool.Parent == char then break end
            task.wait(0.1)
        end

        -- 2. [คำสั่งผู้ใช้]: ให้มันกดถือก่อน เเล้วกดกิน และรอหลอด Eating/Drinking โหลดจนจบ 100%
        if tool and char then
            hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                if tool.Parent ~= char then
                    hum:EquipTool(tool)
                    task.wait(0.25)
                end
                task.wait(0.4) -- จังหวะถือของในมือให้เห็นชัดเจน
                tool:Activate() -- กดกิน/ดื่ม
                
                -- ตรวจสอบและรอหลอด Progress Bar ใน PlayerGui.Bar.Main โหลดเสร็จสมบูรณ์
                local barGui = PlayerGui:FindFirstChild("Bar")
                local barMain = barGui and barGui:FindFirstChild("Main")
                
                -- รอจังหวะที่หลอดโหลดโผล่ขึ้นมา
                local barT0 = os.clock()
                local hasBarStarted = false
                while os.clock() - barT0 < 1.2 do
                    if barMain then
                        for _, child in ipairs(barMain:GetChildren()) do
                            if child:IsA("GuiObject") then
                                hasBarStarted = true
                                break
                            end
                        end
                    end
                    if hasBarStarted then break end
                    task.wait(0.08)
                end

                -- รอกิน/ดื่มจนกว่าหลอดโหลดจะหายไป (Sushi ใช้เวลา 5 วิ, Hot Cocoa 3 วิ)
                local maxWait = (itemName:lower():find("sushi") and 5.6) or (isFood and 5.4 or 3.8)
                local waitStart = os.clock()
                while os.clock() - waitStart < maxWait do
                    local isStillActive = false
                    if barMain then
                        for _, child in ipairs(barMain:GetChildren()) do
                            if child:IsA("GuiObject") then
                                isStillActive = true
                                break
                            end
                        end
                    end
                    if hasBarStarted and not isStillActive and (os.clock() - waitStart >= 2.0) then
                        break
                    end
                    task.wait(0.15)
                end

                task.wait(0.3)
                pcall(function() hum:UnequipTools() end)
            end
        else
            task.wait(1.5)
        end
    end)

    isConsumingItem = false
end

local function AutoEatThenDrink(targetPercent)
    targetPercent = targetPercent or 95
    if isConsumingItem then return end

    -- 1. [คำสั่งผู้ใช้]: กินข้าวก่อนจนเต็มหลอด (ทั้งสองหลอดเต็ม 100%)
    local hunger = GetPlayerHunger()
    if hunger and hunger < targetPercent then
        local eatLoopCount = 0
        while hunger and hunger < targetPercent and eatLoopCount < 8 do
            eatLoopCount = eatLoopCount + 1
            local food = FindAvailableFood()
            if not food then break end

            pcall(function()
                Notify({
                    Title = "EASY HUB",
                    Content = "🍣 [1/2] กำลังกิน " .. food .. " (" .. tostring(hunger) .. "% -> เต็มหลอด)...",
                    Duration = 2.5
                })
            end)

            ConsumeItemSafely(food, true)
            task.wait(0.5)
            hunger = GetPlayerHunger()
        end
    end

    task.wait(0.4)

    -- 2. [คำสั่งผู้ใช้]: ดื่มกาแฟ/โกโก้/น้ำจนเต็มหลอด (ทั้งสองหลอดเต็ม 100%)
    local energy = GetPlayerEnergy()
    if energy and energy < targetPercent then
        local drinkLoopCount = 0
        while energy and energy < targetPercent and drinkLoopCount < 8 do
            drinkLoopCount = drinkLoopCount + 1
            local drink = FindAvailableCoffee()
            if not drink then break end

            pcall(function()
                Notify({
                    Title = "EASY HUB",
                    Content = "☕ [2/2] กินข้าวแล้ว! กำลังดื่ม " .. drink .. " (" .. tostring(energy) .. "% -> เต็มหลอด)...",
                    Duration = 2.5
                })
            end)

            ConsumeItemSafely(drink, false)
            task.wait(0.5)
            energy = GetPlayerEnergy()
        end
    end
end

local function CheckAndAutoEat()
    if not isAutoEatAndDrinkEnabled or isConsumingItem then return end
    local hunger = GetPlayerHunger()
    local energy = GetPlayerEnergy()
    if (hunger and hunger <= 75) or (energy and energy <= 75) then
        AutoEatThenDrink(95)
    end
end

local function CheckAndAutoDrinkCoffee()
    CheckAndAutoEat()
end

