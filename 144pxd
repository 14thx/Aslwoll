local function DriveCarTo(destination, shouldContinueCheck)
    local myCar = GetNearbyPlayerVehicle(80)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")

    -- ตรวจสอบว่าตัวเรานั่งอยู่ในรถคนอื่นหรือไม่ ถ้าใช่ให้สละรถทันที!
    if hum and hum.Sit and hum.SeatPart then
        local currentVeh = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if currentVeh and not IsMyVehicle(currentVeh) then
            pcall(function()
                Notify({
                    Title = "EASY HUB",
                    Content = "⚠️ ตรวจพบว่านั่งรถคนอื่น! กำลังสละรถและเบิกรถตัวเอง...",
                    Duration = 2.0
                })
                hum.Sit = false
            end)
            task.wait(0.3)
            myCar = nil
        end
    end

    if not myCar or not IsMyVehicle(myCar) or not (hum and hum.Sit) then
        if not myCar or not IsMyVehicle(myCar) then
            myCar = EnsureCarAvailable()
        elseif hum then
            EnsurePlayerSeatedInCar(myCar)
        end
    end

    if not myCar or not hum or not root then return false end

    local seat = myCar:FindFirstChildWhichIsA("VehicleSeat", true)
    if not seat then return false end

    EnsurePlayerSeatedInCar(myCar)
    task.wait(0.1)
    -- อย่าปิด ProximityPromptService แบบ global: ถ้าฟาร์มหยุดกลางทางจะทำให้ผู้เล่นกด prompt ไม่ได้
    local currentPos = seat.Position
    local startY = currentPos.Y

    local initialGround = GetGroundLevel(currentPos.X, currentPos.Z, startY)
    local naturalRideHeight = math.clamp(startY - initialGround, 2.3, 3.2)

    local distTotal = (Vector2.new(destination.X, destination.Z) - Vector2.new(currentPos.X, currentPos.Z)).Magnitude
    if distTotal < 5 then return true end

    -- [คำสั่งผู้ใช้]: ปรับความเร็วได้จริง ดึงค่าจาก Slider หรือตัวแปร VehicleDriveSpeed แบบเรียลไทม์
    local traveled = 0
    local lastTick = os.clock()
    local lastGraceRefresh = 0
    local lastGroundRefresh = 0
    local cachedGroundY = initialGround

    while traveled < distTotal do
        if shouldContinueCheck and not shouldContinueCheck() then
            return false
        end

        local now = os.clock()
        if now - lastGraceRefresh >= 5 then
            GrantAntiXGrace(15)
            lastGraceRefresh = now
        end

        if not hum.Sit or hum.SeatPart ~= seat then
            pcall(function()
                root.CFrame = seat.CFrame + Vector3.new(0, 0.8, 0)
                seat:Sit(hum)
            end)
        end

        -- ดึงความเร็วปัจจุบันจาก Slider แบบเรียลไทม์ทันทีขณะรถกำลังวิ่ง
        local currentSpeed = tonumber(VehicleDriveSpeed) or 200
        currentSpeed = math.clamp(currentSpeed, 10, 500)

        local dt = math.min(now - lastTick, 0.1)
        lastTick = now

        traveled = math.min(distTotal, traveled + (currentSpeed * dt))
        local alpha = math.clamp(traveled / distTotal, 0, 1)

        local targetX = currentPos.X + (destination.X - currentPos.X) * alpha
        local targetZ = currentPos.Z + (destination.Z - currentPos.Z) * alpha

        if now - lastGroundRefresh >= 0.12 then
            cachedGroundY = GetGroundLevel(targetX, targetZ, startY)
            lastGroundRefresh = now
        end
        local surfaceY = math.max(cachedGroundY + naturalRideHeight, 6.0)

        local dir = Vector3.new(destination.X - targetX, 0, destination.Z - targetZ)
        local lookCFrame = CFrame.new(targetX, surfaceY, targetZ)
        if dir.Magnitude > 0.1 then
            lookCFrame = CFrame.lookAt(Vector3.new(targetX, surfaceY, targetZ), Vector3.new(targetX, surfaceY, targetZ) + dir)
        end

        myCar:PivotTo(lookCFrame)
        -- ลดงานขับจากทุก Heartbeat เหลือราว 30 ครั้ง/วินาที เพื่อไม่ให้ UI/มือถือกระตุก
        task.wait(0.03)
    end

    -- จอดที่จุดหมายในฟาร์มอย่างนุ่มนวล
    local endGround = GetGroundLevel(destination.X, destination.Z, destination.Y)
    local finalSurfaceY = math.max(endGround + naturalRideHeight, 6.0)
    myCar:PivotTo(CFrame.new(destination.X, finalSurfaceY, destination.Z))
    task.wait(0.1)
    return true
end

