local function createFarmLoop(key, title, crops, craftFn)
    FarmToggleControls[key] = Tabs.Main:AddToggle("Toggle"..key, {
        Title = title, Default = false,
        Callback = function(v)
            if v then
                local check = RequestFarmSession(key)
                task.spawn(function()
                    local firstRun = true
                    while check() do
                        local need = false
                        for _, c in ipairs(crops) do
                            if GetPlayerInventoryCount(c) < 60 then need = true; break end
                        end
                        if need then
                            if firstRun then EnsureCarAvailable(TOWN_CAR_SPAWN); firstRun = false end
                            for _, c in ipairs(crops) do
                                if GetPlayerInventoryCount(c) < 60 then
                                    HarvestSingleCrop(c, 60, check)
                                    if not check() then break end
                                end
                            end
                        end
                        if not check() then break end
                        craftFn(check)
                        if not check() then break end
                        SellAtEconomyMarket(check)
                        if not check() then break end
                        task.wait(1.0)
                    end
                end)
            else StopFarmSession(key) end
        end
    })
end

