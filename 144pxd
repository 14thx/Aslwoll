-- 2. ขับรถไปจุดฟาร์มเหมือนคนปกติ รอ 2 วินาที เก็บรถเข้าตู้ เดินเข้าเสาฟาร์ม (HarvestSingleCrop)
-- 3. พอครบ 60 ชิ้น: เดินไปเบิกรถที่จุดฟาร์ม ขับไปขายที่ตลาดในเมือง (SellAtEconomyMarket) แล้ววนลูป
-- ==============================================================================
local cropDisplayNames = {
    Bread = "Bread (ขนมปัง)", Catchup = "Catchup (ซอสมะเขือเทศ)", Pig = "Pig (หมู)",
    Mango = "Mango (มะม่วง)", Rice = "Rice (ข้าว)", Tomato = "Tomato (มะเขือเทศ)",
    Banana = "Banana (กล้วย)", Crab = "Crab (ปู)", Coconut = "Coconut (มะพร้าว)",
}
local cropOptions = { "Bread", "Catchup", "Pig", "Mango", "Rice", "Tomato", "Banana", "Crab", "Coconut" }
local selectedIndividualCrop = Config.FarmIndividualCrop or "Bread"
Section(FarmIndividual, "เลือกพืชและเริ่มฟาร์ม")
local cropDropdown = FarmDropdown(FarmIndividual, {
    key = "FarmIndividualCrop",
    title = "เลือกพืช/ไอเทม",
    desc = "เลือก 1 รายการเพื่อฟาร์มเดี่ยว",
    values = cropOptions,
    display = cropDisplayNames,
    callback = function(value)
        selectedIndividualCrop = value
        pcall(function() Toast("เลือกฟาร์ม: " .. (cropDisplayNames[value] or value), true) end)
    end,
})

FarmToggleControls["IndividualMaster"] = Toggle(FarmIndividual, {
    key = "FarmIndividualEnabled",
    title = "เริ่ม/หยุดฟาร์มเดี่ยว",
    desc = "เลือกไอเทมด้านบน แล้วเก็บให้ครบ 60 ชิ้นก่อนขาย",
    callback = function(val)
        if val then
            local currentCrop = selectedIndividualCrop
            local check = RequestFarmSession("IndividualMaster")
            task.spawn(function()
                local isFirstRun = true
                while check() do
                    currentCrop = selectedIndividualCrop
                    local locData = TYPER_LOCATIONS[currentCrop]
                    if not locData then break end

                    -- 1. เริ่มเปิดฟังก์ชัน: วาปไปเบิกรถที่จุดในเมืองเสมอตามคำสั่ง
                    if isFirstRun then
                        pcall(function()
                            Notify({
                                Title = "EASY HUB",
                                Content = "🚗 เริ่มเปิดฟาร์ม " .. currentCrop .. ": กำลังไปเบิกรถที่จุดในเมือง...",
                                Duration = 3.0
                            })
                        end)
                        local carInTown = WarpToTownAndSpawnCar()
                        if not carInTown then
                            carInTown = SpawnCarAtBooth(TOWN_CAR_SPAWN) or EnsureCarAvailable(TOWN_CAR_SPAWN)
                        end
                        if carInTown then
                            EnsurePlayerSeatedInCar(carInTown)
                        end
                        isFirstRun = false
                    else
                        local myCar = GetPlayerVehicle()
                        if not myCar then
                            myCar = EnsureCarAvailable(TOWN_CAR_SPAWN)
                        end
                        if myCar then
                            EnsurePlayerSeatedInCar(myCar)
                        end
                    end

                    if not check() then break end

                    -- 2. ขับรถไปฟาร์มเหมือนคนปกติ รอ 2 วินาที เก็บรถเข้าตู้ เดินเข้าแปลงฟาร์มจนครบ 60 ชิ้น
                    pcall(function()
                        Notify({
                            Title = "EASY HUB",
                            Content = "🌾 ขับรถไปฟาร์ม " .. currentCrop .. "...",
                            Duration = 2.5
                        })
                    end)
                    HarvestSingleCrop(currentCrop, 60, check)

                    if not check() then break end

                    -- 3. พอฟาร์มครบ 60: เดินไปตู้เบิกรถที่จุดฟาร์ม เพื่อขับไปขายที่ตลาดในเมือง
                    pcall(function()
                        Notify({
                            Title = "EASY HUB",
                            Content = "🚗 ฟาร์ม " .. currentCrop .. " ครบ 60 แล้ว! เบิกรถที่ตู้ฟาร์มไปขายที่ตลาด...",
                            Duration = 3.0
                        })
                    end)

                    local carAtFarm = GetNearbyPlayerVehicle(80)
                    if not carAtFarm then
                        SmoothWalkTo(locData.Booth, 25, check, 1.2)
                        carAtFarm = SpawnCarAtBooth(locData.Booth) or EnsureCarAvailable(locData.Booth)
                    end
                    if carAtFarm then
                        EnsurePlayerSeatedInCar(carAtFarm)
                    end

                    -- ขับรถจากฟาร์มไปขายที่จุดขายในเมือง (Economy Market)
                    SellAtEconomyMarket(check)

                    if not check() then break end
                    task.wait(1.0)
                end
            end)
        else
            StopFarmSession("IndividualMaster")
        end
    end
})



