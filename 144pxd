local function GetExactFarmPromptPosition(cropName)
    local locData = TYPER_LOCATIONS[cropName]
    local farmSys = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Farm")
    local farmFolder = farmSys and farmSys:FindFirstChild(cropName)
    if farmFolder then
        for _, desc in ipairs(farmFolder:GetDescendants()) do
            if desc:IsA("ProximityPrompt") and desc.Enabled then
                local pName = desc.Parent and desc.Parent.Name:lower() or ""
                local action = (desc.ActionText or ""):lower()
                if not pName:find("spawn") and not action:find("spawn") and not action:find("car") then
                    local prParent = desc.Parent
                    local pPos = (prParent:IsA("Attachment") and prParent.WorldPosition) or (prParent:IsA("BasePart") and prParent.Position)
                    if pPos then return pPos end
                end
            end
        end
    end
    return locData and locData.Farm
end

local function TriggerFarmPromptDirectly(cropName)
    local farmSys = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Farm")
    local farmFolder = farmSys and farmSys:FindFirstChild(cropName)
    local targetPrompt = nil
    if farmFolder then
        for _, desc in ipairs(farmFolder:GetDescendants()) do
            if desc:IsA("ProximityPrompt") and desc.Enabled then
                local pName = desc.Parent and desc.Parent.Name:lower() or ""
                local action = (desc.ActionText or "").lower()
                if not pName:find("spawn") and not action:find("spawn") and not action:find("car") then targetPrompt = desc; break end
            end
        end
    end
    if targetPrompt then TriggerPrompt(targetPrompt); return true end
    return false
end

local function HarvestSingleCrop(cropName, targetAmount, shouldContinueCheck)
    targetAmount = 60
    local curCount = GetPlayerInventoryCount(cropName)
    if curCount >= targetAmount then return end
    local locData = TYPER_LOCATIONS[cropName]
    if not locData then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local myCar = GetPlayerVehicle() or EnsureCarAvailable(locData.Booth)
    if myCar then PressFToEnterCar(myCar) end
    local exactCenter = GetExactFarmPromptPosition(cropName) or locData.Farm
    local farmParkingPos = Vector3.new(exactCenter.X + 4.5, GetGroundLevel(exactCenter.X + 4.5, exactCenter.Z + 4.5, exactCenter.Y), exactCenter.Z + 4.5)
    pcall(function() if Fluent and Fluent.Notify then Fluent:Notify({ Title="NEXUS", Content="🚗 ไปฟาร์ม "..cropName, Duration=2 }) end end)
    DriveCarTo(farmParkingPos, shouldContinueCheck)
    task.wait(0.5)
    ExitCarNaturally(myCar)
    task.wait(0.5)
    if root then
        local gy = GetGroundLevel(exactCenter.X + 3, exactCenter.Z + 3, exactCenter.Y)
        root.CFrame = CFrame.lookAt(Vector3.new(exactCenter.X + 3, gy + 2.2, exactCenter.Z + 3), Vector3.new(exactCenter.X, gy + 2.2, exactCenter.Z))
    end
    task.wait(1.0)
    
    TriggerFarmPromptDirectly(cropName)
    task.wait(2.0)
    
    local farmTimeout = os.clock()
    while curCount < targetAmount do
        if shouldContinueCheck and not shouldContinueCheck() then break end
        if os.clock() - farmTimeout > 180 then break end
        GrantAntiXGrace(15)
        CheckAndAutoEat()
        
        local newCount = GetPlayerInventoryCount(cropName)
        if newCount > curCount then
            curCount = newCount
            farmTimeout = os.clock()
        elseif (os.clock() - farmTimeout > 20) and (newCount == curCount) then -- [ค่ากลาง] 20 วิ
            TriggerFarmPromptDirectly(cropName)
            farmTimeout = os.clock()
        end
        task.wait(1.0)
    end
    
    pcall(function() if Fluent and Fluent.Notify then Fluent:Notify({ Title="NEXUS", Content="🎉 "..cropName.." "..curCount.."/60", Duration=3 }) end end)
