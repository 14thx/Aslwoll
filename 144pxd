-- [Patch D] ไม่สุ่ม — ใช้ angle 0 ถ้าไม่มีคน
local function GetHumanLikeFarmStandingSpot(centerPos)
    local r = 3.8
    local occupied = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            local d = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(centerPos.X, 0, centerPos.Z)).Magnitude
            if d <= 10 then
                table.insert(occupied, math.atan2(hrp.Position.Z - centerPos.Z, hrp.Position.X - centerPos.X))
            end
        end
    end
    local bestAngle = 0
    if #occupied > 0 then
        local maxMin = -1
        for i = 0, 15 do
            local ta = (i / 16) * math.pi * 2
            local minD = math.pi
            for _, oa in ipairs(occupied) do
                local diff = math.abs(ta - oa)
                if diff > math.pi then diff = (math.pi * 2) - diff end
                if diff < minD then minD = diff end
            end
            if minD > maxMin then maxMin = minD; bestAngle = ta end
        end
    end
    local sx = centerPos.X + math.cos(bestAngle) * r
    local sz = centerPos.Z + math.sin(bestAngle) * r
    local gy = GetGroundLevel(sx, sz, centerPos.Y)
    return Vector3.new(sx, gy + 2.2, sz), bestAngle
end

