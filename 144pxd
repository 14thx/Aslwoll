local function SpawnCarAtBooth(boothPos)
    GrantAntiXGrace(40)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return nil end

    LAST_STORED_BOOTH = boothPos

    -- ปลดล็อค ProximityPromptService เสมอเพื่อป้องกันบั๊ก UI ค้าง
    pcall(function()
        game:GetService("ProximityPromptService").Enabled = true
    end)

    -- 1. ย้ายตัวละครมาหน้าตู้เบิกรถอย่างราบรื่น
    if boothPos then
        local groundY = GetGroundLevel(boothPos.X, boothPos.Z, boothPos.Y)
        root.CFrame = CFrame.new(boothPos.X, groundY + 1.2, boothPos.Z)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.4)
    end

    -- 2. ค้นหา ProximityPrompt ตู้เบิกรถ
    local boothPrompt = nil
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            local obj = (desc.ObjectText or ""):upper()
            local act = (desc.ActionText or ""):upper()
            if obj:find("SPAWN CAR") or obj:find("CAR") or act:find("SPAWN") or act:find("CAR") or act:find("เบิก") then
                local prParent = desc.Parent
                local pPos = (prParent:IsA("Attachment") and prParent.WorldPosition) or (prParent:IsA("BasePart") and prParent.Position)
                if pPos and root and (pPos - root.Position).Magnitude <= 30 then
                    boothPrompt = desc
                    break
                end
            end
        end
    end
    if not boothPrompt then
        boothPrompt = FindPromptNear(root.Position, 25, nil)
    end

    -- 3. [เปิด UI ขึ้นมา]: กด ProximityPrompt ตู้เบิกรถ
    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "🚗 กำลังเปิดหน้าต่างเบิกรถ...",
            Duration = 2.0
        })
    end)
    if boothPrompt then
        boothPrompt.Enabled = true
        local holdTime = math.max((boothPrompt.HoldDuration or 0.1), 0.15) + 0.12
        pcall(function() boothPrompt:InputHoldBegin() end)
        task.wait(holdTime)
        pcall(function() boothPrompt:InputHoldEnd() end)
    end
    task.wait(0.6)

    -- 4. ตรวจสอบ UI Car_Spawn
    local cs = PlayerGui:FindFirstChild("Car_Spawn")
    local group = cs and cs:FindFirstChild("Group")

    if (not group or not group.Visible) and boothPrompt then
        boothPrompt.Enabled = true
        pcall(function() boothPrompt:InputHoldBegin() end)
        task.wait(0.25)
        pcall(function() boothPrompt:InputHoldEnd() end)
        task.wait(0.6)
        cs = PlayerGui:FindFirstChild("Car_Spawn")
        group = cs and cs:FindFirstChild("Group")
    end

    if group and group.Visible then
        local sf = group:FindFirstChild("Main") and group.Main:FindFirstChild("Carlist") and group.Main.Carlist:FindFirstChild("ScrollingFrame")
        local targetCard = nil
        if sf then
            targetCard = sf:FindFirstChild("Buggy")
            if not targetCard then
                for _, ch in ipairs(sf:GetChildren()) do
                    if ch:IsA("GuiObject") and (ch:FindFirstChild("Spawn") or ch:FindFirstChild("Pound")) then
                        targetCard = ch
                        break
                    end
                end
            end
        end

        local poundBtn = (targetCard and targetCard:FindFirstChild("Pound")) or FindPoundButton(group)
        local spawnBtn = (targetCard and targetCard:FindFirstChild("Spawn")) or FindBlueSpawnButton(group)
        local cName = (targetCard and targetCard.Name) or "Buggy"

        -- [คำสั่งผู้ใช้]: ถ้ามาเบิกรถเเล้วขึ้นว่า pound กด 1 ทีเเล้วจะเปลี่ยนเป็น spawn
        if poundBtn and poundBtn.Visible then
            pcall(function()
                Notify({
                    Title = "EASY HUB",
                    Content = "📦 รถยังอยู่ข้างนอก กดปุ่ม POUND 1 ทีเพื่อดึงรถกลับ...",
                    Duration = 2.0
                })
            end)

            ClickGuiButton(poundBtn)
            pcall(function()
                local remCore = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Modules") and ReplicatedStorage.Systems.Modules:FindFirstChild("Core") and ReplicatedStorage.Systems.Modules.Core:FindFirstChild("Remotes")
                if remCore then
                    local Remotes_m = require(remCore)
                    Remotes_m.Fire("_carspawn", "Despawn", cName)
                end
            end)

            -- รอให้ปุ่มเปลี่ยนเป็น spawn
            local tWaitSpawn = os.clock()
            while os.clock() - tWaitSpawn < 4.5 do
                task.wait(0.2)
                if (spawnBtn and spawnBtn.Visible) or (targetCard and targetCard:FindFirstChild("Spawn") and targetCard.Spawn.Visible) then
                    break
                end
            end
            if targetCard and targetCard:FindFirstChild("Spawn") then
                spawnBtn = targetCard.Spawn
            end
        end

        -- [คำสั่งผู้ใช้]: เเละกด spawn เเล้วรอให้รถลงมาเเล้วไปฟาม ถ้ามี spawn ก็เบิกรถไปฟามตามปกติ
        if spawnBtn and spawnBtn.Visible then
            pcall(function()
                Notify({
                    Title = "EASY HUB",
                    Content = "⚡ กดปุ่ม SPAWN เบิกรถ (" .. tostring(cName) .. ")...",
                    Duration = 2.0
                })
            end)

            ClickGuiButton(spawnBtn)
            task.wait(1.0)

            -- [ตามคำสั่งผู้ใช้]: ถ้าไม่มีรถเกิด ให้กดย้ำ 2 ที
            local checkCar = GetNearbyPlayerVehicle(80) or GetPlayerVehicle()
            if not checkCar or not checkCar.PrimaryPart then
                for repeatIdx = 1, 2 do
                    pcall(function()
                        Notify({
                            Title = "EASY HUB",
                            Content = "⚡ ยังไม่มีรถเกิด กดย้ำปุ่ม SPAWN ครั้งที่ " .. tostring(repeatIdx) .. "/2...",
                            Duration = 1.5
                        })
                    end)
                    ClickGuiButton(spawnBtn)
                    task.wait(1.0)
                    checkCar = GetNearbyPlayerVehicle(80) or GetPlayerVehicle()
                    if checkCar and checkCar.PrimaryPart then
                        break
                    end
                end
            end
        end
    end

    -- 5. [รอให้รถลงมา]: รอจนกว่ารถจะเบิกเสร็จและตกลงมาที่ลานจอด (ห้ามดึงรถมาเองเด็ดขาด ให้กด spawn ใน UI เท่านั้น)
    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "⏳ กำลังรอให้รถสปาวลงมาที่ลานจอดตามระบบเกม...",
            Duration = 2.5
        })
    end)
    local finalCar = nil
    local tCar = os.clock()
    while os.clock() - tCar < 6.0 do
        finalCar = GetNearbyPlayerVehicle(80) or GetPlayerVehicle()
        if finalCar and finalCar.PrimaryPart then
            break
        end
        task.wait(0.2)
    end

    -- 6. เมื่อรถสปาวลงมาแล้ว ให้รอ 2 วินาทีตามที่ระบุ ก่อนขึ้นขับไปฟาร์ม
    if finalCar then
        for cd = 2, 1, -1 do
            pcall(function()
                Notify({
                    Title = "EASY HUB",
                    Content = "⏳ รถลงมาเรียบร้อยแล้ว รอเวลา " .. tostring(cd) .. " วินาทีก่อนออกเดินทาง...",
                    Duration = 1.0
                })
            end)
            task.wait(1.0)
        end

        CloseCarSpawnGui()
        task.wait(0.2)

        -- ขึ้นนั่งบนเบาะคนขับ (ห้ามดึงรถมาหาคน ให้คนเดิน/ขึ้นนั่งที่รถปกติ)
        EnsurePlayerSeatedInCar(finalCar)
        task.wait(0.4)
        return finalCar
    else
        CloseCarSpawnGui()
    end

    return finalCar
end

local function WarpToTownAndSpawnCar()
    GrantAntiXGrace(45)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    -- ลุกออกจากเก้าอี้เสมอ เพื่อเบิกรถคันใหม่
    if hum and hum.Sit then
        hum.Sit = false
        task.wait(0.15)
    end

    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "🚀 วาปไปจุดเบิกรถในเมืองเพื่อเบิกรถใหม่...",
            Duration = 2.0
        })
    end)

    pcall(function()
        game:GetService("ProximityPromptService").Enabled = true
    end)

    pcall(function()
        LocalPlayer:RequestStreamAroundAsync(TOWN_CAR_SPAWN, 45)
    end)

    -- วาปไปที่หน้าตู้เบิกรถในเมืองเท่านั้น
    local groundY = GetGroundLevel(TOWN_CAR_SPAWN.X, TOWN_CAR_SPAWN.Z, TOWN_CAR_SPAWN.Y)
    local townPos = Vector3.new(TOWN_CAR_SPAWN.X, groundY + 1.2, TOWN_CAR_SPAWN.Z)
    root.CFrame = CFrame.new(townPos)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    task.wait(0.4)

    -- สั่งเบิกรถผ่านตู้ในเมืองตามสเต็ป POUND -> SPAWN
    local car = SpawnCarAtBooth(TOWN_CAR_SPAWN)
    if not car then
        car = GetNearbyPlayerVehicle(80)
    end
    if car then
        EnsurePlayerSeatedInCar(car)
        CloseCarSpawnGui()
    end
    return car
end

local function SpawnCarInTown()
    return WarpToTownAndSpawnCar()
end

local function EnsureCarAvailable(boothPos)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local targetBooth = boothPos or (root and GetNearestCarBooth(root.Position)) or TOWN_CAR_SPAWN

    -- ตรวจสอบรถของตัวเองในระยะ 80 สตั๊ด
    local nearbyCar = GetNearbyPlayerVehicle(80)
    if nearbyCar and nearbyCar.PrimaryPart and IsMyVehicle(nearbyCar) then
        EnsurePlayerSeatedInCar(nearbyCar)
        return nearbyCar
    end

    -- เบิกรถของตัวเองผ่านตู้เบิกรถมาตรฐาน (POUND -> SPAWN -> รอรถลงมา -> ขึ้นรถตัวเอง)
    local car = SpawnCarAtBooth(targetBooth)
    if not car or not IsMyVehicle(car) then
        car = SpawnCarAtBooth(TOWN_CAR_SPAWN)
    end
    if car and IsMyVehicle(car) then
        EnsurePlayerSeatedInCar(car)
    end
    return car
end

local function SpawnCarAtNearestBooth(pos)
    pos = pos or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position) or TOWN_CAR_SPAWN
    local booth = GetNearestCarBooth(pos)
    return EnsureCarAvailable(booth)
end




