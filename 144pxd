local function EnsureVehiclePlatform(surfaceY, carPos)
    if not isVehiclePlatformEnabled then
        if vehiclePlatformPart then vehiclePlatformPart:Destroy(); vehiclePlatformPart = nil end
        return
    end
    if not vehiclePlatformPart or not vehiclePlatformPart.Parent then
        local p = Instance.new("Part")
        p.Name = "TyperTown_VehicleSafePlatform"
        p.Size = Vector3.new(35, 1.5, 35)
        p.Anchored = true
        p.CanCollide = true
        p.Transparency = 1
        p.Parent = workspace
        vehiclePlatformPart = p
    end
    vehiclePlatformPart.CFrame = CFrame.new(carPos.X, surfaceY - 0.75, carPos.Z)
end

local function SetVehicleAltitude(newOffset)
    VehicleHeightOffset = tonumber(newOffset) or 0
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    if hum and hum.Sit and seat then
        local myCar = seat:FindFirstAncestorOfClass("Model")
        if myCar then
            local seatPos = seat.Position
            local groundY = GetGroundLevel(seatPos.X, seatPos.Z, seatPos.Y)
            local targetCarY = groundY + 2.8 + VehicleHeightOffset
            local curPivot = myCar:GetPivot()
            myCar:PivotTo(CFrame.new(curPivot.Position.X, targetCarY, curPivot.Position.Z) * curPivot.Rotation)
        end
    end
end

RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Sit and hum.SeatPart then
        local myCar = hum.SeatPart:FindFirstAncestorOfClass("Model")
