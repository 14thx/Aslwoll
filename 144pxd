local function GetEconomyMarketPosition()
    -- 1. ค้นหาจาก ProximityPrompt ของ Economy หรือ Ecconomy ใน Workspace โดยตรง
    local systems = workspace:FindFirstChild("Systems")
    local containers = systems and {systems, workspace} or {workspace}
    for _, container in ipairs(containers) do
        for _, p in ipairs(container:GetDescendants()) do
            if p:IsA("ProximityPrompt") and p.Enabled then
                local act = (p.ActionText or ""):lower()
                local obj = (p.ObjectText or ""):lower()
                local pName = p.Name:lower()
                local parentName = p.Parent and p.Parent.Name:lower() or ""
                if act:find("econ") or obj:find("econ") or pName:find("econ") or parentName:find("econ") then
                    local par = p.Parent
                    local pPos = (par:IsA("Attachment") and par.WorldPosition)
                              or (par:IsA("BasePart") and par.Position)
                              or (par.Parent and par.Parent:IsA("BasePart") and par.Parent.Position)
                    if pPos then
                        return pPos, p
                    end
                end
            end
        end
    end

    -- 2. ค้นหา Model/NPC ชื่อ Economy หรือ Ecconomy ในเมือง
    local ecoModel = (workspace:FindFirstChild("Systems") and (workspace.Systems:FindFirstChild("Economy") or workspace.Systems:FindFirstChild("Ecconomy"))) 
                  or workspace:FindFirstChild("Economy") or workspace:FindFirstChild("Ecconomy")
    if ecoModel then
        local p = ecoModel:FindFirstChildWhichIsA("ProximityPrompt", true)
        if p then
            local par = p.Parent
            local pPos = (par:IsA("Attachment") and par.WorldPosition) or (par:IsA("BasePart") and par.Position)
            if pPos then return pPos, p end
        end
        local part = ecoModel:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.Position, nil end
    end

    -- 3. ใช้พิกัดมาตรฐานจุดขายในเมืองจาก MapLocations: X = -462.0, Z = 5324.7 (ไม่ใช่บนหลังคาเด็ดขาด 100%)
    local townX, townZ = -462.0, 5324.7
    local townY = GetGroundLevel(townX, townZ, 17.5)
    return Vector3.new(townX, townY + 1.2, townZ), nil
end

local function SellAtEconomyMarket(shouldContinueCheck)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    local marketPos, directPrompt = GetEconomyMarketPosition()
    marketPos = marketPos or TYPER_LOCATIONS.Economy.Market

    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "🚗 ขับรถไปขายของที่จุดขายในเมือง (Economy Market)...",
            Duration = 3.0
        })
    end)

    -- ตรวจสอบและขึ้นรถเสมอ ขับรถไปขายทุกกรณี ไม่เดินเด็ดขาด (เฉพาะรถตัวเอง 100%)
    local myCar = GetPlayerVehicle()
    if not myCar or not (hum and hum.Sit) then
        if not myCar then
            myCar = EnsureCarAvailable(TOWN_CAR_SPAWN)
        end
        if myCar then
            EnsurePlayerSeatedInCar(myCar)
        end
    end

    if not myCar then
        myCar = EnsureCarAvailable(TOWN_CAR_SPAWN)
    end
    if myCar then
        EnsurePlayerSeatedInCar(myCar)
    end

    -- ขับรถตรงมายังจุดขายในเมือง (Economy)
    DriveCarTo(marketPos, shouldContinueCheck)
    task.wait(0.3)
    if shouldContinueCheck and not shouldContinueCheck() then return end

    -- ถึงจุดขายในเมืองแล้ว ลงจากรถอย่างเป็นธรรมชาติข้างประตูรถ
    ExitCarNaturally(myCar)

    -- เดินมายืนหน้า NPC ในระยะ 3 สตั๊ด
    local finalMarketPos, promptFound = GetEconomyMarketPosition()
    local targetPos = finalMarketPos or marketPos
    if root then
        local gY = GetGroundLevel(targetPos.X, targetPos.Z, targetPos.Y)
        root.CFrame = CFrame.lookAt(Vector3.new(targetPos.X + 2.5, gY + 2.2, targetPos.Z), targetPos)
        root.AssemblyLinearVelocity = Vector3.zero
    end
    task.wait(0.2)

    -- กด ProximityPrompt ของ Economy NPC
    local econPrompt = promptFound or directPrompt or FindPromptNear(root.Position, 25, "econ") or FindPromptNear(targetPos, 25, nil)
    if econPrompt then
        local holdTime = math.max((econPrompt.HoldDuration or 0.1), 0.15) + 0.1
        pcall(function() econPrompt:InputHoldBegin() end)
        task.wait(holdTime)
        pcall(function() econPrompt:InputHoldEnd() end)
    end
    task.wait(0.4)

    -- สั่งขายสินค้าทั้งหมดผ่าน Remote
    pcall(function()
        local remCore = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Modules") and ReplicatedStorage.Systems.Modules:FindFirstChild("Core") and ReplicatedStorage.Systems.Modules.Core:FindFirstChild("Remotes")
        if remCore then
            local Remotes_m = require(remCore)
            Remotes_m.Invoke("_economy", "SellAll")
            Remotes_m.Fire("_economy", "SellAll")
        else
            local rem = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Remotes")
            if rem and rem:FindFirstChild("_economy") then
                rem._economy:FireServer("SellAll")
            end
        end
    end)

    -- กดปุ่ม SellAll / SELL ALL ในหน้าต่าง UI Economy หากเปิดขึ้นมา
    pcall(function()
        local eg = PlayerGui:FindFirstChild("Economy") or PlayerGui:FindFirstChild("Ecconomy")
        if eg and eg:FindFirstChild("Group") then
            local main = eg.Group:FindFirstChild("Main") or eg.Group
            local sellBtn = main:FindFirstChild("Sell_All", true) 
                         or main:FindFirstChild("SellAll", true) 
                         or main:FindFirstChild("Sell", true)
            if not sellBtn then
                for _, b in ipairs(main:GetDescendants()) do
                    if b:IsA("GuiButton") and (b.Name:lower():find("sell") or (b:IsA("TextButton") and b.Text:lower():find("sell"))) then
                        sellBtn = b
                        break
                    end
                end
            end
            if sellBtn and sellBtn:IsA("GuiButton") then
                SafeClickGuiButton(sellBtn)
            end
        end
    end)
    task.wait(1.0)

    -- ปิดหน้าต่าง UI Economy
    pcall(function()
        local eg = PlayerGui:FindFirstChild("Economy") or PlayerGui:FindFirstChild("Ecconomy")
        if eg and eg:FindFirstChild("Group") then
            local main = eg.Group:FindFirstChild("Main")
            local exitBtn = main and (main:FindFirstChild("Exit", true) or main:FindFirstChild("Close", true))
            if exitBtn and exitBtn:IsA("GuiButton") then
                SafeClickGuiButton(exitBtn)
            end
            eg.Group.Visible = false
        end
    end)

    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "💰 ขายสินค้าทั้งหมดที่จุดขายในเมืองเรียบร้อย!",
            Duration = 3.0
        })
    end)
    task.wait(0.3)

    -- ตรวจสอบและออโต้กินข้าว+กาแฟจนเต็มหลอดก่อนขึ้นรถถ้าค่าต่ำกว่า 75%
    if isAutoEatAndDrinkEnabled then
        local h = GetPlayerHunger()
        local e = GetPlayerEnergy()
        if (h and h <= 75) or (e and e <= 75) then
            AutoEatThenDrink(95)
        end
    end

    -- [คำสั่งผู้ใช้]: พอขายเสร็จให้มัน กด F ขึ้นรถคนขับปกติ
    local carAfterSell = GetNearbyPlayerVehicle(80) or EnsureCarAvailable(TOWN_CAR_SPAWN)
    if carAfterSell then
        PressFToEnterCar(carAfterSell)
    end
    task.wait(0.2)
end

