local function TriggerPrompt(prompt)
    if not prompt or not prompt.Enabled then return end
    pcall(function()
        prompt:InputHoldBegin()
        task.wait((prompt.HoldDuration or 0.1) + 0.1)
        prompt:InputHoldEnd()
    end)
    task.wait(0.3)
end

local function ClickGuiButton(btn)
