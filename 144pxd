-- ==== GRACE / GROUND ====
local function GrantAntiXGrace(sec)
    sec = sec or 25
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local af = char:FindFirstChild("Antifall") or char:FindFirstChild("AntiFall")
        if af and af:IsA("Script") then af.Disabled = true end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root:SetAttribute("TeleportGrace", os.clock() + sec)
            root:SetAttribute("AntiFallGrace", os.clock() + sec)
            root:SetAttribute("VehicleGrace", os.clock() + sec)
            root:SetAttribute("IgnoreAntiCheat", true)
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end
    end)
end

local function GetGroundLevel(x, z, fallbackY)
    fallbackY = fallbackY or 20
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = false
    local filter = {}
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    local veh = (workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Vehicles")) or workspace:FindFirstChild("Vehicles")
    if veh then table.insert(filter, veh) end
    if MY_SPAWNED_CAR then table.insert(filter, MY_SPAWNED_CAR) end
    if vehiclePlatformPart then table.insert(filter, vehiclePlatformPart) end
    if fishingPlatform then table.insert(filter, fishingPlatform) end
    params.FilterDescendantsInstances = filter
    local r = workspace:Raycast(Vector3.new(x, math.max((fallbackY or 20) + 80, 220), z), Vector3.new(0, -550, 0), params)
    return r and r.Position.Y or fallbackY
end

