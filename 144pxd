local function GetNearestCarBooth(fromPos)
    fromPos = fromPos or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position) or TOWN_CAR_SPAWN
    local closestPos = nil
    local closestDist = math.huge

    -- 1. ตรวจสอบจาก TYPER_LOCATIONS ก่อนเสมอ เพราะมีพิกัดตู้เบิกรถที่แท้จริงและแม่นยำ 100%
    if TYPER_LOCATIONS then
        for cropName, data in pairs(TYPER_LOCATIONS) do
            if data and data.Booth then
                local d = (data.Booth - fromPos).Magnitude
                if d < closestDist then
                    closestDist = d
                    closestPos = data.Booth
                end
            end
        end
    end

    -- 2. ตรวจสอบจากใน workspace.Systems.Farm
    local farmSys = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Farm")
    if farmSys then
        for _, cropFolder in ipairs(farmSys:GetChildren()) do
            local promptFolder = cropFolder:FindFirstChild("Prompt")
            local spawnFolder = promptFolder and promptFolder:FindFirstChild("Spawn")
            if spawnFolder then
                local part = spawnFolder:FindFirstChild("Prompt") or spawnFolder:FindFirstChildWhichIsA("BasePart", true)
                local pos = part and (part:IsA("BasePart") and part.Position or (part:IsA("Attachment") and part.WorldPosition))
                if pos then
                    local d = (pos - fromPos).Magnitude
                    if d < closestDist then
                        closestDist = d
                        closestPos = pos
                    end
                end
            end
        end
    end

    -- 3. ตรวจสอบตู้ในเมือง TOWN_CAR_SPAWN
    if TOWN_CAR_SPAWN then
        local d = (TOWN_CAR_SPAWN - fromPos).Magnitude
        if d < closestDist then
            closestDist = d
            closestPos = TOWN_CAR_SPAWN
        end
    end

    return closestPos or TOWN_CAR_SPAWN
end

