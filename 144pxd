                pcall(function()
                    toggleObj:Set(false)
                end)
            end
        end
    end)

    pcall(function()
        Notify({
            Title = "EASY HUB",
            Content = "🔒 สลับไปทำงาน: " .. tostring(farmKey) .. " (ปิดฟังก์ชันอื่นอัตโนมัติ)",
            Duration = 2.0
        })
    end)

    return function()
        return CurrentFarmSessionId == thisSession and CurrentActiveFarmKey == farmKey
    end
end

local function StopFarmSession(farmKey)
    if CurrentActiveFarmKey == farmKey then
        CurrentFarmSessionId = CurrentFarmSessionId + 1
        CurrentActiveFarmKey = nil
    end
    task.spawn(function()
        task.wait(0.2)
        local anyActive = false
        for _, tObj in pairs(FarmToggleControls) do
            if tObj and tObj.Get and tObj:Get() then
                anyActive = true
