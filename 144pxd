local function FindPromptNear(centerPos, maxDist, kw)
    maxDist = maxDist or 25
    local closest, closestDist = nil, maxDist
    local systems = workspace:FindFirstChild("Systems")
    local containers = systems and {systems} or {workspace}
    for _, c in ipairs(containers) do
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("ProximityPrompt") and p.Enabled then
                local pp = p.Parent
                local pos = pp and ((pp:IsA("BasePart") and pp.Position) or (pp:IsA("Attachment") and pp.WorldPosition))
                if pos then
                    local d = (pos - centerPos).Magnitude
                    if d <= closestDist then
                        if not kw or (p.ActionText and p.ActionText:lower():find(kw:lower())) then
                            closest, closestDist = p, d
                        end
                    end
                end
            end
        end
    end
    return closest
end

