local function GetPlayerHunger()
    local hud = PlayerGui:FindFirstChild("HUD")
    local hFrame = hud and hud:FindFirstChild("Health") and hud.Health:FindFirstChild("Hunger")
    if hFrame then
        local tLabel = hFrame:FindFirstChildWhichIsA("TextLabel", true)
        if tLabel then
            local val = tonumber(string.match(tLabel.Text, "%d+"))
            if val then return val end
        end
    end
    local pd = LocalPlayer:FindFirstChild("PlayerData") or LocalPlayer:FindFirstChild("Stats") or LocalPlayer:FindFirstChild("DataStats")
    if pd then
        local hv = pd:GetAttribute("Hunger") or (pd:FindFirstChild("HungerVal") and pd.HungerVal.Value) or pd:GetAttribute("Food")
        if typeof(hv) == "number" then return hv end
    end
    return 100
end

local function GetPlayerEnergy()
    local hud = PlayerGui:FindFirstChild("HUD")
    if hud and hud:FindFirstChild("Health") then
        local eFrame = hud.Health:FindFirstChild("Energy") 
                    or hud.Health:FindFirstChild("Stamina") 
                    or hud.Health:FindFirstChild("Thirst") 
                    or hud.Health:FindFirstChild("Coffee")
                    or hud.Health:FindFirstChild("Brain")
        if eFrame then
            local tLabel = eFrame:FindFirstChildWhichIsA("TextLabel", true)
            if tLabel then
                local val = tonumber(string.match(tLabel.Text, "%d+"))
                if val then return val end
            end
        end
    end
    local pd = LocalPlayer:FindFirstChild("PlayerData") or LocalPlayer:FindFirstChild("Stats") or LocalPlayer:FindFirstChild("DataStats")
    if pd then
        local ev = pd:GetAttribute("Energy") or pd:GetAttribute("Stamina") or pd:GetAttribute("Thirst") or (pd:FindFirstChild("ThirstVal") and pd.ThirstVal.Value)
        if typeof(ev) == "number" then return ev end
    end
    return 100
end

local function FindAvailableFood()
    local pd = LocalPlayer:FindFirstChild("PlayerData")
    local itemFolder = LocalPlayer:FindFirstChild("Item")
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character

    local foodCandidates = {
        "RiceKapaoMoo", "MangoRice", "Rice", "Sushi", "Sandwish",
        "Burger", "Bread", "Watermelon", "Curry", "Ramen", "Onigiri"
    }

    for _, food in ipairs(foodCandidates) do
        if pd then
            local count = pd:GetAttribute(food)
            if typeof(count) == "number" and count > 0 then return food end
        end
        if itemFolder and itemFolder:FindFirstChild(food) and itemFolder[food].Value > 0 then
            return food
        end
        if bp and bp:FindFirstChild(food) then return food end
        if char and char:FindFirstChild(food) then return food end
    end

    if pd then
        for attr, val in pairs(pd:GetAttributes()) do
            if typeof(val) == "number" and val > 0 then
                local low = attr:lower()
                if low:find("rice") or low:find("khao") or low:find("food") or low:find("kapao") or low:find("sushi") or low:find("sandwich") or low:find("burger") then
                    return attr
                end
            end
        end
    end
    return nil
end

