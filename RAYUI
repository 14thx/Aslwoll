local function GetExactFarmPromptPosition(cropName)
    local farmSys = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Farm")
    if not farmSys then return nil end
    local cropFolder = farmSys:FindFirstChild(cropName)
    if not cropFolder then return nil end
    local promptFolder = cropFolder:FindFirstChild("Prompt")
    local spawnFolder = promptFolder and promptFolder:FindFirstChild("Spawn")
    if spawnFolder then
        local part = spawnFolder:FindFirstChild("Prompt") or spawnFolder:FindFirstChildWhichIsA("BasePart", true)
        if part then
            return (part:IsA("BasePart") and part.Position) or (part:IsA("Attachment") and part.WorldPosition)
        end
    end
    return nil
end

local function GetHumanLikeFarmStandingSpot(exactCenter)
    local angles = { 0, math.pi/4, -math.pi/4, math.pi/2, -math.pi/2, 3*math.pi/4, -3*math.pi/4, math.pi }
    local radius = 4.5
    for _, angle in ipairs(angles) do
        local offset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
        local standPos = exactCenter + offset
        local groundY = GetGroundLevel(standPos.X, standPos.Z, exactCenter.Y)
        if math.abs(groundY - exactCenter.Y) < 3 then
            return Vector3.new(standPos.X, groundY + 2.2, standPos.Z), angle
        end
    end
    local groundY = GetGroundLevel(exactCenter.X + radius, exactCenter.Z, exactCenter.Y)
    return Vector3.new(exactCenter.X + radius, groundY + 2.2, exactCenter.Z), 0
end

local function TriggerFarmPromptDirectly(cropName)
    local farmSys = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Farm")
    if not farmSys then return end
    local cropFolder = farmSys:FindFirstChild(cropName)
    if not cropFolder then return end
    for _, desc in ipairs(cropFolder:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            TriggerPrompt(desc)
            return
        end
    end
end

