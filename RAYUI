    local vehFolder = (workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Vehicles")) or workspace:FindFirstChild("Vehicles")
    if vehFolder then
        local t0 = os.clock()
        while os.clock() - t0 < 6 do
            for _, v in ipairs(vehFolder:GetChildren()) do
                if v:IsA("Model") and v.PrimaryPart and IsMyVehicle(v) then
                    if (v.PrimaryPart.Position - boothPos).Magnitude < 50 then MY_SPAWNED_CAR = v return v end
                end
            end
