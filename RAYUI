        if remCore then require(remCore).Fire("_process", "Start", oreName) end
    end)
    
    local tProc = os.clock()
    while (GetPlayerInventoryCount(oreName) >= (requiredMin or 2)) and (os.clock() - tProc < 180) do
        if shouldContinueCheck and not shouldContinueCheck() then break end
        task.wait(3.2)
    end
    
    pcall(function()
        local remCore = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Modules") and ReplicatedStorage.Systems.Modules:FindFirstChild("Core") and ReplicatedStorage.Systems.Modules.Core:FindFirstChild("Remotes")
        if remCore then require(remCore).Fire("_process", "Stop") end
    end)
    
    pcall(function()
        local procGui = PlayerGui:FindFirstChild("Process")
        if procGui and procGui:FindFirstChild("Group") then
            local exitBtn = procGui.Group:FindFirstChild("Exit", true)
            if exitBtn then SafeClickGuiButton(exitBtn) end
            procGui.Group.Visible = false
        end
    end)
    Notify("NEXUS HUB", "✅ หลอมแร่เสร็จเรียบร้อย!", "Success")
    task.wait(1.0)
end

local function ProcessBananaAtStation(shouldContinueCheck)
    local pos = TYPER_LOCATIONS.Food.BananaProcess
    FlyToPosition(pos, shouldContinueCheck)
    task.wait(0.5)
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then root.CFrame = CFrame.lookAt(pos + Vector3.new(0, 3.0, 2.5), pos) end
    task.wait(0.2)
    
    local prompt = FindPromptNear(root.Position, 20)
    if prompt then TriggerPrompt(prompt) task.wait(0.5) end
    
    local tProc = os.clock()
    while (GetPlayerInventoryCount("Banana") >= 2) and (os.clock() - tProc < 120) do
        if shouldContinueCheck and not shouldContinueCheck() then break end
        task.wait(2.0)
    end
    
    pcall(function()
        local procGui = PlayerGui:FindFirstChild("Process")
        if procGui and procGui:FindFirstChild("Group") then
            local exitBtn = procGui.Group:FindFirstChild("Exit", true)
            if exitBtn then SafeClickGuiButton(exitBtn) end
            procGui.Group.Visible = false
        end
    end)
    Notify("NEXUS HUB", "✅ แปรรูปกล้วยเสร็จเรียบร้อย!", "Success")
    task.wait(1.0)
end

local function DepositAllToVault(shouldContinueCheck)
    FlyToPosition(TYPER_LOCATIONS.Vault, shouldContinueCheck)
    task.wait(0.5)
    
    pcall(function()
        local remCore = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Modules") and ReplicatedStorage.Systems.Modules:FindFirstChild("Core") and ReplicatedStorage.Systems.Modules.Core:FindFirstChild("Remotes")
        if remCore then
            local Remotes_m = require(remCore)
            local pData = LocalPlayer:FindFirstChild("PlayerData")
            if pData then
                for attrName, _ in pairs(pData:GetAttributes()) do
                    local count = GetPlayerInventoryCount(attrName)
                    if count > 0 then
                        pcall(function() Remotes_m.Invoke("_vault_tx", "Deposit", attrName, count) end)
                        task.wait(0.15)
                    end
                end
            end
        end
    end)
    Notify("NEXUS HUB", "✅ เก็บของเข้าตู้เซฟเรียบร้อย!", "Success")
    task.wait(0.5)
end

