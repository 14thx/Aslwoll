-- ==============================================================================
-- SERVER HOP
-- ==============================================================================
local function HopServer(reason)
    if isHopping then return end
    isHopping = true
    pcall(function()
        local qot = queue_on_teleport or (syn and syn.queue_on_teleport)
        if qot and getgenv().NexusLoaderCode then qot(getgenv().NexusLoaderCode) end
    end)
    task.wait(0.5)
    local reqFn = (syn and syn.request) or (http and http.request) or http_request or request
    local hopped = false
    if reqFn then
        pcall(function()
            local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=25", string.format("%.0f", game.PlaceId))
            local resp = reqFn({ Url = url, Method = "GET" })
            if resp and resp.StatusCode == 200 and resp.Body then
                local data = HttpService:JSONDecode(resp.Body)
                if data and data.data then
                    local servers = {}
                    for _, s in ipairs(data.data) do
                        if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then table.insert(servers, s.id) end
                    end
                    if #servers > 0 then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
                        hopped = true
                    end
                end
            end
        end)
    end
    if not hopped then pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end) end
end

pcall(function()
    TeleportService.TeleportInitFailed:Connect(function(player, result, err)
        if player == LocalPlayer then isHopping = false task.wait(1.5) HopServer("การเชื่อมต่อล้มเหลว") end
    end)
end)

task.spawn(function()
    while true do
        task.wait(0.5)
        if isAutoHopOnPlayerNearbyEnabled and not isHopping then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local myPos = root.Position
                for _, pl in ipairs(Players:GetPlayers()) do
                    if pl ~= LocalPlayer and pl.Character then
                        local otherRoot = pl.Character:FindFirstChild("HumanoidRootPart")
                        local otherHum = pl.Character:FindFirstChildOfClass("Humanoid")
                        if otherRoot and otherHum and otherHum.Health > 0 then
                            local dist = (otherRoot.Position - myPos).Magnitude
                            if dist <= autoHopDistance then
                                HopServer("ผู้เล่น @" .. pl.Name .. " ใกล้ " .. string.format("%.1f", dist) .. " studs")
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end)
