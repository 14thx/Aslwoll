local function CraftFoodAtStation(recipeName, shouldContinueCheck)
    local pos = TYPER_LOCATIONS.Food.Crafting
    Notify("NEXUS HUB", "🕊️ ลอยไปจุดคราฟ ("..recipeName..")...", "Info")
    FlyToPosition(pos, shouldContinueCheck)
    task.wait(0.5)
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then root.CFrame = CFrame.lookAt(pos + Vector3.new(0, 3.0, 2.5), pos) end
    task.wait(0.2)
    
    local cPrompt = FindPromptNear(root.Position, 20)
    if cPrompt then TriggerPrompt(cPrompt) task.wait(1.0) end
    
    local function GetMaxCraftAmount()
        local b, c, p = GetPlayerInventoryCount("Bread"), GetPlayerInventoryCount("Catchup"), GetPlayerInventoryCount("Pig")
        local m, r = GetPlayerInventoryCount("Mango"), GetPlayerInventoryCount("Rice")
        if recipeName == "Sandwish" then return math.min(math.floor(b/3), math.floor(c/2), math.floor(p/2))
        elseif recipeName == "MangoRice" then return math.min(math.floor(m/2), math.floor(r/3))
        elseif recipeName == "RiceKapaoMoo" then return math.min(math.floor(p/2), math.floor(r/3)) end
        return 1
    end
    local toCraft = GetMaxCraftAmount()
    if toCraft <= 0 then return end

    pcall(function()
        local remCore = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Modules") and ReplicatedStorage.Systems.Modules:FindFirstChild("Core") and ReplicatedStorage.Systems.Modules.Core:FindFirstChild("Remotes")
        if remCore then require(remCore).Fire("_crafting", "Request", "Craft_3", recipeName, toCraft, false) end
    end)
    task.wait(10.0) 
    pcall(function()
        local remCore = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Modules") and ReplicatedStorage.Systems.Modules:FindFirstChild("Core") and ReplicatedStorage.Systems.Modules.Core:FindFirstChild("Remotes")
        if remCore then require(remCore).Fire("_crafting", "Complete", "Craft_3", recipeName, toCraft, false) end
    end)
    
    pcall(function()
        local cg = PlayerGui:FindFirstChild("Crafting")
        if cg and cg:FindFirstChild("Group") then
            local exitBtn = cg.Group:FindFirstChild("Exit", true)
            if exitBtn then SafeClickGuiButton(exitBtn) end
            cg.Group.Visible = false
        end
    end)
    Notify("NEXUS HUB", "✅ คราฟเสร็จเรียบร้อย!", "Success")
    task.wait(1.0)
end

