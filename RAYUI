    if MY_SPAWNED_CAR and MY_SPAWNED_CAR.Parent and MY_SPAWNED_CAR.PrimaryPart and IsMyVehicle(MY_SPAWNED_CAR) then return MY_SPAWNED_CAR end
    local vehFolder = (workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Vehicles")) or workspace:FindFirstChild("Vehicles")
    if vehFolder then
        for _, v in ipairs(vehFolder:GetChildren()) do
            if v:IsA("Model") and IsMyVehicle(v) and v.PrimaryPart then MY_SPAWNED_CAR = v return v end
        end
    end
    return nil
end

local function GetNearbyPlayerVehicle(maxDist)
    maxDist = maxDist or 80
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, math.huge, nil end
    if hum and hum.Sit and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
        local veh = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if veh and IsMyVehicle(veh) then return veh, 0, nil end
    end
    local vehFolder = (workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Vehicles")) or workspace:FindFirstChild("Vehicles")
    local nearestCar = nil
    local minDist = math.huge
    if vehFolder then
        for _, v in ipairs(vehFolder:GetChildren()) do
            if v:IsA("Model") and IsMyVehicle(v) and v.PrimaryPart then
                local dist = (v.PrimaryPart.Position - root.Position).Magnitude
                if dist < minDist then minDist = dist nearestCar = v end
            end
        end
    end
    if nearestCar then
        if minDist <= maxDist then MY_SPAWNED_CAR = nearestCar return nearestCar, minDist, nil
        else return nil, minDist, nearestCar end
    end
    return nil, math.huge, nil
end

local function PressFToEnterCar(car)
    if not car or not car.Parent then return false end
    if not IsMyVehicle(car) then Notify("NEXUS HUB", "⚠️ ปฏิเสธการขึ้นรถ: คันนี้ไม่ใช่รถของเรา!", "Warning") return false end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end
    local seat = car:FindFirstChild("DriveSeat", true) or car:FindFirstChildWhichIsA("VehicleSeat", true) or car:FindFirstChildWhichIsA("Seat", true)
    if not seat then return false end
    if hum.Sit and hum.SeatPart == seat then
        MY_SPAWNED_CAR = car
        pcall(function() game:GetService("ProximityPromptService").Enabled = false end)
        return true
    end
    if hum.Sit and hum.SeatPart ~= seat then hum.Sit = false task.wait(0.2) end
    GrantAntiXGrace(20)
    local drivePrompt = nil
    local pFolder = seat:FindFirstChild("Prompt")
    if pFolder and pFolder:FindFirstChild("Prompt") and pFolder.Prompt:IsA("ProximityPrompt") then drivePrompt = pFolder.Prompt
    else
        for _, d in ipairs(seat:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.ActionText:lower():find("drive") and not d.ActionText:lower():find("passenger") then drivePrompt = d break end
        end
    end
    if not drivePrompt then
        for _, d in ipairs(car:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                local act = (d.ActionText or ""):lower()
                local name = (d.Name or ""):lower()
                if (act:find("drive") or name:find("drive") or d.KeyboardKeyCode == Enum.KeyCode.F) and not act:find("passenger") and not name:find("passenger") then drivePrompt = d break end
            end
        end
    end
    for _, d in ipairs(car:GetDescendants()) do
        if d:IsA("ProximityPrompt") and (d.ActionText:lower():find("passenger") or d.Name:lower():find("passenger")) then d.Enabled = false end
    end
    local vehFolder = (workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Vehicles")) or workspace:FindFirstChild("Vehicles")
    if vehFolder then
        for _, otherVeh in ipairs(vehFolder:GetChildren()) do
            if otherVeh ~= car then
                for _, otherP in ipairs(otherVeh:GetDescendants()) do if otherP:IsA("ProximityPrompt") then otherP.Enabled = false end end
            end
        end
    end
    local doorCF = seat.CFrame * CFrame.new(-2.6, 0.2, 0)
    root.CFrame = CFrame.lookAt(doorCF.Position, seat.Position)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    task.wait(0.15)
    pcall(function()
        game:GetService("ProximityPromptService").Enabled = true
        if drivePrompt then drivePrompt.Enabled = true end
    end)
    local isSeated = false
    local t0 = os.clock()
    while os.clock() - t0 < 3.0 do
        if hum.Sit and hum.SeatPart then isSeated = true break end
        if drivePrompt then
            pcall(function() drivePrompt.HoldDuration = 0 end)
            pcall(function() fireproximityprompt(drivePrompt) end)
            pcall(function() drivePrompt:InputHoldBegin() end)
            task.wait(0.08)
            pcall(function() drivePrompt:InputHoldEnd() end)
        end
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            task.wait(0.06)
            vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end)
        task.wait(0.2)
    end
    if not (hum.Sit and hum.SeatPart) then
        pcall(function()
            root.CFrame = seat.CFrame + Vector3.new(0, 0.5, 0)
            seat:Sit(hum)
        end)
        task.wait(0.2)
    end
    isSeated = (hum.Sit and hum.SeatPart ~= nil)
    if isSeated then
        MY_SPAWNED_CAR = car
        pcall(function() game:GetService("ProximityPromptService").Enabled = false end)
    end
    return isSeated
end

