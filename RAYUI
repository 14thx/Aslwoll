-- [ระบบลอยหายตัว (Invisible FlyTo)]
local function FlyToPosition(targetPos, shouldContinueCheck)
    if shouldContinueCheck and not shouldContinueCheck() then return false end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return false end

    GrantAntiXGrace(25)
    if hum.Sit then hum.Sit = false task.wait(0.1) end

    -- ซ่อนตัวก่อนลอย
    pcall(function()
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = 1
                part.LocalTransparencyModifier = 1
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 1
            end
        end
    end)

    pcall(function() LocalPlayer:RequestStreamAroundAsync(targetPos, 30) end)

    local groundY = GetGroundLevel(targetPos.X, targetPos.Z, targetPos.Y)
    local finalPos = Vector3.new(targetPos.X, groundY + 3.0, targetPos.Z)

    local tweenService = game:GetService("TweenService")
    local distance = (finalPos - root.Position).Magnitude
    -- เวลาลอย (ขั้นต่ำ 1.5 วิ สูงสุด 4 วิ)
    local duration = math.clamp(distance / 120, 1.5, 4.0) 

    local graceConn = RunService.Heartbeat:Connect(function()
        if root then root:SetAttribute("TeleportGrace", os.clock() + 5) end
    end)

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = tweenService:Create(root, tweenInfo, { CFrame = CFrame.new(finalPos) })
    
    tween:Play()
    tween:Completed:Wait()
    
    if graceConn then graceConn:Disconnect() end
    
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    
    task.wait(0.5) -- รอให้ตัวแตะพื้นก่อน

    -- คืนค่าตัวให้โชว์ปกติ
    pcall(function()
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = 0
                part.LocalTransparencyModifier = 0
            elseif part:IsA("Decal") or part:IsA("Texture") then
                part.Transparency = 0
            end
        end
        workspace.CurrentCamera.CameraSubject = hum
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    end)

    task.wait(0.3)
    return true
end

local function HarvestSingleCrop(cropName, targetAmount, shouldContinueCheck)
    targetAmount = 60
    local curCount = GetPlayerInventoryCount(cropName)
    if curCount >= targetAmount then return end
    local locData = TYPER_LOCATIONS[cropName]
    if not locData or not locData.Farm then return end
    
    Notify("NEXUS HUB", "🕊️ ลอยไปจุดฟาร์ม " .. cropName .. "...", "Info")
    FlyToPosition(locData.Farm, shouldContinueCheck)
    
    -- [สำคัญ]: เว้นจังหวะรอ 2 วินาที เหมือนตอนขับรถมาถึงฟาร์ม
    Notify("NEXUS HUB", "🚗 ถึงฟาร์มแล้ว! รอ 2 วินาทีเพื่อเตรียมกดฟาร์ม...", "Info")
    task.wait(2.0)
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        -- จัดท่ายืนหันหน้าเข้าหาเสาฟาร์ม
        root.CFrame = CFrame.lookAt(locData.Farm + Vector3.new(0, 2, 3), locData.Farm)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    task.wait(0.5)
    
    -- กด Prompt ฟาร์ม
    local farmSys = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Farm")
    local farmFolder = farmSys and farmSys:FindFirstChild(cropName)
    local promptTriggered = false
    if farmFolder then
        for _, desc in ipairs(farmFolder:GetDescendants()) do
            if desc:IsA("ProximityPrompt") and desc.Enabled then
                pcall(function() desc:InputHoldBegin() task.wait(0.15) desc:InputHoldEnd() end)
                promptTriggered = true
                break
            end
        end
    end
    
    task.wait(1.5) -- รอให้ UI ฟาร์มขึ้น
    
    local farmTimeout = os.clock()
    while GetPlayerInventoryCount(cropName) < targetAmount do
        if isAutoEatAndDrinkEnabled and not isConsumingItem then
            local h = GetPlayerHunger()
            local e = GetPlayerEnergy()
            if (h and h <= 75) or (e and e <= 75) then
                CancelGameFarm()
                task.wait(0.3)
                if h and h <= 75 then CheckAndAutoEat() end
                if e and e <= 75 then CheckAndAutoDrinkCoffee() end
                task.wait(0.3)
                if promptTriggered then
                    pcall(function() desc:InputHoldBegin() task.wait(0.15) desc:InputHoldEnd() end)
                end
                task.wait(1.2)
                farmTimeout = os.clock()
            end
        end
        if shouldContinueCheck and not shouldContinueCheck() then break end
        if os.clock() - farmTimeout > 180 then break end
        GrantAntiXGrace(15)
        if (os.clock() - farmTimeout > 15) and GetPlayerInventoryCount(cropName) == curCount then
            if promptTriggered then
                pcall(function() desc:InputHoldBegin() task.wait(0.15) desc:InputHoldEnd() end)
            end
            farmTimeout = os.clock()
        end
        task.wait(0.5)
    end
    task.wait(0.5)
end

