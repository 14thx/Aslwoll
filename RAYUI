-- DRIVE CAR (ตรงตามต้นฉบับ 100%)
-- ==============================================================================
local function DriveCarTo(destination, shouldContinueCheck)
    local myCar = GetNearbyPlayerVehicle(80) or GetPlayerVehicle()
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not myCar or not (hum and hum.Sit) then
        if myCar then EnsurePlayerSeatedInCar(myCar)
        else myCar = EnsureCarAvailable(TOWN_CAR_SPAWN) end
    end
    if not myCar then return end
    if not (hum and hum.Sit) then EnsurePlayerSeatedInCar(myCar) end
    if not (hum and hum.Sit) then return end
    local seat = hum.SeatPart
    if not seat or not seat:IsA("VehicleSeat") then return end
    local startTime = os.clock()
    while (seat.Position - destination).Magnitude > 8 and (os.clock() - startTime < 60) do
        if shouldContinueCheck and not shouldContinueCheck() then return end
        GrantAntiXGrace(10)
        local seatCF = seat.CFrame
        local direction = (destination - seat.Position).Unit
        local desiredCF = CFrame.lookAt(seat.Position, seat.Position + direction)
        local currentYaw = math.atan2(seatCF.LookVector.X, seatCF.LookVector.Z)
        local desiredYaw = math.atan2(desiredCF.LookVector.X, desiredCF.LookVector.Z)
        local yawDiff = desiredYaw - currentYaw
        if yawDiff > math.pi then yawDiff = yawDiff - 2 * math.pi
        elseif yawDiff < -math.pi then yawDiff = yawDiff + 2 * math.pi end
        local throttle = 1
        local steer = math.clamp(yawDiff * 3, -1, 1)
        if (seat.Position - destination).Magnitude < 25 then throttle = 0.5 end
        pcall(function()
            seat.ThrottleFloat = throttle
            seat.SteerFloat = steer
        end)
        task.wait(0.05)
    end
    pcall(function() seat.ThrottleFloat = 0 seat.SteerFloat = 0 end)
    task.wait(0.2)
end

