-- 3.1 ฟาร์มไอเท็ม
local FarmItemSection = Farm:Section({ Title = "ฟาร์มไอเท็ม", Icon = "box" })

FarmItemSection:Dropdown({
    Title = "เลือกฟาร์ม", 
    Options = {"Bread", "Catchup", "Pig", "Mango", "Rice", "Tomato", "Banana", "Crab", "Coconut", "Corn", "Egg", "Milk", "Sugarcane"}, 
    Default = "Bread",
    Callback = function(option)
        _G.SelectedFarmItem = option
    end
})

FarmItemSection:Toggle({
    Title = "ออโต้ ฟาร์มไอเท็ม (ที่เลือก)", Default = false,
    Callback = function(on)
        if on then
            local check = RequestFarmSession("FarmItemMaster")
            task.spawn(function()
                local crop = _G.SelectedFarmItem or "Bread"
                local isFirstRun = true
                while check() do
                    if isFirstRun then WarpToTownAndSpawnCar() isFirstRun = false end
                    if not check() then break end
                    HarvestSingleCrop(crop, 60, check)
                    if not check() then break end
                    SellAtEconomyMarket(check)
                    task.wait(1.0)
                end
            end)
        else
            StopFarmSession("FarmItemMaster")
        end
    end
})

-- 3.2 ฟาร์มไอเท็มโพ (ผลไม้)
local FarmFruitSection = Farm:Section({ Title = "ฟาร์มไอเท็มโพ (ผลไม้)", Icon = "apple" })

FarmFruitSection:Dropdown({
    Title = "เลือกฟาร์ม", 
    Options = {"Banana", "Mango", "Rice"}, 
    Default = "Banana",
    Callback = function(option)
        _G.SelectedFruitItem = option
    end
})

FarmFruitSection:Toggle({
    Title = "ออโต้ ฟาร์มโพทย์", Default = false,
    Callback = function(on)
        if on then
            local check = RequestFarmSession("FruitProcess")
            task.spawn(function()
                local crop = _G.SelectedFruitItem or "Banana"
                local isFirstRun = true
                while check() do
                    if isFirstRun then WarpToTownAndSpawnCar() isFirstRun = false end
                    if not check() then break end
                    if GetPlayerInventoryCount(crop) < 60 then
                        HarvestSingleCrop(crop, 60, check)
                    end
                    if not check() then break end
                    
                    if crop == "Banana" then
                        ProcessBananaAtStation(check)
                    elseif crop == "Mango" then
                        CraftFoodAtStation("MangoRice", check)
                    elseif crop == "Rice" then
                        CraftFoodAtStation("RiceKapaoMoo", check)
                    end
                    
                    if not check() then break end
                    SellAtEconomyMarket(check)
                    task.wait(1.0)
                end
            end)
        else
            StopFarmSession("FruitProcess")
        end
    end
})

-- 3.3 ฟาร์มไอเท็มโพ (เหมือง)
local FarmMineSection = Farm:Section({ Title = "ฟาร์มไอเท็มโพ (เหมือง)", Icon = "pickaxe" })

FarmMineSection:Dropdown({
    Title = "เลือกฟาร์มเหมือง", 
    Options = {"Rock", "Svibranium"}, 
    Default = "Rock",
    Callback = function(option)
        _G.SelectedMineItem = option
    end
})

FarmMineSection:Toggle({
    Title = "ออโต้ ฟาร์มเหมืองโพ", Default = false,
    Callback = function(on)
        if on then
            local check = RequestFarmSession("MineProcess")
            task.spawn(function()
                local ore = _G.SelectedMineItem or "Rock"
                local isFirstRun = true
                while check() do
                    if isFirstRun then WarpToTownAndSpawnCar() isFirstRun = false end
                    if not check() then break end
                    
                    if GetPlayerInventoryCount(ore) < 60 then
                        local myCar = GetPlayerVehicle() or EnsureCarAvailable(TOWN_CAR_SPAWN)
                        if myCar then EnsurePlayerSeatedInCar(myCar) end
                        if not check() then break end
                        local char = LocalPlayer.Character
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Sit then hum.Sit = false task.wait(0.3) end
                        
                        local pillarPos = ore == "Rock" and Vector3.new(-4138.03, 29.88, -1286.63) or Vector3.new(2723.67, 28.51, -236.17)
                        SmoothWalkTo(pillarPos + Vector3.new(0, 0, 3.0), 6, check, 1.2)
                        task.wait(0.5)
                        TriggerFarmPromptDirectly(ore)
                        task.wait(1.5)
                        
                        local farmTimeout = os.clock()
                        while GetPlayerInventoryCount(ore) < 60 do
                            if not check() then break end
                            if os.clock() - farmTimeout > 300 then break end
                            if isAutoEatAndDrinkEnabled and not isConsumingItem then
                                local h = GetPlayerHunger()
                                local e = GetPlayerEnergy()
                                if (h and h <= 75) or (e and e <= 75) then
                                    CancelGameFarm()
                                    task.wait(0.3)
                                    if h and h <= 75 then CheckAndAutoEat() end
                                    if e and e <= 75 then CheckAndAutoDrinkCoffee() end
                                    task.wait(0.5)
                                    TriggerFarmPromptDirectly(ore)
                                    task.wait(1.5)
                                end
                            end
                            GrantAntiXGrace(15)
                            task.wait(1.0)
                        end
                        CancelGameFarm()
                        task.wait(0.5)
                    end
                    if not check() then break end
                    
                    ProcessOreAtStation(ore, ore == "Svibranium" and 4 or 2, check)
                    if not check() then break end
                    DepositAllToVault(check)
                    if not check() then break end
                    
                    if ore == "Rock" then
                        SellAtEconomyMarket(check)
                    end
                    task.wait(1.0)
                end
            end)
        else
            StopFarmSession("MineProcess")
        end
    end
})

